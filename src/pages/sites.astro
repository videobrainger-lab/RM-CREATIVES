ght:.9;letter-spacing:-.065em;max-width:1200px;margin:30px 0}.cta p{font-size:18px;color:var(--muted);max-width:620px;line-height:1.5;margin-bottom:40px}.related{padding:40px 0 140px}.related-head{border-top:1px solid var(--ink);padding-top:30px;display:grid;grid-template-columns:.45fr 1.55fr;gap:50px;align-items:start}.related-head h2{font-size:clamp(42px,5vw,76px);line-height:.95;letter-spacing:-.055em;margin:0}.case-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:60px}.case-cards a{min-height:420px;background:#e4e3dd;padding:28px;display:flex;flex-direction:column;transition:transform .2s ease}.case-cards a:nth-child(2){background:var(--accent)}.case-cards a:nth-child(3){background:var(--dark);color:white}.case-cards a:hover{transform:translateY(-4px)}.case-cards h3{font-size:clamp(28px,2.7vw,43px);line-height:1.03;letter-spacing:-.045em;margin:55px 0 30px}.case-cards strong{font-size:clamp(45px,4.5vw,70px);letter-spacing:-.06em;margin-top:auto}.case-cards p{font:10px monospace;opacity:.62;margin:8px 0 28px}.case-cards b{font:10px monospace;font-weight:500}@media(max-width:850px){.hero-grid,.statement-grid,.not-grid,.compare,.section-head,.seo-grid,.related-head{grid-template-columns:1fr}.hero{min-height:auto}.hero-grid{margin-top:70px}.journey-flow{grid-template-columns:1fr}.journey-flow i{transform:rotate(90deg);justify-self:start}.included-grid,.time-grid,.case-cards{grid-template-columns:1fr}.included-grid>div:not(:nth-child(3n+1)){padding-left:0;border-left:0}.time-grid>div+div{padding-left:0;border-left:0;border-top:1px solid #333}.case-cards a{min-height:330px}}
</style>