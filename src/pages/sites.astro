---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="RM Sites — Clinic websites in 1 day | RM CREATIVES" description="Fast, responsive, SEO-ready clinic websites built in one day without WordPress.">
  <main class="page shell">
    <a class="back" href="/">← RM CREATIVES</a>
    <div class="eyebrow">RM SITES / WEB DEVELOPMENT</div>
    <h1>Clinic website.<br/>Live in 1 day.</h1>
    <p class="lead">A focused, conversion-ready website without WordPress, plugin maintenance or months of development.</p>
    <div class="grid">
      <div><span class="eyebrow">01</span><h2>One-day build</h2><p>Clear scope, fast production and a launch-ready result instead of a drawn-out agency process.</p></div>
      <div><span class="eyebrow">02</span><h2>Modern stack</h2><p>Static-first architecture, GitHub workflow and Netlify deployment for speed and reliability.</p></div>
      <div><span class="eyebrow">03</span><h2>SEO-ready</h2><p>Clean structure, metadata, sitemap, canonical URLs and analytics foundations from day one.</p></div>
    </div>
    <a class="cta" href="mailto:hello@rmcreatives.com">Build my clinic website ↗</a>
  </main>
</BaseLayout>
<style>
  .page{min-height:100vh;padding:32px 0 70px;display:flex;flex-direction:column}.back{margin-bottom:120px;font-size:13px}.eyebrow{font-family:monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase}h1{font-size:clamp(64px,10vw,150px);line-height:.86;letter-spacing:-.07em;margin:24px 0 44px;font-weight:600}.lead{font-size:clamp(20px,2.3vw,34px);line-height:1.2;max-width:900px;margin:0 0 100px}.grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.grid>div{padding:28px 28px 70px 0;border-bottom:1px solid var(--line)}.grid>div+div{padding-left:28px;border-left:1px solid var(--line)}h2{font-size:28px;letter-spacing:-.04em;margin:55px 0 14px}p{line-height:1.5}.grid p{color:var(--muted);max-width:350px}.cta{margin-top:60px;background:var(--ink);color:white;padding:18px 22px;align-self:flex-start;font-weight:650}@media(max-width:700px){.back{margin-bottom:80px}.grid{grid-template-columns:1fr}.grid>div+div{padding-left:0;border-left:0}.lead{margin-bottom:70px}}
</style>