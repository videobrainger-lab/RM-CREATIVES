---
import AuthorityArticleLayout from '../../layouts/AuthorityArticleLayout.astro';

const sections = [
  {title:'Не приписывайте человеку диагноз или личную характеристику',body:'Медицинская реклама часто получает отклонение, когда текст подразумевает, что Meta знает о состоянии здоровья, внешности или истории пользователя. Говорите об услуге и выборе пациента, а не об якобы известной проблеме.',bullets:['Вместо «Вы страдаете от…?» используйте нейтральное описание консультации или услуги','Проверяйте вместе текст, изображение, заголовок, лид-форму и посадочную страницу','Не усиливайте негативное восприятие внешности ради продажи процедуры']},
  {title:'Отделяйте рекламу услуги от продвижения рецептурного препарата',body:'Клиника может продвигать разрешённую медицинскую или эстетическую услугу, но прямое упоминание рецептурных препаратов и обещания результата создают дополнительные ограничения. Коммуникация должна точно описывать консультацию и не превращать препарат в потребительский оффер.',bullets:['Проверьте статус препарата в конкретной стране','Не обещайте автоматическую доступность лечения или гарантированный результат','Используйте корректную роль врача и этап консультации']},
  {title:'Используйте доказательства без искусственной уверенности',body:'Фотографии до и после, отзывы и числовые результаты должны быть проверяемыми и репрезентативными. Нельзя ретушью или формулировкой создавать впечатление, что исключительный результат является типичным.',bullets:['Сохраняйте сопоставимые условия съёмки и согласия пациентов','Не превращайте отзыв в неподтверждённое медицинское утверждение','Указывайте, что индивидуальные результаты могут различаться']},
  {title:'Посадочная страница проходит ту же проверку, что и объявление',body:'Даже нейтральное объявление может быть отклонено, если страница содержит запрещённые обещания, неполную информацию о провайдере или другой оффер. Услуга, врач, география и следующий шаг должны совпадать на всём пути.',bullets:['Покажите клинику, специалиста и важную информацию об услуге','Используйте консультацию или оценку показаний, если это необходимо','Сделайте политику конфиденциальности и контакты легко доступными']},
  {title:'Относитесь к данным о здоровье как к чувствительным',body:'Аналитика не должна передавать диагнозы, названия процедур или другие чувствительные сведения через URL, события пикселя, аудитории или CRM-интеграции. Проверяйте форму, браузерные и серверные события как единую систему.',bullets:['Используйте нейтральные названия событий и минимальный набор параметров','Не создавайте рекламные аудитории на основе чувствительных медицинских данных','Зафиксируйте правила согласия, доступа и хранения данных']},
  {title:'Проверяйте требования конкретного рынка',body:'Одобрение Meta не заменяет соблюдение местного законодательства. Казахстан, Узбекистан, страны ЕС и другие рынки по-разному регулируют медицинские утверждения, лекарства, косметологию и использование отзывов. Проверка должна проводиться для каждой страны отдельно.'}
];
---
<AuthorityArticleLayout
  lang="ru"
  title="Что нельзя рекламировать клиникам в Facebook и Instagram | RM CREATIVES"
  description="Практическая проверка рекламы медицинских и эстетических клиник в Meta: личные характеристики, препараты, обещания, креативы, посадочные страницы и данные."
  eyebrow="META ADS / МЕДИЦИНСКАЯ РЕКЛАМА"
  headline="Что нельзя рекламировать клиникам в Facebook и Instagram."
  intro="Актуальная система проверки для медицинских и эстетических клиник: сообщение, доказательства, посадочная страница, данные и требования конкретного рынка."
  updated="СЕНТЯБРЬ 2026"
  takeaways={['Не утверждайте, что знаете диагноз, состояние или личную характеристику пользователя.','Проверяйте объявление, страницу, форму и аналитику как единую систему.','Сверяйте правила платформы и требования каждой страны перед запуском.']}
  sections={sections}
  sources={[{href:'https://transparency.meta.com/policies/ad-standards/',label:'Стандарты рекламы Meta'},{href:'https://support.google.com/adspolicy/answer/176031?hl=ru',label:'Правила Google для медицины и лекарств'},{href:'https://www.asa.org.uk/resource/cosmetic-interventions.html',label:'Рекомендации ASA/CAP по косметическим вмешательствам'}]}
  related={[{href:'/ru/industries/aesthetic-clinic-marketing/meta-ads/',label:'Meta Ads для эстетических клиник'},{href:'/ru/industries/medical-marketing/',label:'Маркетинг медицинских клиник'},{href:'/ru/cases/consilium-medicum/meta-ads/',label:'Кейс Consilium Medicum'}]}
/>
