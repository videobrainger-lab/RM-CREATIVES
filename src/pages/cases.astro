---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
  { client: 'DENTA', sector: 'Dental clinic / Latvia', metric: '4,792+', label: 'patient enquiries', tags: 'META ADS / SEO' },
  { client: 'EPILINE', sector: 'Aesthetic medicine', metric: '€2.41', label: 'average lead cost', tags: 'META ADS' },
  { client: 'CONSILIUM MEDICUM', sector: 'Medical clinic', metric: '6 mo.', label: 'booking capacity filled', tags: 'PERFORMANCE' }
];
---
<BaseLayout title="Cases | RM CREATIVES" description="Selected patient acquisition and digital growth cases for medical, dental and beauty clinics.">
  <main class="shell page">
    <header><a href="/">← RM CREATIVES</a><span class="eyebrow">SELECTED WORK</span></header>
    <h1>Cases,<br/>not claims.</h1>
    <div class="grid">
      {cases.map((item) => <article>
        <div class="meta eyebrow"><span>{item.tags}</span><span>↗</span></div>
        <div class="space"></div>
        <strong>{item.metric}</strong><span class="label">{item.label}</span>
        <div class="footer"><h2>{item.client}</h2><p>{item.sector}</p></div>
      </article>)}
    </div>
  </main>
</BaseLayout>
<style>
  .page{padding:32px 0 100px}header{display:flex;justify-content:space-between;font-size:13px}.eyebrow{font-family:monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase}h1{font-size:clamp(72px,12vw,180px);line-height:.83;letter-spacing:-.075em;margin:120px 0 90px;font-weight:600}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}article{min-height:590px;padding:24px;background:#e7e6df;display:flex;flex-direction:column;border:1px solid #dcdbd4}article:nth-child(2){background:var(--accent)}article:nth-child(3){background:var(--dark);color:white;border-color:var(--dark)}.meta{display:flex;justify-content:space-between}.space{flex:1}strong{font-size:clamp(56px,6vw,92px);line-height:.9;letter-spacing:-.07em;font-weight:550}.label{font-size:13px;opacity:.6;margin-top:10px;padding-bottom:20px;border-bottom:1px solid currentColor}.footer{padding-top:20px}.footer h2{font-size:24px;margin:0 0 5px}.footer p{font-size:13px;opacity:.6;margin:0}@media(max-width:800px){.grid{grid-template-columns:1fr}article{min-height:420px}h1{margin-top:90px}}
</style>