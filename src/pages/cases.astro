---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
{client:'EPILINE',type:'FLAGSHIP',title:'Building a patient acquisition system, not a collection of campaigns.',problem:'The clinic needed paid acquisition, organic search, a new website and follow-up to work as one system.',solution:'We connected Meta, Google, SEO, website and CRM around one patient journey.',result:'2,970',resultLabel:'Meta enquiries · Jan–Aug 2026',href:'/cases/epiline',featured:true,tags:'FLAGSHIP'},
{client:'CONSILIUM MEDICUM',type:'FLAGSHIP',title:'Capturing medical demand under strict advertising rules.',problem:'High-intent patients were searching, but healthcare advertising restrictions repeatedly complicated acquisition.',solution:'We built a multi-channel acquisition approach around compliant Google Ads, Meta and organic search.',result:'3,356',resultLabel:'Google Ads conversions · 2024',href:'/cases/consilium-medicum',featured:true,tags:'FLAGSHIP'},
{client:'DENTA',type:'FLAGSHIP',title:'Turning a dental clinic into a full-stack acquisition machine.',problem:'Growth could not depend on one advertising channel. The clinic needed a stronger digital foundation.',solution:'Google, Meta, SEO and a new website were developed as one acquisition ecosystem.',result:'16,227',resultLabel:'tracked enquiries · 2025',href:'/cases/denta',featured:true,tags:'FLAGSHIP'},
{client:'UNION KLINIKA',type:'FLAGSHIP',title:'Growing a medical clinic with a limited marketing budget.',problem:'The clinic needed more patient enquiries and a better digital presence without an oversized build.',solution:'We combined a new patient-first website with Meta and Google acquisition.',result:'1,021',resultLabel:'Meta enquiries · May–Dec 2024',href:'/cases/union-klinika',featured:true,tags:'FLAGSHIP'},
{type:'META ADS',title:'How do you scale Meta without losing control of lead cost?',problem:'More volume usually means more expensive enquiries.',solution:'Continuous offer, audience and creative iteration kept acquisition scalable month after month.',result:'2,970',resultLabel:'enquiries · Jan–Aug 2026',href:'/cases/epiline/meta-ads',tags:'META ADS'},
{type:'META ADS',title:'Creating patient demand beyond Google Search.',problem:'Search captures existing demand, but growth also required reaching patients before they started searching.',solution:'Meta campaigns turned relevant medical offers into a repeatable enquiry channel.',result:'1,484',resultLabel:'enquiries · 2025',href:'/cases/consilium-medicum/meta-ads',tags:'META ADS'},
{type:'META ADS',title:'Making paid social a predictable dental acquisition channel.',problem:'Dental offers had to generate volume without relying only on expensive high-intent search.',solution:'We used Meta to create demand and route interested patients directly into enquiry flows.',result:'1,902',resultLabel:'enquiries · Jan–Aug 2026',href:'/cases/denta/meta-ads',tags:'META ADS'},
{type:'META ADS',title:'Patient acquisition on a constrained clinic budget.',problem:'The clinic needed a meaningful flow of enquiries without a large media budget.',solution:'Focused offers and Meta campaigns concentrated spend around measurable patient actions.',result:'€2.75',resultLabel:'weighted CPL · May–Dec 2024',href:'/cases/union-klinika/meta-ads',tags:'META ADS'},
{type:'GOOGLE ADS',title:'Capturing patients already searching for treatment.',problem:'High-intent demand existed, but the clinic needed to turn searches into measurable enquiries efficiently.',solution:'Search campaigns matched treatment intent with relevant landing destinations and conversion tracking.',result:'1,343',resultLabel:'conversions · Jan–Aug 2026',href:'/cases/epiline/google-ads',tags:'GOOGLE ADS'},
{type:'GOOGLE ADS',title:'3,356 medical enquiries from existing search demand.',problem:'Patients were searching for specialists and services, but demand was fragmented across many queries.',solution:'We segmented intent and connected search campaigns with relevant clinic pages.',result:'€3.25',resultLabel:'cost per conversion · 2024',href:'/cases/consilium-medicum/google-ads',tags:'GOOGLE ADS'},
{type:'MEDICAL GOOGLE ADS',title:'What happens when Google keeps restricting medical ads?',problem:'Healthcare policies caused recurring limitations and blocks around sensitive medical topics.',solution:'Broader targeting, neutral copy, compliant landing pages and continuous account checks kept acquisition operational.',result:'POLICY',resultLabel:'performance inside restrictions',href:'/cases/consilium-medicum/medical-google-ads',tags:'GOOGLE ADS'},
{type:'GOOGLE ADS',title:'Scaling high-intent dental search without destroying CPA.',problem:'Dental search is valuable precisely because patients are close to choosing a clinic — and competition is intense.',solution:'Campaign structure and intent segmentation concentrated budget on searches most likely to convert.',result:'10,601',resultLabel:'conversions · 2025',href:'/cases/denta/google-ads',tags:'GOOGLE ADS'},
{type:'GOOGLE ADS',title:'Turning medical searches into clinic enquiries.',problem:'Patients were already searching for services, but the clinic needed a structured way to capture that intent.',solution:'Search campaigns connected relevant queries with the clinic and its service pages.',result:'SEARCH',resultLabel:'existing patient demand',href:'/cases/union-klinika/google-ads',tags:'GOOGLE ADS'},
{type:'SEO',title:'Building organic demand beyond the clinic name.',problem:'Paid traffic disappears when spend stops. The clinic needed visibility for real treatment searches.',solution:'Technical, structural and content SEO built non-brand visibility across two languages.',result:'TOP 10',resultLabel:'275 organic enquiries',href:'/cases/epiline/seo',tags:'SEO'},
{type:'SEO',title:'Turning patient questions into organic acquisition.',problem:'Patients search symptoms and medical questions long before they choose a clinic.',solution:'Organic visibility captured that earlier demand and brought it into the clinic ecosystem.',result:'2,011',resultLabel:'organic enquiries · 2025',href:'/cases/consilium-medicum/seo',tags:'SEO'},
{type:'SEO',title:'From search visibility to thousands of organic enquiries.',problem:'The clinic needed a source of patient demand that did not depend on buying every click.',solution:'Long-term SEO moved core searches into leading positions and compounded organic acquisition.',result:'TOP 5',resultLabel:'3,831 organic enquiries · 2025',href:'/cases/denta/seo',tags:'SEO'},
{type:'WEBSITE',title:'Rebuilding the clinic website without sacrificing search visibility.',problem:'The old site was slow, error-prone and difficult to use — but already had valuable search visibility.',solution:'We rebuilt 44 pages in two languages and migrated the site while protecting core rankings.',result:'44',resultLabel:'pages · LV / RU',href:'/cases/epiline/website',tags:'WEBSITE'},
{type:'WEBSITE',title:'A new website built as acquisition infrastructure.',problem:'Advertising and SEO can only perform as well as the destination patients land on.',solution:'We rebuilt the clinic site around services, search visibility and clear conversion paths.',result:'NEW',resultLabel:'website for acquisition',href:'/cases/denta/website',tags:'WEBSITE'},
{type:'WEBSITE',title:'How do you rebuild a clinic website on a limited budget?',problem:'Patients needed clearer services, doctors and booking paths, while the clinic needed to keep the build efficient.',solution:'We redesigned structure and UX into a bilingual patient-first website without an oversized project.',result:'NEW',resultLabel:'bilingual clinic website',href:'/cases/union-klinika/website',tags:'WEBSITE'},
{type:'CRM & BOOKING',title:'The lead is not the result. What happens after it arrives?',problem:'Marketing can generate an enquiry and still lose the patient during follow-up.',solution:'Kommo, WhatsApp and Altegio were connected into a clear lead → conversation → booking → repeat workflow.',result:'CRM',resultLabel:'lead → visit → repeat',href:'/cases/epiline/crm-booking',tags:'CRM'}
];
const flagship=cases.filter(c=>c.featured); const stories=cases.filter(c=>!c.featured);
---
<BaseLayout title="Cases | RM CREATIVES" description="Clinic growth cases across Meta Ads, Google Ads, SEO, websites, CRM and analytics.">
<main class="shell page"><div class="top eyebrow"><span>CASE LIBRARY</span><span>{cases.length} STORIES / 4 CLINICS</span></div><section class="hero"><h1>Problems solved.<br/><em>Results measured.</em></h1><div><p>Don't choose a case by a number. Choose the problem that looks like yours.</p><p class="muted">Start with a flagship partnership or filter the library by the part of the acquisition system you want to improve.</p></div></section><section class="flagships"><div class="section-title"><span class="eyebrow">START HERE / FLAGSHIP PARTNERSHIPS</span><h2>The whole<br/>growth story.</h2></div><div class="flag-grid">{flagship.map((item,i)=><a class={`flag flag-${i}`} href={item.href}><div class="flag-top eyebrow"><span>{item.client}</span><span>FULL CASE ↗</span></div><h3>{item.title}</h3><p>{item.problem}</p><div class="flag-result"><strong>{item.result}</strong><span>{item.resultLabel}</span></div></a>)}</div></section><section class="library"><div class="library-head"><div><span class="eyebrow">DEEP DIVES</span><h2>Choose the problem.</h2></div><p>Each story stands on its own. Pick the challenge that looks familiar — the client is secondary.</p></div><nav class="filters eyebrow"><button class="active" data-filter="ALL">ALL</button><button data-filter="META ADS">META ADS</button><button data-filter="GOOGLE ADS">GOOGLE ADS</button><button data-filter="SEO">SEO</button><button data-filter="WEBSITE">WEBSITES</button><button data-filter="CRM">CRM & ANALYTICS</button></nav><div class="story-list">{stories.map((item,i)=><a class={`story story-${i%4}`} href={item.href} data-tags={item.tags}><div class="story-side"><span class="eyebrow">{item.type}</span><span class="story-no">{String(i+1).padStart(2,'0')}</span></div><div class="story-main"><h3>{item.title}</h3><div class="ps"><div><span>PROBLEM</span><p>{item.problem}</p></div><div><span>WHAT WE DID</span><p>{item.solution}</p></div></div></div><div class="story-result"><strong>{item.result}</strong><span>{item.resultLabel}</span><em>READ CASE ↗</em></div></a>)}</div></section></main>
<script>const buttons=document.querySelectorAll('.filters button');const cards=document.querySelectorAll('.story');buttons.forEach(b=>b.addEventListener('click',()=>{const f=b.dataset.filter;buttons.forEach(x=>x.classList.remove('active'));b.classList.add('active');cards.forEach(c=>c.style.display=f==='ALL'||c.dataset.tags?.includes(f)?'grid':'none')}));</script>
</BaseLayout>
<style>
.page{padding:38px 0 150px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.hero{padding:95px 0 120px;display:grid;grid-template-columns:1.55fr .55fr;gap:90px;align-items:end}.hero h1{font-size:clamp(68px,9vw,140px);line-height:.84;letter-spacing:-.075em;margin:0;font-weight:650}.hero h1 em{font-style:normal;color:var(--accent)}.hero p{font-size:20px;line-height:1.35;margin:0 0 18px}.hero .muted{font-size:15px}.section-title{display:grid;grid-template-columns:.55fr 1fr;gap:60px;padding:28px 0 55px;border-top:1px solid var(--line)}.section-title h2,.library-head h2{font-size:clamp(48px,6vw,88px);line-height:.9;letter-spacing:-.06em;margin:0}.flag-grid{display:grid;grid-template-columns:1.25fr .75fr;grid-auto-rows:minmax(470px,auto);gap:10px}.flag{padding:28px;display:flex;flex-direction:column;background:#e5e4de;border:1px solid #d7d6cf}.flag-0{background:var(--accent)}.flag-1{background:var(--dark);color:var(--white)}.flag-2{grid-column:2;background:#d8d7d0}.flag-3{grid-column:1;grid-row:2;background:#f8f7f2}.flag-top{display:flex;justify-content:space-between}.flag h3{font-size:clamp(36px,4vw,62px);line-height:.98;letter-spacing:-.055em;max-width:800px;margin:70px 0 25px}.flag p{font-size:16px;line-height:1.5;max-width:600px;opacity:.68}.flag-result{margin-top:auto;border-top:1px solid currentColor;padding-top:22px;display:flex;align-items:end;justify-content:space-between;gap:30px}.flag-result strong{font-size:clamp(60px,7vw,105px);line-height:.8;letter-spacing:-.07em;font-weight:550}.flag-result span{font-size:12px;opacity:.6;text-align:right}.library{padding-top:150px}.library-head{display:grid;grid-template-columns:1.4fr .6fr;gap:80px;align-items:end}.library-head p{font-size:17px;line-height:1.5;color:var(--muted);max-width:420px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:55px 0 30px;padding-top:20px;border-top:1px solid var(--line)}.filters button{font:inherit;letter-spacing:inherit;background:transparent;border:1px solid var(--line);padding:9px 12px;cursor:pointer}.filters .active{background:var(--ink);color:white}.story-list{border-top:1px solid var(--ink)}.story{min-height:285px;display:grid;grid-template-columns:.28fr 1.25fr .42fr;gap:35px;padding:30px 20px;border-bottom:1px solid var(--line);transition:background .2s}.story:hover{background:#e7e6df}.story-1:hover{background:#e2e7ff}.story-2:hover{background:#ededeb}.story-3:hover{background:#e9e8e2}.story-side{display:flex;flex-direction:column;justify-content:space-between}.story-no{font:11px monospace;color:var(--muted)}.story-main h3{font-size:clamp(28px,3vw,46px);line-height:1.02;letter-spacing:-.045em;margin:0 0 42px;max-width:800px}.ps{display:grid;grid-template-columns:1fr 1fr;gap:45px}.ps span{font:9px monospace;letter-spacing:.1em;color:var(--muted)}.ps p{font-size:14px;line-height:1.45;margin:8px 0 0;color:var(--muted);max-width:390px}.story-result{border-left:1px solid var(--line);padding-left:25px;display:flex;flex-direction:column}.story-result strong{font-size:clamp(40px,4.5vw,68px);letter-spacing:-.065em;line-height:.9}.story-result span{font-size:11px;color:var(--muted);margin-top:10px}.story-result em{font:10px monospace;font-style:normal;margin-top:auto;border-bottom:1px solid var(--ink);padding-bottom:7px;align-self:flex-start}@media(max-width:900px){.hero,.section-title,.library-head{grid-template-columns:1fr}.flag-grid{grid-template-columns:1fr;grid-auto-rows:auto}.flag,.flag-2,.flag-3{grid-column:auto;grid-row:auto;min-height:430px}.story{grid-template-columns:1fr;gap:25px}.story-side{flex-direction:row}.story-result{border-left:0;border-top:1px solid var(--line);padding:20px 0 0;min-height:140px}.ps{grid-template-columns:1fr}.hero{gap:35px}.top span:last-child{display:none}}
</style>