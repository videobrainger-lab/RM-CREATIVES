---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Insights | RM CREATIVES" description="Practical insights on patient acquisition, Meta Ads, Google Ads, SEO and clinic websites.">
  <main class="page shell">
    <div class="top eyebrow"><span>INSIGHTS</span><span>RM CREATIVES / KNOWLEDGE</span></div>

    <section class="hero">
      <h1>Practical marketing<br/>for clinics.</h1>
      <p>Breakdowns of advertising, websites, SEO and patient acquisition systems. No agency noise — only what we actually use in real projects.</p>
    </section>

    <section class="soon">
      <div><span class="eyebrow">COMING SOON</span><h2>New articles<br/>are on the way.</h2></div>
      <div class="subscribe">
        <p>We're preparing new practical articles and case-based breakdowns. In the meantime, subscribe and we'll keep you posted when new material is published.</p>
        <a href="/contact">Subscribe for updates ↗</a>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.page{padding:38px 0 140px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.hero{padding:100px 0 110px;display:grid;grid-template-columns:1.45fr .55fr;gap:70px;align-items:end}.hero h1{font-size:clamp(58px,8vw,120px);line-height:.88;letter-spacing:-.065em;margin:0;font-weight:650}.hero p{font-size:18px;line-height:1.5;color:var(--muted);margin:0}.soon{border-top:1px solid var(--ink);padding:40px 0 0;display:grid;grid-template-columns:1.25fr .75fr;gap:80px}.soon h2{font-size:clamp(48px,6vw,88px);line-height:.9;letter-spacing:-.06em;margin:35px 0 0}.subscribe{padding-top:35px}.subscribe p{font-size:18px;line-height:1.55;color:var(--muted);margin:0 0 35px;max-width:520px}.subscribe a{display:inline-block;background:var(--ink);color:white;padding:17px 21px;font-weight:650}@media(max-width:800px){.hero,.soon{grid-template-columns:1fr}.hero{padding:70px 0}.soon{gap:35px}.top span:last-child{display:none}}
</style>