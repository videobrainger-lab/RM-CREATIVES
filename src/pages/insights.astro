---
import BaseLayout from '../layouts/BaseLayout.astro';
import { libraryArticles, libraryCategories } from '../data/libraryArticles';
const featured = libraryArticles.find(article => article.slug === 'clinic-marketing-benchmarks');
const editorial = libraryArticles.filter(article => !article.dataset);
---
<BaseLayout title="Clinic Growth Library | RM CREATIVES" description="Commercial clinic marketing guides, patient acquisition benchmarks and practical strategy for dental, medical and aesthetic clinics." hasRuAlternate={false}>
<main class="library">
  <header class="hero shell">
    <div class="top eyebrow"><span>CLINIC GROWTH LIBRARY</span><span>DENTAL / MEDICAL / AESTHETIC / PATIENT ACQUISITION</span></div>
    <div class="hero-grid"><h1>Evidence for<br/>clinic growth.</h1><div><p>Commercial guides, operating frameworks and first-party benchmarks for clinic owners and directors.</p><span class="eyebrow">NO GENERAL MARKETING BLOG</span></div></div>
  </header>

  <section class="categories shell"><span class="eyebrow">EXPLORE BY AREA</span><div class="category-grid">{libraryCategories.map((category,index) => <a href={category.href}><span class="eyebrow">0{index+1}</span><h2>{category.label}</h2><p>{category.copy}</p><b>EXPLORE ↗</b></a>)}</div></section>

  {featured && <section class="data-feature"><div class="shell data-grid"><div><span class="eyebrow">OPEN DATA / 2024–2026</span><h2>Clinic marketing<br/>benchmarks.</h2><p>{featured.dek}</p><div class="actions"><a href={`/insights/${featured.slug}/`}>Explore the dataset ↗</a><a href="/data/clinic-marketing-benchmarks-2026.csv" download>Download CSV ↓</a></div></div><div class="data-panel"><div><strong>€2.07</strong><span>DENTAL GOOGLE CPA · 2025</span></div><div><strong>€5.85</strong><span>AESTHETIC META CPL · 2026</span></div><div><strong>4.17–7.42%</strong><span>OBSERVED MEDICAL LEAD CR</span></div><small>Observed project data. Read definitions and limitations before comparison.</small></div></div></section>}

  <section class="latest shell"><div class="section-head"><span class="eyebrow">COMMERCIAL-INTENT GUIDES</span><h2>Built for decisions.</h2></div><div class="article-grid">{editorial.map((article,index) => <a class="article-card" href={`/insights/${article.slug}/`}><div><span class="eyebrow">{article.categoryLabel} / {article.readingTime}</span><span class="eyebrow muted">{String(index+1).padStart(2,'0')}</span></div><h3>{article.title}</h3><p>{article.description}</p><b>READ GUIDE ↗</b></a>)}</div></section>

  <section class="method"><div class="shell method-grid"><span class="eyebrow">EDITORIAL STANDARD</span><div><h2>Useful enough<br/>to operate from.</h2><p>Every guide has a defined commercial intent, a direct answer, source-aware claims, an updated date, FAQ and a path to the relevant service or case study. Benchmarks keep the period, currency and conversion definition attached.</p></div></div></section>
</main>
</BaseLayout>
<style>
.library{overflow:hidden}.hero{padding:38px 0 110px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:16px}.hero-grid{display:grid;grid-template-columns:1.45fr .55fr;gap:7vw;align-items:end;padding-top:85px}.hero h1{font-size:clamp(68px,10vw,145px);line-height:.83;letter-spacing:-.075em;font-weight:580;margin:0}.hero-grid p{font-size:22px;line-height:1.45;color:var(--muted);margin-bottom:35px}.categories{padding-bottom:120px}.category-grid{display:grid;grid-template-columns:repeat(2,1fr);margin-top:28px;border-top:1px solid var(--ink)}.category-grid a{min-height:260px;padding:28px 30px 28px 0;border-bottom:1px solid var(--line);display:flex;flex-direction:column}.category-grid a:nth-child(odd){border-right:1px solid var(--line)}.category-grid a:nth-child(even){padding-left:30px}.category-grid h2{font-size:clamp(36px,5vw,66px);line-height:.94;letter-spacing:-.055em;margin:40px 0 18px}.category-grid p{color:var(--muted);max-width:430px;line-height:1.5}.category-grid b{font:11px monospace;margin-top:auto;color:var(--accent)}.data-feature{background:var(--dark);color:white;padding:110px 0}.data-grid{display:grid;grid-template-columns:1fr .8fr;gap:8vw;align-items:center}.data-grid h2{font-size:clamp(54px,7.5vw,104px);line-height:.88;letter-spacing:-.065em;font-weight:560;margin:28px 0}.data-grid p{font-size:19px;line-height:1.5;color:#aaa;max-width:600px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:35px}.actions a{display:inline-flex;padding:16px 20px;background:var(--accent);font-size:12px;font-weight:700}.actions a:last-child{background:white;color:#111}.data-panel{border:1px solid #333;padding:30px}.data-panel>div{padding:22px 0;border-bottom:1px solid #333}.data-panel strong{font-size:clamp(42px,5vw,68px);letter-spacing:-.06em;display:block}.data-panel span,.data-panel small{font:10px monospace;color:#888}.data-panel small{display:block;margin-top:25px;line-height:1.5}.latest{padding-top:120px;padding-bottom:130px}.section-head{display:grid;grid-template-columns:.45fr 1.55fr;gap:6vw;align-items:start;margin-bottom:55px}.section-head h2{font-size:clamp(55px,8vw,110px);line-height:.86;letter-spacing:-.07em;font-weight:560;margin:0}.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.article-card{border:1px solid var(--line);min-height:390px;padding:24px;display:flex;flex-direction:column}.article-card>div{display:flex;justify-content:space-between;gap:12px}.article-card h3{font-size:31px;line-height:1;letter-spacing:-.045em;margin:55px 0 20px}.article-card p{color:var(--muted);font-size:14px;line-height:1.55}.article-card>b{font:11px monospace;color:var(--accent);margin-top:auto}.method{background:#e7e6df;padding:110px 0}.method-grid{display:grid;grid-template-columns:.45fr 1.55fr;gap:7vw}.method h2{font-size:clamp(52px,7vw,96px);line-height:.9;letter-spacing:-.06em;font-weight:560;margin:0 0 35px}.method p{max-width:760px;font-size:20px;line-height:1.55;color:var(--muted)}
@media(max-width:820px){.top span:last-child{display:none}.hero-grid,.data-grid,.section-head,.method-grid{grid-template-columns:1fr}.hero-grid{padding-top:60px}.category-grid,.article-grid{grid-template-columns:1fr}.category-grid a:nth-child(odd){border-right:0}.category-grid a:nth-child(even){padding-left:0}.data-panel{margin-top:35px}.section-head{gap:25px}.article-card{min-height:320px}}
</style>
