---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Insights | RM CREATIVES" description="Practical insights on patient acquisition, Meta Ads, Google Ads, SEO and clinic websites.">
<main class="page shell">
  <div class="top eyebrow"><span>INSIGHTS</span><span>RM CREATIVES / KNOWLEDGE</span></div>
  <section class="hero"><h1>Practical marketing<br/>for clinics.</h1><p>Breakdowns of advertising, websites, SEO and patient acquisition systems. No agency noise — only what we actually use in real projects.</p></section>
  <section class="soon"><div><span class="eyebrow">COMING SOON</span><h2>New articles<br/>are on the way.</h2></div><div class="subscribe"><p>We're preparing new practical articles and case-based breakdowns. Leave your email and we'll let you know when a new piece is published.</p><form name="insights-subscribe-en" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-subscribe data-language="en"><input type="hidden" name="form-name" value="insights-subscribe-en"/><input type="hidden" name="language" value="en"/><input type="hidden" name="source" value="insights"/><p class="hidden"><label>Don't fill this out <input name="bot-field"/></label></p><div class="form-row"><label class="sr-only" for="email-en">Email</label><input id="email-en" type="email" name="email" placeholder="YOUR EMAIL" required autocomplete="email"/><button type="submit">SUBSCRIBE ↗</button></div><small>Only new RM CREATIVES articles. No spam.</small><div class="success" hidden><span class="eyebrow">DONE</span><strong>Thanks. You're subscribed.</strong><p>We'll email you when a new article is published.</p></div></form></div></section>
</main>
<script>
const form=document.querySelector('form[data-subscribe]');
if(form){form.addEventListener('submit',async(e)=>{e.preventDefault();const email=form.querySelector('input[name="email"]')?.value?.trim();const button=form.querySelector('button[type="submit"]');const row=form.querySelector('.form-row');const note=form.querySelector('small');const success=form.querySelector('.success');if(!email)return;const original=button?.textContent;if(button){button.disabled=true;button.textContent='SENDING…';}let ok=false;try{const response=await fetch('/.netlify/functions/subscribe',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email,language:'en'})});ok=response.ok;}catch(error){console.warn('SendPulse unavailable',error);}if(!ok){try{const data=new URLSearchParams(new FormData(form));const fallback=await fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:data.toString()});ok=fallback.ok;}catch(error){console.warn('Netlify Forms fallback unavailable',error);}}if(ok){if(row)row.hidden=true;if(note)note.hidden=true;if(success)success.hidden=false;form.reset();}else if(button){button.textContent='TRY AGAIN';button.disabled=false;}if(ok&&button){button.disabled=false;button.textContent=original||'SUBSCRIBE ↗';}});}
</script>
</BaseLayout>
<style>
.page{padding:38px 0 140px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.hero{padding:100px 0 110px;display:grid;grid-template-columns:1.45fr .55fr;gap:70px;align-items:end}.hero h1{font-size:clamp(58px,8vw,120px);line-height:.88;letter-spacing:-.065em;margin:0;font-weight:650}.hero p{font-size:18px;line-height:1.5;color:var(--muted);margin:0}.soon{border-top:1px solid var(--ink);padding:40px 0 0;display:grid;grid-template-columns:1.25fr .75fr;gap:80px}.soon h2{font-size:clamp(48px,6vw,88px);line-height:.9;letter-spacing:-.06em;margin:35px 0 0}.subscribe{padding-top:35px}.subscribe>p{font-size:18px;line-height:1.55;color:var(--muted);margin:0 0 35px;max-width:540px}.form-row{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid var(--ink)}input{appearance:none;border:0;background:transparent;padding:18px 0;font:inherit;font-size:16px;outline:none;min-width:0}button{border:0;background:var(--ink);color:white;padding:0 22px;font:11px monospace;letter-spacing:.08em;cursor:pointer}button:disabled{opacity:.65;cursor:wait}small{display:block;margin-top:12px;color:var(--muted);font-size:11px}.success{border-top:1px solid var(--ink);padding-top:22px}.success strong{display:block;font-size:28px;letter-spacing:-.03em;margin-top:12px}.success p{font-size:14px;color:var(--muted);margin:8px 0 0}.hidden,.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:800px){.hero,.soon{grid-template-columns:1fr}.hero{padding:70px 0}.soon{gap:35px}.top span:last-child{display:none}.form-row{grid-template-columns:1fr}.form-row button{padding:17px 20px}}
</style>