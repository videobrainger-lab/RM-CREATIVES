---
import '../styles/homepage.css';
import BaseLayout from '../layouts/BaseLayout.astro';
const services=[
  {n:'01',name:'RM Performance',meta:'META ADS / ACQUISITION',title:"Create patient demand with Meta Ads.",bullets:["Specialist-led strategy and creative.", "AI compares tests and lead quality."],href:'/performance',kind:'performance'},
  {n:'02',name:'RM Search',meta:'GOOGLE ADS / EXISTING DEMAND',title:"Reach patients already searching.",bullets:["Specialists control strategy and budget.", "AI analyses queries, costs and conversions."],href:'/search',kind:'search'},
  {n:'03',name:'RM Sites',meta:'WEB / CONVERSION / SEO',title:"Turn interest into clinic enquiries.",bullets:["UX and content shaped by specialists.", "AI supports research and quality checks."],href:'/sites',kind:'sites'}
];
const cases=[
 {client:'EPILINE',sector:'Aesthetic medicine / Riga · Jurmala',metric:'2,970',label:'Meta enquiries · Jan–Aug 2026',tags:'FULL-STACK GROWTH',href:'/cases/epiline'},
 {client:'CONSILIUM MEDICUM',sector:'Medical clinic / Latvia',metric:'3,356',label:'Google Ads conversions · 2024',tags:'GOOGLE ADS / SEO / META',href:'/cases/consilium-medicum'},
 {client:'DENTA',sector:'Dental clinic / Latvia',metric:'16,227',label:'tracked enquiries · 2025',tags:'FULL-STACK / SEO',href:'/cases/denta'},
 {client:'UNION KLINIKA',sector:'Medical clinic / Riga',metric:'1,021',label:'Meta enquiries · May–Dec 2024',tags:'WEBSITE / META / GOOGLE',href:'/cases/union-klinika'}
];
const enquiries=[{type:'DENTAL',service:'IMPLANT CONSULTATION',status:'NEW'},{type:'AESTHETIC',service:'LASER TREATMENT',status:'QUALIFIED'},{type:'MEDICAL',service:'SPECIALIST CONSULTATION',status:'NEW'}];
---
<BaseLayout>
<main class="copy-page home-page">
<section class="hero shell"><div class="hero-top eyebrow"><span>RESULTS MATTER / MEDICAL &amp; AESTHETIC CLINICS</span><span>EUROPE + INTERNATIONAL</span></div><div class="hero-core"><div class="hero-title"><h1>Patient acquisition for clinics.</h1></div><aside class="system-panel"><div class="panel-head eyebrow"><span>RM / ACQUISITION SYSTEM</span><span class="live"><i></i> LIVE</span></div><div class="panel-stat"><span class="eyebrow muted">PATIENT ENQUIRIES GENERATED</span><strong>10,000+</strong></div><div class="panel-row"><span class="eyebrow muted">INDUSTRY</span><b>MEDICAL / AESTHETIC</b></div><div class="panel-row"><span class="eyebrow muted">CHANNELS</span><b>META / GOOGLE / WEB</b></div><div class="feed"><div class="feed-head eyebrow muted"><span>RECENT ENQUIRIES</span><span>STATUS</span></div>{enquiries.map((item,i)=><div class={`feed-row delay-${i}`}><div><b>{item.type}</b><span>{item.service}</span></div><em>{item.status}</em></div>)}</div></aside></div><div class="hero-bottom"><p>Human-led. AI-augmented.</p><div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Discuss your growth system ↗</a><a class="button secondary" href="#cases">See real clinic results ↓</a></div></div></section>
<section class="signal"><div class="shell signal-inner eyebrow"><span>MEDICAL</span><span>DENTAL</span><span>AESTHETIC MEDICINE</span><span>BEAUTY</span><span>PATIENT ACQUISITION ↑</span></div></section>
<section class="services shell" id="services"><div class="products-head"><div><span class="eyebrow">OUR PRODUCTS</span><h2>Three products. One AI-augmented system.</h2></div><div class="products-head-copy"><span class="eyebrow">THREE PRODUCTS. ONE SYSTEM.</span><p>We create demand, capture patient intent and turn interest into enquiries. Specialists lead each channel; AI helps them analyse more and act sooner.</p></div></div><div class="product-grid">{services.map(service=><a class="product-card" href={service.href}><div class="product-meta"><span>{service.n} / 03</span><span>{service.meta}</span></div><h3>{service.name}</h3><p class="product-title">{service.title}</p><div class={`product-visual ${service.kind}`}>{service.kind==='performance'&&<><div class="social-box">META</div><span>→</span><div class="lead-box"><i></i> ENQUIRY</div><span>→</span><div class="plus-box">+1</div></>}{service.kind==='search'&&<><div class="search-bar"><b>G</b><span>dental implants</span><em>⌕</em></div><div class="search-flow"><span>CLICK</span><b>→</b><span>VISIT</span><b>→</b><span>ENQUIRE</span></div></>}{service.kind==='sites'&&<div class="browser"><div class="browser-top"><span>● ● ●</span><small>yourclinic.lv</small></div><div class="browser-body"><strong>Modern<br/>clinic website</strong><button>Book now</button><i>↑<br/>MORE<br/>ENQUIRIES</i></div></div>}</div><ul>{service.bullets.map(item=><li>{item}</li>)}</ul><div class="product-link"><span>LEARN MORE</span><span>→</span></div></a>)}</div><div class="products-foot eyebrow"><span>REAL CLINICS. REAL RESULTS.</span><span>BUILT FOR CLINICS.</span></div></section>
<section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>patient enquiries</span></div><div><strong>5+</strong><span>years in healthcare</span></div><div><strong>EU</strong><span>markets</span></div><div><strong>3</strong><span>focused products</span></div></div></section>
<section class="cases shell" id="cases"><div class="section-head horizontal"><div><span class="eyebrow">FLAGSHIP CASES</span><h2>Four partnerships.<br/>Years of work.</h2></div><a href="/cases" class="text-link">Explore all cases ↗</a></div><div class="case-grid">{cases.map(item=><a class="case-card" href={item.href}><div class="case-meta eyebrow"><span>{item.tags}</span><span>↗</span></div><div class="case-space"></div><div class="case-result"><strong>{item.metric}</strong><span>{item.label}</span></div><div class="case-footer"><h3>{item.client}</h3><p>{item.sector}</p></div></a>)}</div></section>
<section class="about"><div class="shell about-grid"><span class="eyebrow">Human judgement. AI scale.</span><h2>More eyes on every decision.</h2><div class="about-copy"><p>One specialist sees a channel. AI helps us see the system around it.</p><p>GOOGLE ADS — More search terms, spend and conversion signals analysed. Less budget wasted.</p><p>META ADS — More creative, audience and lead-quality patterns compared. Faster learning.</p><p>SEO / GEO — Demand, Search Console, competitors and AI visibility analysed together.</p></div></div></section><section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">WHY RM</span><h2>Specialists in control. AI at scale.</h2><div class="about-copy"><p>We build one patient-acquisition system around your clinic’s priorities. Specialists make the decisions. AI gives them more data, more context and more opportunities to find what deserves action.</p></div></div></section><section class="cta shell"><span class="eyebrow">START A PROJECT</span><h2>Need more than another campaign?</h2><p>Let us look at the whole route from patient demand to enquiry. We will show you where specialist judgement and AI-assisted analysis can create the biggest practical advantage.</p><a href="mailto:hello@rmcreatives.com">Let’s talk ↗</a></section>
</main></BaseLayout>
