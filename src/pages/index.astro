---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  { n:'01', name:'RM Performance', meta:'META ADS / PATIENT ACQUISITION', title:'Pay for enquiries.\nNot retainers.', text:'We agree the enquiry price before launch. Strategy, creatives, testing and optimisation stay on our side.', href:'/performance' },
  { n:'02', name:'RM Search', meta:'GOOGLE ADS / EXISTING DEMAND', title:'Capture demand\nthat already exists.', text:'Patients are already searching for clinics, doctors and procedures. We help them find you before your competitors.', href:'/search' },
  { n:'03', name:'RM Sites', meta:'WEB / CONVERSION / SEO', title:'Clinic website.\nLive in 1 day.', text:'Fast, responsive and SEO-ready websites built without WordPress and without months of development.', href:'/sites' }
];
const cases = [
  { client:'DENTA', sector:'Dental clinic / Latvia', metric:'4,792+', label:'patient enquiries', tags:'META ADS / SEO' },
  { client:'EPILINE', sector:'Aesthetic medicine', metric:'€2.41', label:'average lead cost', tags:'META ADS' },
  { client:'CONSILIUM', sector:'Medical clinic', metric:'6 mo.', label:'booking capacity filled', tags:'PERFORMANCE' }
];
const enquiries = [
  { type:'DENTAL', service:'IMPLANT CONSULTATION', status:'NEW' },
  { type:'AESTHETIC', service:'LASER TREATMENT', status:'QUALIFIED' },
  { type:'MEDICAL', service:'SPECIALIST CONSULTATION', status:'NEW' }
];
---
<BaseLayout>
<main>
  <section class="hero shell">
    <div class="hero-top eyebrow"><span>FOR MEDICAL & BEAUTY CLINICS</span><span>RIGA / EUROPE</span></div>
    <div class="hero-core">
      <div class="hero-title"><h1>Patient acquisition<br/>for clinics.</h1></div>
      <aside class="system-panel">
        <div class="panel-head eyebrow"><span>RM / ACQUISITION SYSTEM</span><span class="live"><i></i> LIVE</span></div>
        <div class="panel-stat"><span class="eyebrow muted">PATIENT ENQUIRIES GENERATED</span><strong>10,000+</strong></div>
        <div class="panel-row"><span class="eyebrow muted">INDUSTRY</span><b>MEDICAL / BEAUTY</b></div>
        <div class="panel-row"><span class="eyebrow muted">CHANNELS</span><b>META / GOOGLE / WEB</b></div>
        <div class="feed">
          <div class="feed-head eyebrow muted"><span>RECENT ENQUIRIES</span><span>STATUS</span></div>
          {enquiries.map((item, i) => <div class={`feed-row delay-${i}`}><div><b>{item.type}</b><span>{item.service}</span></div><em>{item.status}</em></div>)}
        </div>
      </aside>
    </div>
    <div class="hero-bottom"><p>Meta Ads, Google Ads and high-converting websites built exclusively for medical and beauty clinics.</p><div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Discuss a project ↗</a><a class="button secondary" href="#cases">View cases ↓</a></div></div>
  </section>
  <section class="signal"><div class="shell signal-inner eyebrow"><span>MEDICAL</span><span>DENTAL</span><span>AESTHETIC MEDICINE</span><span>BEAUTY</span><span>PATIENT ACQUISITION ↑</span></div></section>
  <section class="services shell" id="services"><div class="section-head"><span class="eyebrow">WHAT WE DO</span><h2>Three products.<br/>One objective.</h2><p>More qualified patient enquiries, with less marketing noise.</p></div><div class="service-list">{services.map(service=><a class="service-card" href={service.href}><div class="eyebrow">{service.n} / 03</div><div class="service-name"><div class="eyebrow muted">{service.meta}</div><h3>{service.name}</h3></div><div class="service-copy"><h4>{service.title.split('\n').map(line=><>{line}<br/></>)}</h4><p>{service.text}</p></div><div class="service-arrow">↗</div></a>)}</div></section>
  <section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>patient enquiries</span></div><div><strong>5+</strong><span>years in healthcare</span></div><div><strong>EU</strong><span>markets</span></div><div><strong>3</strong><span>focused products</span></div></div></section>
  <section class="cases shell" id="cases"><div class="section-head horizontal"><div><span class="eyebrow">SELECTED WORK</span><h2>Cases, not claims.</h2></div><a href="/cases" class="text-link">All cases ↗</a></div><div class="case-grid">{cases.map(item=><article class="case-card"><div class="case-meta eyebrow"><span>{item.tags}</span><span>↗</span></div><div class="case-space"></div><div class="case-result"><strong>{item.metric}</strong><span>{item.label}</span></div><div class="case-footer"><h3>{item.client}</h3><p>{item.sector}</p></div></article>)}</div></section>
  <section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">WHY RM</span><h2>Built for clinics.<br/>Measured by outcomes.</h2><div class="about-copy"><p>We do not sell a long list of marketing services. We build patient acquisition systems around three things we can execute exceptionally well.</p><p class="muted">Meta for demand generation. Google for active demand. Websites for conversion.</p></div></div></section>
  <section class="cta shell"><span class="eyebrow">START A PROJECT</span><h2>Need more patient<br/>enquiries?</h2><a href="mailto:hello@rmcreatives.com">Let’s talk ↗</a></section>
</main>
</BaseLayout>
<style>
.hero{min-height:780px;display:flex;flex-direction:column;justify-content:space-between;padding:38px 0 52px}.hero-top{display:flex;justify-content:space-between}.hero-core{display:grid;grid-template-columns:minmax(0,2.25fr) minmax(330px,.75fr);gap:36px;align-items:end}.hero h1{margin:0;font-size:clamp(68px,9.7vw,154px);line-height:.84;letter-spacing:-.075em;font-weight:650}.system-panel{border:1px solid var(--ink);background:rgba(248,248,244,.34);min-height:420px;display:flex;flex-direction:column}.panel-head,.panel-row,.feed-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}.live{display:flex;align-items:center;gap:7px}.live i{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(200,255,26,.18)}.panel-stat{padding:20px 16px 25px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.panel-stat strong{font-size:clamp(48px,4.4vw,72px);letter-spacing:-.065em;line-height:.9;font-weight:600}.panel-row{font-size:12px}.panel-row b{font-size:11px;letter-spacing:.04em}.feed{margin-top:auto}.feed-row{min-height:58px;padding:10px 16px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;align-items:center;animation:signalIn .55s both}.feed-row:last-child{border-bottom:0}.feed-row div{display:flex;flex-direction:column;gap:3px}.feed-row b{font-size:11px;letter-spacing:.08em}.feed-row span{font-size:10px;color:var(--muted);letter-spacing:.05em}.feed-row em{font-style:normal;font-family:monospace;font-size:9px;border:1px solid var(--line);padding:5px 7px}.delay-1{animation-delay:.18s}.delay-2{animation-delay:.36s}@keyframes signalIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}.hero-bottom p{font-size:clamp(20px,1.8vw,28px);line-height:1.2;letter-spacing:-.035em;max-width:650px;margin:0}.hero-actions{display:flex;gap:10px;justify-content:flex-end}.button{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:650}.primary{background:var(--ink);color:var(--white)}.secondary{border:1px solid var(--line)}
.signal{background:var(--accent);border-top:1px solid #a8d500;border-bottom:1px solid #a8d500}.signal-inner{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:20px}.services{padding:150px 0 120px}.section-head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:30px;margin-bottom:80px}.section-head h2,.about h2{font-size:clamp(42px,5.2vw,78px);line-height:.98;letter-spacing:-.055em;margin:-9px 0 0;font-weight:600}.section-head>p{margin:0;max-width:310px;line-height:1.45;color:var(--muted)}.service-list{border-top:1px solid var(--line)}.service-card{min-height:290px;display:grid;grid-template-columns:.6fr 1fr 1.5fr 60px;gap:30px;padding:30px 0;border-bottom:1px solid var(--line);transition:.2s}.service-card:hover{background:#e9e8e1;padding-left:18px;padding-right:18px}.service-name h3{font-size:26px;letter-spacing:-.04em;margin:16px 0 0}.service-copy h4{font-size:clamp(28px,3vw,48px);line-height:1;letter-spacing:-.05em;margin:0;font-weight:550}.service-copy p{max-width:500px;color:var(--muted);line-height:1.5;margin:28px 0 0}.service-arrow{font-size:28px;justify-self:end}.numbers{background:var(--dark);color:var(--white)}.numbers-grid{display:grid;grid-template-columns:repeat(4,1fr);min-height:315px}.numbers-grid>div{padding:42px 28px 32px 0;border-right:1px solid #2d2d2d;display:flex;flex-direction:column;justify-content:space-between}.numbers-grid>div:not(:first-child){padding-left:28px}.numbers strong{font-size:clamp(46px,5vw,78px);letter-spacing:-.055em;font-weight:550}.numbers span{color:#888;font-size:13px}.cases{padding:150px 0}.horizontal{grid-template-columns:1fr auto}.horizontal>div{display:flex;gap:80px;align-items:start}.text-link{font-size:13px;border-bottom:1px solid var(--ink);padding-bottom:3px}.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.case-card{min-height:560px;background:#e7e6df;padding:24px;display:flex;flex-direction:column;border:1px solid #dcdbd4}.case-card:nth-child(2){background:var(--accent)}.case-card:nth-child(3){background:var(--dark);color:var(--white);border-color:var(--dark)}.case-meta{display:flex;justify-content:space-between}.case-space{flex:1}.case-result{display:flex;flex-direction:column;border-bottom:1px solid currentColor;padding-bottom:20px;margin-bottom:20px}.case-result strong{font-size:clamp(56px,6vw,96px);letter-spacing:-.07em;line-height:.9;font-weight:550}.case-result span{margin-top:12px;font-size:13px;opacity:.6}.case-footer h3{margin:0 0 5px;font-size:25px}.case-footer p{margin:0;font-size:13px;opacity:.6}.about{background:var(--dark);color:var(--white);padding:150px 0}.about-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:30px}.about-copy p{margin:0 0 26px;line-height:1.5;font-size:18px}.about .muted{color:#8b8b8b}.cta{padding:160px 0 70px;min-height:670px;display:flex;flex-direction:column}.cta h2{margin:auto 0 34px;font-size:clamp(66px,9vw,145px);line-height:.86;letter-spacing:-.07em;font-weight:600}.cta a{font-size:18px;border-bottom:1px solid var(--ink);align-self:flex-start;padding-bottom:5px}
@media(max-width:1050px){.hero-core{grid-template-columns:1fr}.system-panel{min-height:340px}.hero{gap:50px}.hero-bottom,.section-head,.about-grid{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.service-card{grid-template-columns:50px 1fr 35px}.service-copy{grid-column:2/4}.numbers-grid{grid-template-columns:1fr 1fr}.case-grid{grid-template-columns:1fr}.case-card{min-height:420px}.horizontal,.horizontal>div{display:block}.text-link{display:inline-block;margin-top:30px}}@media(max-width:560px){.hero{min-height:0;padding-top:28px;gap:42px}.hero-top span:last-child{display:none}.hero h1{font-size:clamp(58px,18vw,88px)}.system-panel{min-height:330px}.hero-actions{flex-direction:column}.button{width:100%}.signal-inner span:nth-child(n+4){display:none}.services,.cases{padding:100px 0}.numbers-grid{grid-template-columns:1fr}.numbers-grid>div{min-height:170px;padding:28px 0!important}.about{padding:100px 0}.cta{min-height:560px;padding-top:100px}}
</style>