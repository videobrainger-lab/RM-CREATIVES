---
import BaseLayout from '../layouts/BaseLayout.astro';
const services=[
  {n:'01',name:'RM Performance',meta:'META ADS / ACQUISITION',title:'Pay for enquiries. Not for ad management.',bullets:['Qualified enquiries only','Transparent analytics','ROI-focused'],href:'/performance',kind:'performance'},
  {n:'02',name:'RM Search',meta:'GOOGLE ADS / EXISTING DEMAND',title:'Capture patients already searching for your services.',bullets:['Google Ads','High-intent traffic','More booked appointments'],href:'/search',kind:'search'},
  {n:'03',name:'RM Sites',meta:'WEB / CONVERSION / SEO',title:'Websites that turn interest into booked patients.',bullets:['Thoughtful UX and design','CRM integration','SEO-ready'],href:'/sites',kind:'sites'}
];
const cases=[{client:'DENTA',sector:'Dental clinic / Latvia',metric:'4,792+',label:'patient enquiries',tags:'META ADS / SEO'},{client:'EPILINE',sector:'Aesthetic medicine',metric:'€2.41',label:'average lead cost',tags:'META ADS'},{client:'CONSILIUM',sector:'Medical clinic',metric:'6 mo.',label:'booking capacity filled',tags:'PERFORMANCE'}];
const enquiries=[{type:'DENTAL',service:'IMPLANT CONSULTATION',status:'NEW'},{type:'AESTHETIC',service:'LASER TREATMENT',status:'QUALIFIED'},{type:'MEDICAL',service:'SPECIALIST CONSULTATION',status:'NEW'}];
---
<BaseLayout>
<main>
<section class="hero shell"><div class="hero-top eyebrow"><span>FOR MEDICAL & BEAUTY CLINICS</span><span>RIGA / EUROPE</span></div><div class="hero-core"><div class="hero-title"><h1>Patient acquisition<br/>for clinics.</h1></div><aside class="system-panel"><div class="panel-head eyebrow"><span>RM / ACQUISITION SYSTEM</span><span class="live"><i></i> LIVE</span></div><div class="panel-stat"><span class="eyebrow muted">PATIENT ENQUIRIES GENERATED</span><strong>10,000+</strong></div><div class="panel-row"><span class="eyebrow muted">INDUSTRY</span><b>MEDICAL / BEAUTY</b></div><div class="panel-row"><span class="eyebrow muted">CHANNELS</span><b>META / GOOGLE / WEB</b></div><div class="feed"><div class="feed-head eyebrow muted"><span>RECENT ENQUIRIES</span><span>STATUS</span></div>{enquiries.map((item,i)=><div class={`feed-row delay-${i}`}><div><b>{item.type}</b><span>{item.service}</span></div><em>{item.status}</em></div>)}</div></aside></div><div class="hero-bottom"><p>Meta Ads, Google Ads and high-converting websites built exclusively for medical and beauty clinics.</p><div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Discuss a project ↗</a><a class="button secondary" href="#cases">View cases ↓</a></div></div></section>
<section class="signal"><div class="shell signal-inner eyebrow"><span>MEDICAL</span><span>DENTAL</span><span>AESTHETIC MEDICINE</span><span>BEAUTY</span><span>PATIENT ACQUISITION ↑</span></div></section>
<section class="services shell" id="services"><div class="products-head"><div><span class="eyebrow">OUR PRODUCTS</span><h2>Three products<br/>to grow your clinic</h2></div><div class="products-head-copy"><span class="eyebrow">THREE PRODUCTS. ONE SYSTEM.</span><p>We generate new demand, capture existing patient intent and turn it into enquiries with high-converting websites.</p></div></div><div class="product-grid">{services.map(service=><a class="product-card" href={service.href}><div class="product-meta"><span>{service.n} / 03</span><span>{service.meta}</span></div><h3>{service.name}</h3><p class="product-title">{service.title}</p><div class={`product-visual ${service.kind}`}>{service.kind==='performance'&&<><div class="social-box">META</div><span>→</span><div class="lead-box"><i></i> ENQUIRY</div><span>→</span><div class="plus-box">+1</div></>}{service.kind==='search'&&<><div class="search-bar"><b>G</b><span>dental implants</span><em>⌕</em></div><div class="search-flow"><span>CLICK</span><b>→</b><span>VISIT</span><b>→</b><span>ENQUIRE</span></div></>}{service.kind==='sites'&&<div class="browser"><div class="browser-top"><span>● ● ●</span><small>yourclinic.lv</small></div><div class="browser-body"><strong>Modern<br/>clinic website</strong><button>Book now</button><i>↑<br/>MORE<br/>ENQUIRIES</i></div></div>}</div><ul>{service.bullets.map(item=><li>{item}</li>)}</ul><div class="product-link"><span>LEARN MORE</span><span>→</span></div></a>)}</div><div class="products-foot eyebrow"><span>REAL CLINICS. REAL RESULTS.</span><span>BUILT FOR CLINICS.</span></div></section>
<section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>patient enquiries</span></div><div><strong>5+</strong><span>years in healthcare</span></div><div><strong>EU</strong><span>markets</span></div><div><strong>3</strong><span>focused products</span></div></div></section><section class="cases shell" id="cases"><div class="section-head horizontal"><div><span class="eyebrow">SELECTED WORK</span><h2>Cases, not claims.</h2></div><a href="/cases" class="text-link">All cases ↗</a></div><div class="case-grid">{cases.map(item=><article class="case-card"><div class="case-meta eyebrow"><span>{item.tags}</span><span>↗</span></div><div class="case-space"></div><div class="case-result"><strong>{item.metric}</strong><span>{item.label}</span></div><div class="case-footer"><h3>{item.client}</h3><p>{item.sector}</p></div></article>)}</div></section><section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">WHY RM</span><h2>Built for clinics.<br/>Measured by outcomes.</h2><div class="about-copy"><p>We do not sell a long list of marketing services. We build patient acquisition systems around three things we can execute exceptionally well.</p><p class="muted">Meta for demand generation. Google for active demand. Websites for conversion.</p></div></div></section><section class="cta shell"><span class="eyebrow">START A PROJECT</span><h2>Need more patient<br/>enquiries?</h2><a href="mailto:hello@rmcreatives.com">Let’s talk ↗</a></section>
</main></BaseLayout>
<style>
.hero{min-height:780px;display:flex;flex-direction:column;justify-content:space-between;padding:38px 0 52px}.hero-top{display:flex;justify-content:space-between}.hero-core{display:grid;grid-template-columns:minmax(0,2.25fr) minmax(330px,.75fr);gap:36px;align-items:end}.hero h1{margin:0;font-size:clamp(68px,9.7vw,154px);line-height:.84;letter-spacing:-.075em;font-weight:650}.system-panel{border:1px solid var(--ink);background:rgba(248,248,244,.34);min-height:420px;display:flex;flex-direction:column}.panel-head,.panel-row,.feed-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}.live{display:flex;align-items:center;gap:7px}.live i{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(200,255,26,.18)}.panel-stat{padding:20px 16px 25px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.panel-stat strong{font-size:clamp(48px,4.4vw,72px);letter-spacing:-.065em;line-height:.9;font-weight:600}.panel-row{font-size:12px}.panel-row b{font-size:11px;letter-spacing:.04em}.feed{margin-top:auto}.feed-row{min-height:58px;padding:10px 16px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;align-items:center;animation:signalIn .55s both}.feed-row:last-child{border-bottom:0}.feed-row div{display:flex;flex-direction:column;gap:3px}.feed-row b{font-size:11px;letter-spacing:.08em}.feed-row span{font-size:10px;color:var(--muted);letter-spacing:.05em}.feed-row em{font-style:normal;font-family:monospace;font-size:9px;border:1px solid var(--line);padding:5px 7px}.delay-1{animation-delay:.18s}.delay-2{animation-delay:.36s}@keyframes signalIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}.hero-bottom p{font-size:clamp(20px,1.8vw,28px);line-height:1.2;letter-spacing:-.035em;max-width:650px;margin:0}.hero-actions{display:flex;gap:10px;justify-content:flex-end}.button{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:650}.primary{background:var(--ink);color:var(--white)}.secondary{border:1px solid var(--line)}.signal{background:var(--accent);border-top:1px solid #a8d500;border-bottom:1px solid #a8d500}.signal-inner{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.services{padding:120px 0 90px}.products-head{border-top:1px solid var(--line);padding-top:28px;display:grid;grid-template-columns:1.6fr .8fr;gap:70px;align-items:end;margin-bottom:44px}.products-head h2{font-size:clamp(44px,5vw,76px);line-height:.94;letter-spacing:-.055em;font-weight:650;margin:24px 0 0;max-width:820px}.products-head-copy{display:flex;flex-direction:column;gap:55px}.products-head-copy p{margin:0;color:var(--muted);font-size:18px;line-height:1.45;max-width:430px}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.product-card{min-height:635px;border:1px solid #aaa9a2;padding:24px 26px 22px;display:flex;flex-direction:column;background:rgba(255,255,255,.08);transition:background .25s ease,border-color .25s ease}.product-card:hover{background:#ecebe5;border-color:#777}.product-meta{display:flex;justify-content:space-between;gap:20px;font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;letter-spacing:.08em}.product-meta span:last-child{color:var(--muted);text-align:right}.product-card h3{font-size:31px;line-height:1;letter-spacing:-.045em;margin:34px 0 18px;font-weight:700}.product-title{font-size:22px;line-height:1.28;color:var(--muted);letter-spacing:-.025em;margin:0;max-width:360px}.product-visual{height:165px;border:1px solid #d7d6d0;border-radius:16px;margin:28px 0 24px;padding:20px;display:flex;align-items:center;justify-content:center;gap:10px;overflow:hidden;background:rgba(255,255,255,.26)}.social-box,.lead-box,.plus-box{border:1px solid var(--line);padding:12px 14px;font-family:monospace;font-size:11px;background:#f5f4ef}.social-box{font-weight:700}.lead-box{display:flex;align-items:center;gap:8px}.lead-box i{width:8px;height:8px;border-radius:50%;background:var(--accent)}.plus-box{font-size:25px;font-weight:800;background:var(--accent);border-color:var(--accent)}.search{flex-direction:column}.search-bar{width:100%;height:48px;border:1px solid #bbb;border-radius:24px;background:white;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:0 16px;font-size:12px}.search-bar b{font-size:18px}.search-bar em{font-style:normal;font-size:20px}.search-flow{display:flex;align-items:center;gap:7px;font-family:monospace;font-size:8px;white-space:nowrap}.search-flow span{border:1px solid var(--line);border-radius:14px;padding:5px 8px}.browser{width:100%;height:100%;border:1px solid #d0cfc9;background:#f9f8f3}.browser-top{height:30px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 10px;font-family:monospace;font-size:8px}.browser-body{height:calc(100% - 30px);padding:14px;position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;background:linear-gradient(90deg,#f6f4ee 0 66%,#e4e2db 66%)}.browser-body strong{font-family:Georgia,serif;font-size:18px;line-height:1.05;font-weight:500}.browser-body button{margin-top:12px;background:#111;color:white;border:0;padding:7px 18px;font-size:9px}.browser-body i{position:absolute;right:14px;top:14px;width:72px;height:72px;border-radius:50%;background:#f8f7f2;display:flex;align-items:center;justify-content:center;text-align:center;font-family:monospace;font-style:normal;font-size:8px}.product-card ul{list-style:none;padding:20px 0 0;margin:0;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.product-card li{font-size:14px;color:var(--muted);position:relative;padding-left:24px}.product-card li:before{content:'✓';position:absolute;left:0;color:var(--ink)}.product-link{margin-top:auto;padding-top:28px;border-bottom:1px solid var(--ink);padding-bottom:8px;display:flex;align-items:center;justify-content:space-between;font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;letter-spacing:.1em}.products-foot{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:38px;padding-top:22px}.section-head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:30px;margin-bottom:80px}.section-head h2,.about h2{font-size:clamp(42px,5.2vw,78px);line-height:.98;letter-spacing:-.055em;margin:-9px 0 0;font-weight:600}.section-head>p{margin:0;max-width:310px;line-height:1.45;color:var(--muted)}.numbers{background:var(--dark);color:var(--white)}.numbers-grid{display:grid;grid-template-columns:repeat(4,1fr);min-height:315px}.numbers-grid>div{padding:42px 28px 32px 0;border-right:1px solid #2d2d2d;display:flex;flex-direction:column;justify-content:space-between}.numbers-grid>div:not(:first-child){padding-left:28px}.numbers strong{font-size:clamp(46px,5vw,78px);letter-spacing:-.055em;font-weight:550}.numbers span{color:#888;font-size:13px}.cases{padding:150px 0}.horizontal{grid-template-columns:1fr auto}.horizontal>div{display:flex;gap:80px;align-items:start}.text-link{font-size:13px;border-bottom:1px solid var(--ink);padding-bottom:3px}.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.case-card{min-height:560px;background:#e7e6df;padding:24px;display:flex;flex-direction:column;border:1px solid #dcdbd4}.case-card:nth-child(2){background:var(--accent)}.case-card:nth-child(3){background:var(--dark);color:var(--white);border-color:var(--dark)}.case-meta{display:flex;justify-content:space-between}.case-space{flex:1}.case-result{display:flex;flex-direction:column;border-bottom:1px solid currentColor;padding-bottom:20px;margin-bottom:20px}.case-result strong{font-size:clamp(56px,6vw,96px);letter-spacing:-.07em;line-height:.9;font-weight:550}.case-result span{margin-top:12px;font-size:13px;opacity:.6}.case-footer h3{margin:0 0 5px;font-size:25px}.case-footer p{margin:0;font-size:13px;opacity:.6}.about{background:var(--dark);color:var(--white);padding:150px 0}.about-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:30px}.about-copy p{margin:0 0 26px;line-height:1.5;font-size:18px}.about .muted{color:#8b8b8b}.cta{padding:160px 0 70px;min-height:670px;display:flex;flex-direction:column}.cta h2{margin:auto 0 34px;font-size:clamp(66px,9vw,145px);line-height:.86;letter-spacing:-.07em;font-weight:600}.cta a{font-size:18px;border-bottom:1px solid var(--ink);align-self:flex-start;padding-bottom:5px}@media(max-width:1050px){.hero-core{grid-template-columns:1fr}.system-panel{min-height:340px}.hero{gap:50px}.hero-bottom,.section-head,.about-grid,.products-head{grid-template-columns:1fr}.products-head-copy{gap:18px}.hero-actions{justify-content:flex-start}.product-grid{grid-template-columns:1fr}.product-card{min-height:0}.numbers-grid{grid-template-columns:1fr 1fr}.case-grid{grid-template-columns:1fr}.case-card{min-height:420px}.horizontal,.horizontal>div{display:block}.text-link{display:inline-block;margin-top:30px}}@media(max-width:560px){.hero{min-height:0;padding-top:28px;gap:42px}.hero-top span:last-child{display:none}.hero h1{font-size:clamp(58px,18vw,88px)}.system-panel{min-height:330px}.hero-actions{flex-direction:column}.button{width:100%}.signal-inner span:nth-child(n+4){display:none}.numbers-grid{grid-template-columns:1fr}.numbers-grid>div{min-height:170px;padding:28px 0!important}.services,.cases,.about{padding:90px 0}.products-head h2{font-size:44px}.product-card{padding:20px}.product-card h3{font-size:28px}.product-visual{height:145px}.search-flow{transform:scale(.9)}.products-foot{gap:20px;flex-wrap:wrap}}
</style>