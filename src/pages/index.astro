---
import BaseLayout from '../layouts/BaseLayout.astro';
const services=[
  {n:'01',name:'RM Performance',meta:'META ADS / ACQUISITION',title:'Pay for enquiries. Not for ad management.',bullets:['Qualified enquiries only','Transparent analytics','ROI-focused'],href:'/performance',kind:'performance'},
  {n:'02',name:'RM Search',meta:'GOOGLE ADS / EXISTING DEMAND',title:'Capture patients already searching for your services.',bullets:['Google Ads','High-intent traffic','More booked appointments'],href:'/search',kind:'search'},
  {n:'03',name:'RM Sites',meta:'WEB / CONVERSION / SEO',title:'Websites that turn interest into booked patients.',bullets:['Thoughtful UX and design','CRM integration','SEO-ready'],href:'/sites',kind:'sites'}
];
const cases=[
 {client:'EPILINE',sector:'Aesthetic medicine / Riga · Jurmala',metric:'2,970',label:'Meta enquiries · Jan–Aug 2026',tags:'FULL-STACK GROWTH',href:'/cases/epiline'},
 {client:'CONSILIUM MEDICUM',sector:'Medical clinic / Latvia',metric:'3,356',label:'Google Ads conversions · 2024',tags:'GOOGLE ADS / SEO / META',href:'/cases/consilium-medicum'},
 {client:'DENTA',sector:'Dental clinic / Latvia',metric:'16,227',label:'tracked enquiries · 2025',tags:'FULL-STACK / SEO',href:'/cases/denta'},
 {client:'UNION KLINIKA',sector:'Medical clinic / Riga',metric:'1,021',label:'Meta enquiries · May–Dec 2024',tags:'WEBSITE / META / GOOGLE',href:'/cases/union-klinika'}
];
const enquiries=[{type:'DENTAL',service:'IMPLANT CONSULTATION',status:'NEW'},{type:'AESTHETIC',service:'LASER TREATMENT',status:'QUALIFIED'},{type:'MEDICAL',service:'SPECIALIST CONSULTATION',status:'NEW'}];
---
<BaseLayout>
<main>
<section class="hero shell"><div class="hero-top eyebrow"><span>FOR MEDICAL & BEAUTY CLINICS</span><span>RIGA / EUROPE</span></div><div class="hero-core"><div class="hero-title"><h1>Patient acquisition<br/>for clinics.</h1></div><aside class="system-panel"><div class="panel-head eyebrow"><span>RM / ACQUISITION SYSTEM</span><span class="live"><i></i> LIVE</span></div><div class="panel-stat"><span class="eyebrow muted">PATIENT ENQUIRIES GENERATED</span><strong>10,000+</strong></div><div class="panel-row"><span class="eyebrow muted">INDUSTRY</span><b>MEDICAL / BEAUTY</b></div><div class="panel-row"><span class="eyebrow muted">CHANNELS</span><b>META / GOOGLE / WEB</b></div><div class="feed"><div class="feed-head eyebrow muted"><span>RECENT ENQUIRIES</span><span>STATUS</span></div>{enquiries.map((item,i)=><div class={`feed-row delay-${i}`}><div><b>{item.type}</b><span>{item.service}</span></div><em>{item.status}</em></div>)}</div></aside></div><div class="hero-bottom"><p>Meta Ads, Google Ads and high-converting websites built exclusively for medical and beauty clinics.</p><div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Discuss a project ↗</a><a class="button secondary" href="#cases">View cases ↓</a></div></div></section>
<section class="signal"><div class="shell signal-inner eyebrow"><span>MEDICAL</span><span>DENTAL</span><span>AESTHETIC MEDICINE</span><span>BEAUTY</span><span>PATIENT ACQUISITION ↑</span></div></section>
<section class="services shell" id="services"><div class="products-head"><div><span class="eyebrow">OUR PRODUCTS</span><h2>Three products<br/>to grow your clinic</h2></div><div class="products-head-copy"><span class="eyebrow">THREE PRODUCTS. ONE SYSTEM.</span><p>We generate new demand, capture existing patient intent and turn it into enquiries with high-converting websites.</p></div></div><div class="product-grid">{services.map(service=><a class="product-card" href={service.href}><div class="product-meta"><span>{service.n} / 03</span><span>{service.meta}</span></div><h3>{service.name}</h3><p class="product-title">{service.title}</p><div class={`product-visual ${service.kind}`}>{service.kind==='performance'&&<><div class="social-box">META</div><span>→</span><div class="lead-box"><i></i> ENQUIRY</div><span>→</span><div class="plus-box">+1</div></>}{service.kind==='search'&&<><div class="search-bar"><b>G</b><span>dental implants</span><em>⌕</em></div><div class="search-flow"><span>CLICK</span><b>→</b><span>VISIT</span><b>→</b><span>ENQUIRE</span></div></>}{service.kind==='sites'&&<div class="browser"><div class="browser-top"><span>● ● ●</span><small>yourclinic.lv</small></div><div class="browser-body"><strong>Modern<br/>clinic website</strong><button>Book now</button><i>↑<br/>MORE<br/>ENQUIRIES</i></div></div>}</div><ul>{service.bullets.map(item=><li>{item}</li>)}</ul><div class="product-link"><span>LEARN MORE</span><span>→</span></div></a>)}</div><div class="products-foot eyebrow"><span>REAL CLINICS. REAL RESULTS.</span><span>BUILT FOR CLINICS.</span></div></section>
<section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>patient enquiries</span></div><div><strong>5+</strong><span>years in healthcare</span></div><div><strong>EU</strong><span>markets</span></div><div><strong>3</strong><span>focused products</span></div></div></section>
<section class="cases shell" id="cases"><div class="section-head horizontal"><div><span class="eyebrow">FLAGSHIP CASES</span><h2>Four partnerships.<br/>Years of work.</h2></div><a href="/cases" class="text-link">Explore all cases ↗</a></div><div class="case-grid">{cases.map(item=><a class="case-card" href={item.href}><div class="case-meta eyebrow"><span>{item.tags}</span><span>↗</span></div><div class="case-space"></div><div class="case-result"><strong>{item.metric}</strong><span>{item.label}</span></div><div class="case-footer"><h3>{item.client}</h3><p>{item.sector}</p></div></a>)}</div></section>
<section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">WHY RM</span><h2>Built for clinics.<br/>Measured by outcomes.</h2><div class="about-copy"><p>We do not sell a long list of marketing services. We build patient acquisition systems around three things we can execute exceptionally well.</p><p class="muted">Meta for demand generation. Google for active demand. Websites for conversion.</p></div></div></section><section class="cta shell"><span class="eyebrow">START A PROJECT</span><h2>Need more patient<br/>enquiries?</h2><a href="mailto:hello@rmcreatives.com">Let’s talk ↗</a></section>
</main></BaseLayout>
<style>
.hero{min-height:780px;display:flex;flex-direction:column;justify-content:space-between;padding:38px 0 52px}.hero-top{display:flex;justify-content:space-between}.hero-core{display:grid;grid-template-columns:minmax(0,2.25fr) minmax(330px,.75fr);gap:36px;align-items:end}.hero h1{margin:0;font-size:clamp(68px,9.7vw,154px);line-height:.84;letter-spacing:-.075em;font-weight:650}.system-panel{border:1px solid var(--ink);background:rgba(248,248,244,.34);min-height:420px;display:flex;flex-direction:column}.panel-head,.panel-row,.feed-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}.live{display:flex;align-items:center;gap:7px}.live i{width:7px;height:7px;border-radius:50%;background:var(--accent)}.panel-stat{padding:20px 16px 25px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.panel-stat strong{font-size:clamp(48px,4.4vw,72px);letter-spacing:-.065em;line-height:.9}.panel-row{font-size:12px}.panel-row b{font-size:11px}.feed{margin-top:auto}.feed-row{min-height:58px;padding:10px 16px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;align-items:center}.feed-row div{display:flex;flex-direction:column;gap:3px}.feed-row b{font-size:11px}.feed-row span{font-size:10px;color:var(--muted)}.feed-row em{font-style:normal;font-family:monospace;font-size:9px;border:1px solid var(--line);padding:5px 7px}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}.hero-bottom p{font-size:clamp(20px,1.8vw,28px);line-height:1.2;max-width:650px;margin:0}.hero-actions{display:flex;gap:10px;justify-content:flex-end}.button{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:650}.primary{background:var(--ink);color:var(--white)}.secondary{border:1px solid var(--line)}.signal{background:var(--accent)}.signal-inner{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:20px}.services{padding:120px 0 90px}.products-head{border-top:1px solid var(--line);padding-top:28px;display:grid;grid-template-columns:1.6fr .8fr;gap:70px;align-items:end;margin-bottom:44px}.products-head h2{font-size:clamp(44px,5vw,76px);line-height:.94;letter-spacing:-.055em;margin:24px 0 0}.products-head-copy{display:flex;flex-direction:column;gap:55px}.products-head-copy p{margin:0;color:var(--muted);font-size:18px;line-height:1.45}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.product-card{min-height:635px;border:1px solid #aaa9a2;padding:24px 26px 22px;display:flex;flex-direction:column}.product-meta{display:flex;justify-content:space-between;font:10px monospace}.product-card h3{font-size:31px;margin:34px 0 18px}.product-title{font-size:22px;color:var(--muted)}.product-visual{height:165px;border:1px solid #d7d6d0;border-radius:16px;margin:28px 0 24px;padding:20px;display:flex;align-items:center;justify-content:center;gap:10px}.social-box,.lead-box,.plus-box{border:1px solid var(--line);padding:12px 14px;font:11px monospace}.lead-box{display:flex;gap:8px}.lead-box i{width:8px;height:8px;border-radius:50%;background:var(--accent)}.plus-box{font-size:25px;background:var(--accent)}.search{flex-direction:column}.search-bar{width:100%;height:48px;border:1px solid #bbb;border-radius:24px;background:white;display:grid;grid-template-columns:auto 1fr auto;align-items:center;padding:0 16px}.search-flow{display:flex;gap:7px;font:8px monospace}.browser{width:100%;height:100%;border:1px solid #d0cfc9}.browser-top{height:30px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;padding:0 10px;align-items:center;font:8px monospace}.browser-body{height:calc(100% - 30px);padding:14px;display:flex;flex-direction:column;justify-content:center}.browser-body button{margin-top:12px;background:#111;color:#fff;border:0;padding:7px}.browser-body i{display:none}.product-card ul{list-style:none;padding:20px 0 0;border-top:1px solid var(--line)}.product-card li{font-size:14px;color:var(--muted);margin:10px 0}.product-link{margin-top:auto;border-bottom:1px solid var(--ink);padding-bottom:8px;display:flex;justify-content:space-between;font:10px monospace}.products-foot{display:flex;justify-content:space-between;margin-top:38px}.numbers{background:var(--dark);color:var(--white)}.numbers-grid{display:grid;grid-template-columns:repeat(4,1fr);min-height:315px}.numbers-grid>div{padding:42px 28px;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid #2d2d2d}.numbers strong{font-size:clamp(46px,5vw,78px)}.numbers span{color:#888}.cases{padding:150px 0}.section-head{margin-bottom:80px}.horizontal{display:flex;justify-content:space-between;align-items:end}.horizontal h2{font-size:clamp(42px,5.2vw,78px);line-height:.98;letter-spacing:-.055em;margin:20px 0 0}.text-link{font-size:13px;border-bottom:1px solid var(--ink)}.case-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.case-card{min-height:500px;background:#e7e6df;padding:24px;display:flex;flex-direction:column;border:1px solid #dcdbd4;transition:transform .2s}.case-card:hover{transform:translateY(-4px)}.case-card:nth-child(2){background:var(--accent)}.case-card:nth-child(3){background:var(--dark);color:var(--white)}.case-meta{display:flex;justify-content:space-between}.case-space{flex:1}.case-result strong{display:block;font-size:clamp(62px,7vw,108px);letter-spacing:-.07em}.case-result span{font-size:12px;opacity:.6}.case-footer{border-top:1px solid currentColor;margin-top:22px;padding-top:22px}.case-footer h3{font-size:28px;margin:0 0 5px}.case-footer p{font-size:12px;opacity:.6;margin:0}.about{background:#e5e4de;padding:130px 0}.about-grid{display:grid;grid-template-columns:.5fr 1fr .6fr;gap:60px}.about h2{font-size:clamp(42px,5.2vw,78px);margin:0}.about-copy{font-size:17px;line-height:1.5}.cta{padding:140px 0}.cta h2{font-size:clamp(60px,8vw,120px);line-height:.9;letter-spacing:-.065em}.cta>a{font-size:18px;border-bottom:1px solid var(--ink)}@media(max-width:800px){.hero-core,.hero-bottom,.products-head,.about-grid{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.product-grid,.case-grid,.numbers-grid{grid-template-columns:1fr}.signal-inner{overflow:auto}.horizontal{display:block}.text-link{display:inline-block;margin-top:25px}.case-card{min-height:400px}}
</style>