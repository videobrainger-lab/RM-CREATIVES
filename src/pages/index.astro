---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    n: '01',
    name: 'RM Performance',
    meta: 'META ADS / PATIENT ACQUISITION',
    title: 'Pay for enquiries.\nNot retainers.',
    text: 'We agree the enquiry price before launch. Strategy, creatives, testing and optimisation stay on our side.',
    href: '/performance'
  },
  {
    n: '02',
    name: 'RM Search',
    meta: 'GOOGLE ADS / EXISTING DEMAND',
    title: 'Capture demand\nthat already exists.',
    text: 'Patients are already searching for clinics, doctors and procedures. We help them find you before your competitors.',
    href: '/search'
  },
  {
    n: '03',
    name: 'RM Sites',
    meta: 'WEB / CONVERSION / SEO',
    title: 'Clinic website.\nLive in 1 day.',
    text: 'Fast, responsive and SEO-ready websites built without WordPress and without months of development.',
    href: '/sites'
  }
];

const cases = [
  { client: 'DENTA', sector: 'Dental clinic / Latvia', metric: '4,792+', label: 'patient enquiries', tags: 'META ADS / SEO' },
  { client: 'EPILINE', sector: 'Aesthetic medicine', metric: '€2.41', label: 'average lead cost', tags: 'META ADS' },
  { client: 'CONSILIUM', sector: 'Medical clinic', metric: '6 mo.', label: 'booking capacity filled', tags: 'PERFORMANCE' }
];
---
<BaseLayout>
  <main>
    <section class="hero shell">
      <div class="hero-top eyebrow"><span>HEALTHCARE & BEAUTY</span><span>EUROPE / 2026</span></div>
      <h1>Patient acquisition<br/>for clinics.</h1>
      <div class="hero-bottom">
        <p>Meta Ads, Google Ads and high-converting websites for medical and beauty clinics.</p>
        <div class="hero-actions">
          <a class="button primary" href="mailto:hello@rmcreatives.com">Discuss a project ↗</a>
          <a class="button secondary" href="#cases">View cases ↓</a>
        </div>
      </div>
    </section>

    <section class="signal">
      <div class="shell signal-inner eyebrow">
        <span>RIGA / EUROPE</span><span>MEDICAL</span><span>DENTAL</span><span>AESTHETIC</span><span>BEAUTY</span>
      </div>
    </section>

    <section class="services shell" id="services">
      <div class="section-head">
        <span class="eyebrow">WHAT WE DO</span>
        <h2>Three products.<br/>One objective.</h2>
        <p>More qualified patient enquiries, with less marketing noise.</p>
      </div>

      <div class="service-list">
        {services.map((service) => (
          <a class="service-card" href={service.href}>
            <div class="service-number eyebrow">{service.n} / 03</div>
            <div class="service-name">
              <div class="eyebrow muted">{service.meta}</div>
              <h3>{service.name}</h3>
            </div>
            <div class="service-copy">
              <h4>{service.title.split('\n').map((line) => <>{line}<br/></>)}</h4>
              <p>{service.text}</p>
            </div>
            <div class="service-arrow">↗</div>
          </a>
        ))}
      </div>
    </section>

    <section class="numbers">
      <div class="shell numbers-grid">
        <div><strong>10,000+</strong><span>patient enquiries</span></div>
        <div><strong>5+</strong><span>years in healthcare</span></div>
        <div><strong>EU</strong><span>markets</span></div>
        <div><strong>3</strong><span>focused products</span></div>
      </div>
    </section>

    <section class="cases shell" id="cases">
      <div class="section-head horizontal">
        <div><span class="eyebrow">SELECTED WORK</span><h2>Cases, not claims.</h2></div>
        <a href="/cases" class="text-link">All cases ↗</a>
      </div>
      <div class="case-grid">
        {cases.map((item) => (
          <article class="case-card">
            <div class="case-meta eyebrow"><span>{item.tags}</span><span>↗</span></div>
            <div class="case-space"></div>
            <div class="case-result"><strong>{item.metric}</strong><span>{item.label}</span></div>
            <div class="case-footer"><h3>{item.client}</h3><p>{item.sector}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="about" id="about">
      <div class="shell about-grid">
        <span class="eyebrow">WHY RM</span>
        <h2>Built for clinics.<br/>Measured by outcomes.</h2>
        <div class="about-copy">
          <p>We do not sell a long list of marketing services. We build patient acquisition systems around three things we can execute exceptionally well.</p>
          <p class="muted">Meta for demand generation. Google for active demand. Websites for conversion.</p>
        </div>
      </div>
    </section>

    <section class="cta shell">
      <span class="eyebrow">START A PROJECT</span>
      <h2>Need more patient<br/>enquiries?</h2>
      <a href="mailto:hello@rmcreatives.com">Let’s talk ↗</a>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { min-height: 760px; display: flex; flex-direction: column; justify-content: space-between; padding: 42px 0 54px; }
  .hero-top { display: flex; justify-content: space-between; }
  h1 { margin: 0; font-size: clamp(70px, 10.8vw, 170px); line-height: .83; letter-spacing: -.075em; font-weight: 650; max-width: 1320px; }
  .hero-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; }
  .hero-bottom p { font-size: clamp(20px, 2vw, 31px); line-height: 1.2; letter-spacing: -.035em; max-width: 680px; margin: 0; }
  .hero-actions { display: flex; gap: 10px; justify-content: flex-end; }
  .button { min-height: 54px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 650; }
  .primary { background: var(--ink); color: var(--white); }
  .secondary { border: 1px solid var(--line); }

  .signal { background: var(--accent); border-top: 1px solid #a8d500; border-bottom: 1px solid #a8d500; }
  .signal-inner { min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }

  .services { padding: 150px 0 120px; }
  .section-head { display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: start; gap: 30px; margin-bottom: 80px; }
  .section-head h2, .about h2 { font-size: clamp(42px, 5.2vw, 78px); line-height: .98; letter-spacing: -.055em; margin: -9px 0 0; font-weight: 600; }
  .section-head > p { margin: 0; max-width: 310px; line-height: 1.45; color: var(--muted); }
  .service-list { border-top: 1px solid var(--line); }
  .service-card { min-height: 290px; display: grid; grid-template-columns: .6fr 1fr 1.5fr 60px; gap: 30px; padding: 30px 0; border-bottom: 1px solid var(--line); transition: background .2s ease, padding .2s ease; }
  .service-card:hover { background: #e9e8e1; padding-left: 18px; padding-right: 18px; }
  .service-name h3 { font-size: 26px; letter-spacing: -.04em; margin: 16px 0 0; }
  .service-copy h4 { font-size: clamp(28px, 3vw, 48px); line-height: 1; letter-spacing: -.05em; margin: 0; font-weight: 550; }
  .service-copy p { max-width: 500px; color: var(--muted); line-height: 1.5; margin: 28px 0 0; }
  .service-arrow { font-size: 28px; justify-self: end; }

  .numbers { background: var(--dark); color: var(--white); }
  .numbers-grid { display: grid; grid-template-columns: repeat(4, 1fr); min-height: 315px; }
  .numbers-grid > div { padding: 42px 28px 32px 0; border-right: 1px solid #2d2d2d; display: flex; flex-direction: column; justify-content: space-between; }
  .numbers-grid > div:not(:first-child) { padding-left: 28px; }
  .numbers strong { font-size: clamp(46px, 5vw, 78px); letter-spacing: -.055em; font-weight: 550; }
  .numbers span { color: #888; font-size: 13px; }

  .cases { padding: 150px 0; }
  .horizontal { grid-template-columns: 1fr auto; }
  .horizontal > div { display: flex; gap: 80px; align-items: start; }
  .horizontal h2 { margin-top: -9px; }
  .text-link { font-size: 13px; border-bottom: 1px solid var(--ink); padding-bottom: 3px; }
  .case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .case-card { min-height: 560px; background: #e7e6df; padding: 24px; display: flex; flex-direction: column; border: 1px solid #dcdbd4; }
  .case-card:nth-child(2) { background: var(--accent); }
  .case-card:nth-child(3) { background: var(--dark); color: var(--white); border-color: var(--dark); }
  .case-meta { display: flex; justify-content: space-between; }
  .case-space { flex: 1; }
  .case-result { display: flex; flex-direction: column; border-bottom: 1px solid currentColor; padding-bottom: 20px; margin-bottom: 20px; }
  .case-result strong { font-size: clamp(56px, 6vw, 96px); letter-spacing: -.07em; line-height: .9; font-weight: 550; }
  .case-result span { margin-top: 12px; font-size: 13px; opacity: .6; }
  .case-footer h3 { margin: 0 0 5px; font-size: 25px; letter-spacing: -.035em; }
  .case-footer p { margin: 0; font-size: 13px; opacity: .6; }

  .about { background: var(--dark); color: var(--white); padding: 150px 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 30px; }
  .about-copy p { margin: 0 0 26px; line-height: 1.5; font-size: 18px; }
  .about .muted { color: #8b8b8b; }

  .cta { padding: 160px 0 70px; min-height: 670px; display: flex; flex-direction: column; }
  .cta h2 { margin: auto 0 34px; font-size: clamp(66px, 9vw, 145px); line-height: .86; letter-spacing: -.07em; font-weight: 600; }
  .cta a { font-size: 18px; border-bottom: 1px solid var(--ink); align-self: flex-start; padding-bottom: 5px; }

  @media (max-width: 900px) {
    .hero { min-height: 680px; }
    .hero-bottom, .section-head, .about-grid { grid-template-columns: 1fr; }
    .hero-actions { justify-content: flex-start; }
    .service-card { grid-template-columns: 50px 1fr 35px; min-height: 0; }
    .service-copy { grid-column: 2 / 4; }
    .numbers-grid { grid-template-columns: 1fr 1fr; }
    .numbers-grid > div { min-height: 210px; border-bottom: 1px solid #2d2d2d; }
    .case-grid { grid-template-columns: 1fr; }
    .case-card { min-height: 420px; }
    .horizontal, .horizontal > div { display: block; }
    .text-link { display: inline-block; margin-top: 30px; }
  }

  @media (max-width: 560px) {
    .hero { min-height: 620px; padding-top: 28px; }
    .hero-top span:last-child { display: none; }
    h1 { font-size: clamp(62px, 20vw, 96px); }
    .hero-bottom p { font-size: 19px; }
    .hero-actions { flex-direction: column; }
    .button { width: 100%; }
    .signal-inner span:nth-child(n+4) { display: none; }
    .services, .cases { padding: 100px 0; }
    .section-head { margin-bottom: 55px; }
    .service-card { padding: 24px 0 32px; }
    .numbers-grid { grid-template-columns: 1fr; }
    .numbers-grid > div { min-height: 170px; padding: 28px 0 !important; border-right: 0; }
    .about { padding: 100px 0; }
    .cta { min-height: 560px; padding-top: 100px; }
  }
</style>
