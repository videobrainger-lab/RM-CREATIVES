---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank you | RM CREATIVES" description="Your enquiry has been sent to RM CREATIVES.">
<main class="thanks shell"><span class="eyebrow">ENQUIRY RECEIVED</span><h1>Thank you.<br/>We’ll be in touch.</h1><p>Your enquiry has been sent successfully.</p><a href="/">Back to RM CREATIVES ↗</a></main>
</BaseLayout>
<style>.thanks{min-height:70vh;padding:110px 0}.eyebrow{font-family:monospace;font-size:11px;letter-spacing:.12em}.thanks h1{font-size:clamp(64px,9vw,130px);line-height:.9;letter-spacing:-.065em;margin:40px 0}.thanks p{font-size:20px;color:var(--muted);margin-bottom:50px}.thanks a{border-bottom:1px solid var(--ink);padding-bottom:4px;font-weight:650}</style>