x;padding:15px 20px;margin-bottom:30px;color:#555}.gbar b{float:right}.result{padding:15px 5px}.result small{display:block;font-size:10px}.result strong{display:block;color:#1647e8;font-size:21px;margin:8px 0}.result p{margin:0}.organic{opacity:.55;border-top:1px solid #ddd}.browserbar{display:flex;justify-content:space-between;font:9px monospace;border-bottom:1px solid #ddd;padding-bottom:15px}.landbody{padding:45px 15px}.landbody h4{font-size:42px;letter-spacing:-.05em;margin:12px 0}.landbody button{background:var(--accent);color:#fff;border:0;padding:14px 18px;font:10px monospace}.conversion{display:flex;flex-direction:column}.conversion>span,.conversion>small{font:10px monospace}.conversion strong{font-size:100px;letter-spacing:-.08em;margin-top:35px}.conversion p{margin:0 0 25px}.line{height:5px;background:#ddd;margin:25px 0}.line i{display:block;width:76%;height:100%;background:var(--accent)}.rules{margin-top:60px;border-top:1px solid #333}.rules div{display:grid;grid-template-columns:50px .5fr 1fr;gap:20px;padding:25px 0;border-bottom:1px solid #333}.rules span{font:10px monospace}.rules b{font-size:16px}.rules p{margin:0;font-size:13px}.numbers{padding:140px 0}.number-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.number-card{border:1px solid var(--line);min-height:300px;padding:22px;display:flex;flex-direction:column}.number-card strong{font-size:clamp(42px,5vw,72px);letter-spacing:-.065em;margin-top:auto}.number-card small{color:var(--muted);margin-top:8px}.note{font-size:12px;color:var(--muted);max-width:700px;margin:25px 0 0}.accent{background:var(--accent)}.accent h2{font-size:clamp(50px,7vw,100px);line-height:.9;letter-spacing:-.065em}.flow{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:70px;font:10px monospace}.flow span{border:1px solid #111;padding:12px}.next{padding:120px 0}.next h2{font-size:clamp(60px,9vw,135px);line-height:.85;letter-spacing:-.07em;margin:45px 0}.next a{font:11px monospace;color:inherit}@media(max-width:800px){.hero-grid,.two,.stage-head,.numbers-head,.step{grid-template-columns:1fr}.metrics,.number-grid{grid-template-columns:1fr 1fr}.metrics div:nth-child(2){border-right:0}.hero-grid{gap:35px;padding:65px 0}.case-section,.search-stage,.numbers{padding:90px 0}.step{gap:20px}.rules div{grid-template-columns:35px 1fr}.rules p{grid-column:2}.number-card{min-height:220px}}
</style>