---
import ConsiliumCaseLayout from '../../../layouts/ConsiliumCaseLayout.astro';
const months=[['JAN',304],['FEB',179],['MAR',186],['APR',139],['MAY',154],['JUN',124],['JUL',186],['AUG',192],['SEP',146],['OCT',161],['NOV',131],['DEC',109]];
---
<ConsiliumCaseLayout title="Consilium Medicum SEO case" description="How organic search generated 2,011 tracked enquiries for Consilium Medicum in 2025." eyebrow="SEO / ORGANIC" headline="2,011 organic" accent="enquiries." intro="For a medical clinic, search demand does not begin and end with paid ads. Service pages and useful medical content can keep meeting patients while no media budget is being spent on the click." metrics={[{value:'2,011',label:'organic enquiries · 2025'},{value:'304',label:'highest month · January'},{value:'12 mo',label:'tracked through the year'},{value:'225',label:'organic enquiries · Jan–Feb 2026'}]}>
<section class="case-section shell"><div class="two"><span class="eyebrow">THE IDEA</span><div><h2>Own part of the demand.<br/>Don’t rent all of it.</h2><p class="statement">Paid search can capture demand immediately. SEO builds pages that can keep answering the same patient questions organically.</p><p>For Consilium, organic search was not treated as a vanity traffic metric. The project reporting connected organic traffic with enquiries, so we could see whether visibility was producing patient action.</p></div></div></section>
<section class="organic"><div class="shell"><span class="eyebrow">2025 / TRACKED ORGANIC ENQUIRIES</span><div class="big">2,011</div><div class="months">{months.map(m=><div><span>{m[0]}</span><strong>{m[1]}</strong><i style={`height:${m[1]/304*150}px`}></i></div>)}</div></div></section>
<section class="case-section dark"><div class="shell two"><span class="eyebrow">HOW MEDICAL SEO WORKS</span><div><h2>Patient questions become<br/>search entry points.</h2><div class="data-list"><div class="data-row"><span>Service intent</span><span>Pages for specialists, procedures and services answer direct commercial demand.</span><strong>BOOKING</strong></div><div class="data-row"><span>Problem intent</span><span>Useful medical content meets patients earlier, when they are still trying to understand a symptom or condition.</span><strong>DISCOVERY</strong></div><div class="data-row"><span>Internal path</span><span>Content should lead naturally toward the relevant specialist or service rather than end as an isolated article.</span><strong>JOURNEY</strong></div><div class="data-row"><span>Measurement</span><span>Organic enquiries matter more than a screenshot of rankings alone.</span><strong>OUTCOME</strong></div></div></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">WHAT THE DATA SAYS</span><div><h2>Organic was a real<br/>acquisition channel.</h2><p class="statement">The 2025 project file records organic enquiries every month — 2,011 across the full year.</p><p>January–February 2026 added another 225 organic enquiries before the partnership ended. We deliberately frame this case around measured enquiries rather than claiming continuous ranking growth where the project data does not prove it.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">THE SYSTEM</span><h2>QUESTION → ANSWER → TRUST → ENQUIRY.</h2><div class="flow"><span>PATIENT SEARCH</span><b>→</b><span>SERVICE / CONTENT PAGE</span><b>→</b><span>CLINIC</span><b>→</b><span>ENQUIRY</span></div></div></section>
</ConsiliumCaseLayout>
<style>.organic{padding:130px 0;background:#e8e7e1}.big{font-size:clamp(130px,25vw,360px);line-height:.8;letter-spacing:-.09em;margin:75px 0}.months{height:220px;display:grid;grid-template-columns:repeat(12,1fr);gap:7px;align-items:end;border-bottom:1px solid #999}.months>div{height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:7px}.months span{font:9px monospace}.months strong{font-size:14px}.months i{display:block;width:100%;background:var(--accent);max-height:150px}@media(max-width:800px){.organic{padding:90px 0}.months{gap:3px}.months strong{font-size:10px}.months span{font-size:7px}}</style>