import ConsiliumCaseLayout from '../../../layouts/ConsiliumCaseLayout.astro';
---
<ConsiliumCaseLayout title="Consilium Medicum search campaigns" description="How segmented Google Search campaigns captured high-intent medical demand for Consilium Medicum." eyebrow="SEARCH CAMPAIGNS" headline="Not every search" accent="means the same thing." intro="We segmented search demand so campaigns could respond to what a patient was actually looking for instead of treating every medical query as interchangeable." metrics={[{value:'3,356',label:'total Google Ads conversions in 2024'},{value:'€3.25',label:'average cost / conversion'},{value:'€0.20',label:'average CPC'},{value:'6.59–17.78%',label:'CTR range'}]}>
<section class="case-section shell"><div class="two"><span class="eyebrow">THE IDEA</span><div><h2>Start with patient intent,<br/>not keywords.</h2><p class="statement">A person looking for a specialist is in a different moment from someone researching a broad health topic.</p><p>Search queries were segmented so the clinic could show more relevant advertising to people with genuine medical-service intent. That gave us a cleaner structure for ads, landing pages and optimisation.</p></div></div></section>
<section class="intent"><div class="shell"><span class="eyebrow">PATIENT SEARCH / SIMPLIFIED VIEW</span><h2>Query → intent → relevant route.</h2><div class="intent-grid"><div><small>01 / NEED</small><strong>“medical specialist Riga”</strong><p>High-intent patient looking for care.</p></div><b>→</b><div><small>02 / CAMPAIGN</small><strong>Relevant search group</strong><p>Query is routed into a focused campaign structure.</p></div><b>→</b><div><small>03 / RESPONSE</small><strong>Relevant ad + page</strong><p>The message and destination match the need.</p></div><b>→</b><div><small>04 / ACTION</small><strong>Call or enquiry</strong><p>Patient response becomes a tracked conversion.</p></div></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">WHY SEGMENTATION MATTERS</span><h2>Less generic traffic.<br/>More useful intent.</h2><div class="data-list"><div class="data-row"><span>Search query</span><span>Understand what the patient is trying to solve</span><strong>INTENT</strong></div><div class="data-row"><span>Campaign group</span><span>Keep related demand together</span><strong>STRUCTURE</strong></div><div class="data-row"><span>Ad</span><span>Respond with a relevant, compliant message</span><strong>MATCH</strong></div><div class="data-row"><span>Conversion</span><span>Optimise around calls and enquiries, not clicks</span><strong>OUTCOME</strong></div></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">RESULT</span><div><h2>Search became<br/>an acquisition system.</h2><p class="statement">Across the 2024 Google Ads account, Consilium Medicum recorded 3,356 tracked conversions at an average €3.25 per conversion.</p><p>The historical reporting combines Search and Performance Max activity, so we do not attribute the full account result to Search alone. This case shows the search-campaign logic inside the wider system.</p></div></div></section>
</ConsiliumCaseLayout>
