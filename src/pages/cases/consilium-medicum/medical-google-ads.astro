import ConsiliumCaseLayout from '../../../layouts/ConsiliumCaseLayout.astro';
---
<ConsiliumCaseLayout title="Consilium Medicum medical Google Ads case" description="How RM CREATIVES managed Google Ads for a medical clinic through healthcare advertising restrictions, disapprovals and interruptions." eyebrow="MEDICAL GOOGLE ADS" headline="When Google says" accent="no." intro="Medical advertising is not ordinary search advertising. Campaigns can be limited, ads can be rejected and a working acquisition channel can suddenly stop. The job is to keep the system operational without promising what healthcare advertising rules do not allow." metrics={[{value:'HEALTH',label:'restricted advertising category'},{value:'24/7',label:'approval status matters continuously'},{value:'2024–26',label:'operational experience in the project'}]}>
<section class="case-section shell"><div class="two"><span class="eyebrow">THE PROBLEM</span><div><h2>A good campaign can<br/>stop being a campaign.</h2><p class="statement">In healthcare, performance is only useful while the ads are actually allowed to run.</p><p>Restrictions can affect ad copy, targeting, individual services and landing pages. A rejected asset or policy issue is therefore not just a platform notification — it can interrupt patient acquisition.</p></div></div></section>
<section class="blocks"><div class="shell"><span class="eyebrow">WHAT THE TEAM DEALS WITH</span><div class="blockgrid"><div><small>STATUS</small><strong>DISAPPROVED</strong><p>An ad or asset is rejected and stops serving.</p></div><div><small>STATUS</small><strong>LIMITED</strong><p>Healthcare policy reduces what can be communicated or targeted.</p></div><div><small>STATUS</small><strong>LANDING PAGE</strong><p>The destination itself can become part of the approval problem.</p></div><div class="blue"><small>RM RESPONSE</small><strong>KEEP DEMAND FLOWING</strong><p>Diagnose → adapt → resubmit → monitor → redistribute.</p></div></div></div></section>
<section class="case-section dark"><div class="shell two"><span class="eyebrow">OPERATING LOOP</span><div><h2>Not “launch and forget.”</h2><div class="data-list"><div class="data-row"><span>01 / Diagnose</span><span>Understand whether the restriction sits in the ad, targeting, service category or destination.</span><strong>CHECK</strong></div><div class="data-row"><span>02 / Adapt</span><span>Rewrite claims, adjust structure or change the route to a compliant landing page.</span><strong>CHANGE</strong></div><div class="data-row"><span>03 / Resubmit</span><span>Return assets to review and restore eligible coverage.</span><strong>REVIEW</strong></div><div class="data-row"><span>04 / Protect demand</span><span>Avoid depending on one fragile ad or campaign; maintain enough structure to keep acquisition working.</span><strong>RUN</strong></div><div class="data-row"><span>05 / Monitor</span><span>Approval is an operating condition, not a one-time launch checklist.</span><strong>REPEAT</strong></div></div></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">THE PRINCIPLE</span><h2>Compliance is part<br/>of performance.</h2><div class="flow"><span>POLICY</span><b>+</b><span>PATIENT INTENT</span><b>+</b><span>LANDING PAGE</span><b>+</b><span>MEASUREMENT</span><b>=</b><span>WORKING ACQUISITION</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">WHY THIS IS A SEPARATE CASE</span><div><h2>€3.25 CPA tells only<br/>half the story.</h2><p class="statement">The performance case shows what Google Ads produced. This case shows the operational work required to keep a medical advertiser producing it.</p><p>That distinction matters for clinics: the cheapest campaign in a spreadsheet is worthless if it cannot reliably stay live.</p></div></div></section>
</ConsiliumCaseLayout>
