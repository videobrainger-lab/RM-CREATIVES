:1px solid var(--line);padding:22px;display:flex;flex-direction:column}.related article:nth-child(1){background:var(--accent)}.related h3{font-size:25px;line-height:1.05;letter-spacing:-.04em;margin:50px 0 16px}.related p{font-size:13px;line-height:1.5;color:var(--muted)}.soon{margin-top:auto;border-top:1px solid currentColor;padding-top:12px}.cta{padding:150px 0 180px;border-top:1px solid var(--line)}.cta h2{font-size:clamp(60px,9vw,140px);line-height:.86;letter-spacing:-.07em;margin:40px 0 70px}.cta a{font-size:20px;border-bottom:1px solid var(--ink);padding-bottom:6px}@media(max-width:800px){.hero{padding-top:30px}.hero h1{margin:65px 0 50px}.intro,.story,.split,.seo-head,.crm-grid,.related-head{grid-template-columns:1fr}.intro{gap:35px}.tags{text-align:left}.metric-grid{grid-template-columns:1fr 1fr}.metric-grid>div{min-height:210px}.story,.channel,.website,.crm,.conclusion,.related{padding-top:90px;padding-bottom:90px}.story{gap:35px}.content-proof{grid-template-columns:1fr}.related-grid{grid-template-columns:1fr}.related article{min-height:250px}.top span:last-child{display:none}}
