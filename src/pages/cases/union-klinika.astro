---
import BaseLayout from '../../layouts/BaseLayout.astro';
const stories=[
 {href:'/cases/union-klinika/meta-ads',num:'01',title:'Meta Ads',copy:'1,021 tracked enquiries from May–December 2024 at €2.75 weighted media CPL.'},
 {href:'/cases/union-klinika/google-ads',num:'02',title:'Google Ads',copy:'Search architecture and bilingual medical advertising built to capture existing demand.'},
 {href:'/cases/union-klinika/website',num:'03',title:'Website',copy:'A new bilingual clinic website: services, doctors, content and appointment path in one system.'}
];
---
<BaseLayout title="Union Klinika — full-stack clinic growth case | RM CREATIVES" description="Website, Meta Ads and Google Ads for Union Klinika in Riga.">
<main><section class="hero shell"><div class="crumb eyebrow"><a href="/cases">CASES</a><span> / UNION KLINIKA</span></div><div class="hero-grid"><div><span class="eyebrow">MEDICAL CLINIC / RIGA</span><h1>Build the clinic's<br/><em>digital system.</em></h1></div><div class="intro"><p>Union Klinika needed more than isolated campaigns. We worked across patient acquisition and the website — connecting paid demand with a clearer digital destination.</p><span class="eyebrow">META / GOOGLE / WEBSITE</span></div></div><div class="metrics"><div><strong>1,021</strong><span>Meta enquiries · May–Dec 2024</span></div><div><strong>€2.75</strong><span>weighted Meta media CPL</span></div><div><strong>2</strong><span>website languages</span></div><div><strong>3</strong><span>connected workstreams</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">THE PARTNERSHIP</span><div><h2>Acquisition needs<br/>somewhere good<br/>to arrive.</h2><p class="statement">Ads create attention. Search captures intent. The website turns both into a patient journey.</p><p>Our work covered Meta acquisition, Google Search and a rebuilt clinic website. The common objective was simple: make it easier for a person to understand the clinic, find the right service and take the next step.</p></div></div></section>
<section class="stories"><div class="shell"><span class="eyebrow">THREE STORIES / ONE CLIENT</span><div class="story-grid">{stories.map(s=><a href={s.href}><span>{s.num}</span><h2>{s.title}</h2><p>{s.copy}</p><b>OPEN CASE ↗</b></a>)}</div></div></section>
<section class="case-section accent"><div class="shell"><span class="eyebrow">THE SYSTEM</span><h2>Demand → destination<br/>→ patient action.</h2><div class="flow"><span>META ADS</span><b>+</b><span>GOOGLE SEARCH</span><b>→</b><span>UNIONKLINIKA.LV</span><b>→</b><span>SERVICE / DOCTOR</span><b>→</b><span>APPOINTMENT ENQUIRY</span></div></div></section>
</main></BaseLayout>
<style>
main{overflow:hidden}.hero{padding:38px 0 120px}.crumb{padding-bottom:16px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.5fr .55fr;gap:80px;padding:90px 0 80px;align-items:end}.hero h1{font-size:clamp(62px,8.4vw,130px);line-height:.86;letter-spacing:-.07em;margin:20px 0 0}.hero h1 em{font-style:normal;color:var(--accent)}.intro p{font-size:17px;line-height:1.55;color:var(--muted);margin-bottom:35px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line)}.metrics div{padding:30px 20px;border-right:1px solid var(--line)}.metrics div:last-child{border:0}.metrics strong{display:block;font-size:clamp(38px,5vw,70px);letter-spacing:-.06em}.metrics span{font-size:11px;color:var(--muted)}.case-section{padding:130px 0}.two{display:grid;grid-template-columns:.5fr 1.3fr;gap:80px}.two h2{font-size:clamp(48px,6.5vw,94px);line-height:.92;letter-spacing:-.06em;margin:0 0 35px}.two p{max-width:700px;font-size:16px;line-height:1.6;color:var(--muted)}.statement{font-size:24px!important;color:var(--ink)!important}.stories{background:var(--dark);color:var(--white);padding:120px 0}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:55px}.story-grid a{border:1px solid #333;color:inherit;min-height:420px;padding:25px;display:flex;flex-direction:column}.story-grid span{font:11px monospace}.story-grid h2{font-size:46px;letter-spacing:-.05em;margin:60px 0 15px}.story-grid p{color:#999;line-height:1.5}.story-grid b{font:10px monospace;margin-top:auto}.accent{background:var(--accent)}.accent h2{font-size:clamp(55px,7vw,105px);line-height:.9;letter-spacing:-.065em}.flow{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:65px;font:10px monospace}.flow span{border:1px solid #111;padding:12px}@media(max-width:800px){.hero-grid,.two{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.story-grid{grid-template-columns:1fr}.case-section{padding:90px 0}}
</style>