---
import UnionCaseLayout from '../../../layouts/UnionCaseLayout.astro';
---
<UnionCaseLayout title="Union Klinika — website" description="A new bilingual website for Union Klinika in Riga, built by RM CREATIVES." eyebrow="WEBSITE" headline="A clinic website" accent="built for patients." intro="We rebuilt Union Klinika's website around the things a patient actually needs: services, doctors, trust, useful information and a clear path to appointment." metrics={[{value:'NEW',label:'website rebuild'},{value:'2',label:'languages · LV / RU'},{value:'1',label:'clear appointment path'},{value:'RM',label:'design + build'}]}>
<section class="case-section shell"><div class="two"><span class="eyebrow">THE BRIEF</span><div><h2>Maximum clarity.<br/>Without an<br/>oversized build.</h2><p class="statement">The goal was to improve patient interaction while working within a limited website budget.</p><p>We reworked the structure, navigation and presentation of services and doctors, simplified the route to appointment and built the site in two languages. The result is not a brochure detached from marketing — it is the destination for acquisition.</p></div></div></section>
<section class="showcase"><div class="shell"><div class="show-head"><span class="eyebrow">LIVE WEBSITE / UNIONKLINIKA.LV</span><h2>What patients<br/>actually see.</h2></div><div class="browser"><div class="browser-top"><span>● ● ●</span><b>unionklinika.lv</b><a href="https://unionklinika.lv/" target="_blank" rel="noopener">OPEN LIVE ↗</a></div><div class="site-preview"><div class="copy"><span>PROFILAKTISKĀS MEDICĪNAS KLĪNIKA</span><h3>Mēs rūpējamies<br/>par jūsu imunitāti!</h3><p>Doctors, services and appointment action are visible inside one patient-facing system.</p><a href="https://unionklinika.lv/" target="_blank" rel="noopener">PIERAKSTĪTIES UZ VIZĪTI</a></div><img src="https://unionklinika.lv/wp-content/uploads/2024/10/main-img-1.jpg.webp" alt="Union Klinika website visual" loading="lazy"/></div></div><p class="caption">Live-site visual and content shown from Union Klinika. The current site footer credits RM CREATIVES as the website creator.</p></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">THE STRUCTURE</span><div><h2>From question<br/>to appointment.</h2><div class="rows"><div class="row"><span>01</span><span>Understand the clinic</span><strong>POSITIONING</strong></div><div class="row"><span>02</span><span>Choose service or doctor</span><strong>NAVIGATION</strong></div><div class="row"><span>03</span><span>Build trust through expertise and content</span><strong>PROOF</strong></div><div class="row"><span>04</span><span>Take the next step</span><strong>APPOINTMENT</strong></div></div></div></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">THE RESULT</span><h2>Not a redesign.<br/>A better destination.</h2><div class="flow"><span>ADS / SEARCH</span><b>→</b><span>SERVICE</span><b>→</b><span>DOCTOR</span><b>→</b><span>TRUST</span><b>→</b><span>APPOINTMENT</span></div></div></section>
<style>
.showcase{padding:130px 0;background:#e5e4de}.show-head{display:grid;grid-template-columns:.5fr 1.3fr;gap:80px;margin-bottom:60px}.show-head h2{font-size:clamp(52px,7vw,100px);line-height:.9;letter-spacing:-.065em;margin:0}.browser{background:#f8f8f4;border:1px solid #bbb;box-shadow:0 30px 70px rgba(0,0,0,.1)}.browser-top{display:grid;grid-template-columns:1fr 1fr 1fr;padding:16px 20px;border-bottom:1px solid #ccc;font:10px monospace}.browser-top b{text-align:center}.browser-top a{text-align:right;color:inherit}.site-preview{display:grid;grid-template-columns:1.1fr .9fr;min-height:650px;padding:55px;gap:40px;align-items:center;background:#fff}.site-preview .copy>span{font:10px monospace}.site-preview h3{font-size:clamp(48px,6vw,90px);line-height:.92;letter-spacing:-.06em;margin:25px 0}.site-preview p{max-width:480px;color:#777;line-height:1.5}.site-preview .copy>a{display:inline-block;margin-top:25px;background:#151515;color:#fff;padding:15px 18px;font:10px monospace}.site-preview img{width:100%;height:560px;object-fit:cover;border-radius:70px}.caption{font-size:11px;color:#777;margin-top:15px}@media(max-width:800px){.show-head,.site-preview{grid-template-columns:1fr}.site-preview{padding:25px;min-height:0}.site-preview img{height:420px}.browser-top{grid-template-columns:1fr 1fr}.browser-top b{display:none}}
</style>
</UnionCaseLayout>