---
import EpilineCaseLayout from '../../../layouts/EpilineCaseLayout.astro';
const caseVisuals=[
 {src:'https://thb.tildacdn.com/tild6638-6230-4230-a338-623135346436/Slide_16_9_-_84-min.jpg',label:'PROJECT / WEBSITE PRESENTATION',n:'01'},
 {src:'https://thb.tildacdn.com/tild3766-3966-4436-b063-636165333366/Slide_16_9_-_90-min.jpg',label:'UX/UI / WEBSITE SYSTEM',n:'02'},
 {src:'https://thb.tildacdn.com/tild3564-3966-4431-a331-616633393137/Slide_16_9_-_97-min.jpg',label:'BRAND / DIGITAL EXPERIENCE',n:'03'},
 {src:'https://thb.tildacdn.com/tild3031-3738-4662-a135-346339336335/Slide_16_9_-_98-min.jpg',label:'RESPONSIVE / PAGE SYSTEM',n:'04'}
];
---
<EpilineCaseLayout title="Epiline website case" description="A complete bilingual website rebuild for Epiline in Riga and Jurmala." eyebrow="WEBSITE / CONVERSION / SEO" headline="We threw the old" accent="website away." intro="In 2025 we stopped patching the old website and built a new Epiline platform from scratch — without treating SEO, booking and conversion as separate projects." metrics={[{value:'2025',label:'new website launched'},{value:'44',label:'pages including both languages'},{value:'2',label:'languages · Latvian + Russian'},{value:'4 mo.',label:'project delivery'}]}>
<section class="case-section shell"><div class="two"><span class="eyebrow">THE DECISION</span><div><h2>Starting again<br/>was cleaner.</h2><p class="statement">The old site was not redesigned. It was replaced.</p><p>The previous website was slow, technically problematic and difficult to use. We rebuilt the experience around treatment discovery, trust, search visibility and a clear path to booking.</p></div></div></section>

<section class="showcase"><div class="shell"><div class="showcase-head"><span class="eyebrow">EPILINE.LV / PROJECT VISUALS</span><h2>Not a template.<br/>A complete system.</h2><p>Original presentation visuals from the Epiline website project. The redesign covered interface, page architecture, conversion paths and responsive behaviour.</p></div><figure class="hero-shot"><img src={caseVisuals[0].src} alt="Epiline website project presentation" loading="eager" /><figcaption><span>01 / ORIGINAL PROJECT PRESENTATION</span><span>EPILINE BEAUTY STUDIO</span></figcaption></figure><div class="visual-grid">{caseVisuals.slice(1).map(v=><figure><img src={v.src} alt={v.label} loading="lazy" /><figcaption><span>{v.n}</span><span>{v.label}</span></figcaption></figure>)}</div></div></section>

<section class="case-section accent"><div class="shell"><span class="eyebrow">THE ARCHITECTURE</span><h2>22 pages.<br/>44 with translation.</h2><p class="architecture-copy">Every page was rethought around usability, conversion and search. The structure expanded to 22 pages — 44 when Latvian and Russian versions are counted.</p><div class="flow"><span>PAID TRAFFIC</span><b>→</b><span>SERVICE PAGES</span><b>→</b><span>CONTENT / SEO</span><b>→</b><span>ONLINE BOOKING</span><b>→</b><span>CRM</span></div><div class="data-list"><div class="data-row"><span>Languages</span><span>Local patient journeys</span><strong>LV + RU</strong></div><div class="data-row"><span>Commercial structure</span><span>Treatment-focused landing pages</span><strong>CONVERSION</strong></div><div class="data-row"><span>Editorial structure</span><span>Search-led content</span><strong>SEO</strong></div><div class="data-row"><span>Booking</span><span>Connected to operations</span><strong>ALTEGIO</strong></div></div></div></section>

<section class="page-system shell"><div class="system-head"><span class="eyebrow">ONE BRAND / MANY ENTRY POINTS</span><h2>Commercial pages.<br/>Editorial pages.<br/>One patient journey.</h2></div><div class="system-grid"><div class="system-card"><span class="eyebrow">SERVICE / LV</span><h3>Lāzerepilācija</h3><p>Commercial treatment architecture built for high-intent traffic and booking.</p><a href="https://epiline.lv/laser-epilation/">OPEN PAGE ↗</a></div><div class="system-card darkcard"><span class="eyebrow">SERVICE / LV</span><h3>Morpheus 8</h3><p>A treatment page that connects search intent, education and conversion.</p><a href="https://epiline.lv/kosmetologija/morpheus-8/">OPEN PAGE ↗</a></div><div class="system-card bluecard"><span class="eyebrow">CONTENT / SEO</span><h3>Endospheres</h3><p>Search-led editorial content brings patients into the website before they choose a clinic.</p><a href="https://epiline.lv/endosfera-5-biezak-uzdotie-jautajumi-par-proceduru/">OPEN CONTENT ↗</a></div></div></section>

<section class="case-section shell"><div class="two"><span class="eyebrow">SEO MIGRATION</span><div><h2>New website.<br/>Not zero visibility.</h2><p>An established domain carries years of accumulated search equity. Before launch, the existing pages and queries were audited and a redirect map was prepared for old URLs.</p><p>SEO was part of the rebuild from the start: metadata, headings, content structure, canonical URLs and redirects were handled as part of the migration rather than after it.</p><p class="statement mini">The site retained TOP-5 visibility for core searches after the migration.</p><a class="back" href="https://epiline.lv/">Visit Epiline.lv ↗</a></div></div></section>
<section class="case-section dark"><div class="shell two"><span class="eyebrow">THE RESULT</span><div><h2>The website became<br/>infrastructure.</h2><p class="statement">Paid traffic, organic search, content and booking now meet in one platform.</p><p>The rebuild took four months and involved marketing, UX/UI, development, technical implementation, content and SEO — one coordinated project rather than a cosmetic redesign.</p></div></div></section>
</EpilineCaseLayout>
<style>
.showcase{background:#d9d8d1;padding:130px 0}.showcase-head{display:grid;grid-template-columns:.55fr 1.25fr .6fr;gap:50px;align-items:start;margin-bottom:70px}.showcase-head h2,.system-head h2{font-size:clamp(48px,6vw,92px);line-height:.92;letter-spacing:-.06em;margin:0;font-weight:600}.showcase-head p{font-size:14px;line-height:1.5;margin:0;color:var(--muted)}figure{margin:0}.hero-shot{background:#101010;padding:10px}.hero-shot img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover}.hero-shot figcaption,.visual-grid figcaption{display:flex;justify-content:space-between;font-family:monospace;font-size:9px;letter-spacing:.06em;padding:12px 2px 3px;color:#777}.hero-shot figcaption{color:#aaa}.visual-grid{display:grid;grid-template-columns:1.35fr .85fr .85fr;gap:10px;margin-top:55px;align-items:start}.visual-grid figure{background:#f2f1ec;padding:8px}.visual-grid img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover}.visual-grid figure:nth-child(2){margin-top:80px}.visual-grid figure:nth-child(3){margin-top:25px}.architecture-copy{font-size:18px;line-height:1.55;max-width:720px;margin:30px 0 0}.page-system{padding:140px 0}.system-head{display:grid;grid-template-columns:.55fr 1.45fr;gap:70px;margin-bottom:75px}.system-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.system-card{min-height:390px;border:1px solid var(--line);padding:25px;display:flex;flex-direction:column}.system-card h3{font-size:clamp(35px,4vw,58px);line-height:.95;letter-spacing:-.055em;margin:90px 0 20px}.system-card p{font-size:14px;line-height:1.5;color:var(--muted);max-width:300px}.system-card a{margin-top:auto;padding-top:16px;border-top:1px solid currentColor;font-family:monospace;font-size:10px}.darkcard{background:var(--dark);color:var(--white);border-color:var(--dark)}.darkcard p{color:#888}.bluecard{background:var(--accent);border-color:var(--accent)}.mini{font-size:clamp(28px,3vw,46px)!important;margin-top:55px!important}@media(max-width:800px){.showcase{padding:90px 0}.showcase-head,.system-head{grid-template-columns:1fr}.visual-grid,.system-grid{grid-template-columns:1fr}.visual-grid figure:nth-child(2),.visual-grid figure:nth-child(3){margin-top:0}.system-card{min-height:320px}}
</style>