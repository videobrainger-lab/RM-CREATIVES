lumn:1/-1}.calendar{display:flex;flex-direction:column;align-items:center;border-right:1px solid #ddd}.calendar span,.calendar small{font:10px monospace}.calendar strong{font-size:58px;line-height:1;margin:8px}.booking-copy{padding-left:25px;display:flex;flex-direction:column;gap:8px}.booking-copy strong{font-size:22px}.booking-copy span{font-size:12px;color:#777}.booking-copy button{border:0;background:var(--accent);color:white;padding:13px;margin-top:15px;font:10px monospace}.life{display:flex;align-items:center;justify-content:space-between;gap:7px;font:9px monospace;overflow:auto}.life span{border:1px solid #bbb;padding:10px;white-space:nowrap}.life .active{background:var(--accent);color:white;border-color:var(--accent)}.next{margin-top:35px;border-top:1px solid #ddd;padding-top:20px;display:flex;flex-direction:column;gap:7px}.next small{font:9px monospace}.next strong{font-size:18px}.next span{font-size:11px;color:#777}@media(max-width:850px){.journey{padding:90px 0}.journey-head,.step{grid-template-columns:1fr}.step{gap:20px}.num{margin-bottom:10px}.phone{max-width:none}.booking{grid-template-columns:1fr}.booking .ui-top{grid-column:auto}.calendar{border-right:0;border-bottom:1px solid #ddd;padding-bottom:20px}.booking-copy{padding:20px 0 0}.life{justify-content:flex-start}}
