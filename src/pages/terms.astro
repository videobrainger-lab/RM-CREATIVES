---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms of Use | RM CREATIVES" description="Terms governing use of the RM CREATIVES website.">
  <main class="legal shell">
    <div class="eyebrow">LEGAL / TERMS</div>
    <h1>Terms of Use</h1>
    <div class="copy">
      <p>By using rmcreatives.com you agree to these terms. Website materials are provided for general information about RM CREATIVES and its services.</p>
      <h2>Website content</h2>
      <p>We aim to keep information accurate and current, but do not guarantee that every page will always be complete, error-free or suitable for a specific purpose.</p>
      <h2>Intellectual property</h2>
      <p>Unless stated otherwise, website copy, design, graphics and other original materials belong to RM CREATIVES or are used with permission and may not be reproduced commercially without consent.</p>
      <h2>External services</h2>
      <p>The website may link to third-party services. RM CREATIVES is not responsible for the content, availability or privacy practices of third-party websites.</p>
      <h2>Contact</h2>
      <p>RM CREATIVES, SIA<br/>Šarlotes iela 18A - 3, Rīga, LV-1001<br/><a href="mailto:clientcare@rmcreatives.com">clientcare@rmcreatives.com</a></p>
      <p class="note">Last updated: September 2026.</p>
    </div>
  </main>
</BaseLayout>
<style>
  .legal{padding:90px 0 140px}.legal h1{font-size:clamp(58px,9vw,130px);letter-spacing:-.07em;line-height:.9;margin:24px 0 90px;font-weight:600}.copy{max-width:780px;margin-left:auto}.copy h2{font-size:26px;letter-spacing:-.035em;margin:48px 0 14px}.copy p{font-size:16px;line-height:1.65;color:#444;margin:0}.copy a{border-bottom:1px solid currentColor}.note{margin-top:60px!important;color:var(--muted)!important;font-size:13px!important}
</style>
