---
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  { n:'01', name:'RM Performance', meta:'META ADS / ОБРАЩЕНИЯ ПАЦИЕНТОВ', title:'Оплата за обращения.\nНе за ведение.', text:'До запуска фиксируем коммерческую модель. Стратегия, креативы, тесты и оптимизация — на нашей стороне.', href:'/performance' },
  { n:'02', name:'RM Search', meta:'GOOGLE ADS / ГОТОВЫЙ СПРОС', title:'Забираем спрос,\nкоторый уже существует.', text:'Пациенты уже ищут клиники, врачей и процедуры в Google. Наша задача — привести их к вам раньше конкурентов.', href:'/search' },
  { n:'03', name:'RM Sites', meta:'WEB / CONVERSION / SEO', title:'Сайт клиники.\nЗапуск за 1 день.', text:'Быстрые, адаптивные и SEO-ready сайты без WordPress и месяцев разработки.', href:'/sites' }
];
---
<BaseLayout lang="ru" title="RM CREATIVES — Привлечение пациентов для клиник" description="Meta Ads, Google Ads и конверсионные сайты для медицинских и beauty-клиник.">
  <main>
    <section class="hero shell">
      <div class="hero-top eyebrow"><span>МЕДИЦИНА & BEAUTY</span><span>ЕВРОПА / 2026</span></div>
      <h1>Привлечение пациентов<br/>для клиник.</h1>
      <div class="hero-bottom">
        <p>Meta Ads, Google Ads и сайты для медицинских и beauty-клиник.</p>
        <div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Обсудить проект ↗</a><a class="button secondary" href="#cases">Смотреть кейсы ↓</a></div>
      </div>
    </section>

    <section class="signal"><div class="shell signal-inner eyebrow"><span>РИГА / ЕВРОПА</span><span>МЕДИЦИНА</span><span>СТОМАТОЛОГИЯ</span><span>ЭСТЕТИКА</span><span>BEAUTY</span></div></section>

    <section class="services shell" id="services">
      <div class="section-head"><span class="eyebrow">ЧТО МЫ ДЕЛАЕМ</span><h2>Три продукта.<br/>Одна задача.</h2><p>Больше целевых обращений пациентов. Меньше маркетингового шума.</p></div>
      <div class="service-list">{services.map((service)=>(<a class="service-card" href={service.href}><div class="eyebrow">{service.n} / 03</div><div><div class="eyebrow muted">{service.meta}</div><h3>{service.name}</h3></div><div class="service-copy"><h4>{service.title.split('\n').map((line)=><>{line}<br/></>)}</h4><p>{service.text}</p></div><div class="arrow">↗</div></a>))}</div>
    </section>

    <section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>обращений пациентов</span></div><div><strong>5+</strong><span>лет в healthcare</span></div><div><strong>EU</strong><span>рынки</span></div><div><strong>3</strong><span>продукта</span></div></div></section>

    <section class="cases shell" id="cases"><div class="section-head"><span class="eyebrow">КЕЙСЫ</span><h2>Результаты вместо обещаний.</h2><a href="/cases">Все кейсы ↗</a></div></section>

    <section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">ПОЧЕМУ RM</span><h2>Работаем с клиниками.<br/>Считаем результат.</h2><div><p>Мы не продаём длинный список маркетинговых услуг. Мы строим систему привлечения пациентов вокруг трёх направлений, в которых можем отвечать за результат.</p><p class="muted">Meta — создаёт спрос. Google — забирает готовый спрос. Сайт — конвертирует его в обращение.</p></div></div></section>

    <section class="cta shell"><span class="eyebrow">НАЧАТЬ ПРОЕКТ</span><h2>Нужно больше<br/>обращений?</h2><a href="mailto:hello@rmcreatives.com">Поговорим ↗</a></section>
  </main>
</BaseLayout>

<style>
  .hero{min-height:760px;display:flex;flex-direction:column;justify-content:space-between;padding:42px 0 54px}.hero-top{display:flex;justify-content:space-between}.hero h1{margin:0;font-size:clamp(64px,9.4vw,148px);line-height:.86;letter-spacing:-.07em;font-weight:650;max-width:1350px}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}.hero-bottom p{font-size:clamp(20px,2vw,31px);line-height:1.2;letter-spacing:-.035em;max-width:680px;margin:0}.hero-actions{display:flex;gap:10px;justify-content:flex-end}.button{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:650}.primary{background:var(--ink);color:var(--white)}.secondary{border:1px solid var(--line)}
  .signal{background:var(--accent);border-top:1px solid #a8d500;border-bottom:1px solid #a8d500}.signal-inner{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:20px}
  .services{padding:150px 0 120px}.section-head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:30px;margin-bottom:80px}.section-head h2,.about h2{font-size:clamp(42px,5.2vw,78px);line-height:.98;letter-spacing:-.055em;margin:-9px 0 0;font-weight:600}.section-head p{margin:0;color:var(--muted);line-height:1.45}.service-list{border-top:1px solid var(--line)}.service-card{min-height:290px;display:grid;grid-template-columns:.6fr 1fr 1.5fr 60px;gap:30px;padding:30px 0;border-bottom:1px solid var(--line)}.service-card h3{font-size:26px;letter-spacing:-.04em;margin:16px 0 0}.service-copy h4{font-size:clamp(28px,3vw,48px);line-height:1;letter-spacing:-.05em;margin:0;font-weight:550}.service-copy p{max-width:500px;color:var(--muted);line-height:1.5;margin:28px 0 0}.arrow{font-size:28px;justify-self:end}
  .numbers{background:var(--dark);color:var(--white)}.numbers-grid{display:grid;grid-template-columns:repeat(4,1fr);min-height:315px}.numbers-grid>div{padding:42px 28px 32px 0;border-right:1px solid #2d2d2d;display:flex;flex-direction:column;justify-content:space-between}.numbers-grid>div:not(:first-child){padding-left:28px}.numbers strong{font-size:clamp(46px,5vw,78px);letter-spacing:-.055em;font-weight:550}.numbers span{color:#888;font-size:13px}
  .cases{padding:150px 0 80px}.cases .section-head a{font-size:13px;border-bottom:1px solid var(--ink);justify-self:start;padding-bottom:3px}.about{background:var(--dark);color:var(--white);padding:150px 0}.about-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:30px}.about-grid p{line-height:1.5;font-size:18px;margin:0 0 26px}.about .muted{color:#8b8b8b}.cta{padding:160px 0 70px;min-height:670px;display:flex;flex-direction:column}.cta h2{margin:auto 0 34px;font-size:clamp(66px,9vw,145px);line-height:.86;letter-spacing:-.07em;font-weight:600}.cta a{font-size:18px;border-bottom:1px solid var(--ink);align-self:flex-start;padding-bottom:5px}
  @media(max-width:900px){.hero-bottom,.section-head,.about-grid{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.service-card{grid-template-columns:50px 1fr 35px}.service-copy{grid-column:2/4}.numbers-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.hero{min-height:620px;padding-top:28px}.hero-top span:last-child{display:none}.hero h1{font-size:clamp(54px,16vw,82px)}.hero-actions{flex-direction:column}.button{width:100%}.numbers-grid{grid-template-columns:1fr}.numbers-grid>div{min-height:170px;padding:28px 0!important}.services,.cases,.about{padding:100px 0}}
</style>
