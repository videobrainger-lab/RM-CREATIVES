---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[
  {n:'01',name:'PERFORMANCE',role:'ПРИВЛЕЧЕНИЕ',meta:'META ADS / ОБРАЩЕНИЯ ПАЦИЕНТОВ',title:'Оплата за обращения. Не за ведение.',text:'До запуска фиксируем коммерческую модель. Стратегия, креативы, тесты и оптимизация — на нашей стороне.',flow:['META','ENQUIRY','+1'],href:'/performance'},
  {n:'02',name:'SEARCH',role:'ГОТОВЫЙ СПРОС',meta:'GOOGLE ADS / ПОИСК',title:'Забираем спрос, который уже существует.',text:'Пациенты уже ищут клиники, врачей и процедуры в Google. Наша задача — привести их к вам раньше конкурентов.',flow:['SEARCH','CLINIC','LEAD'],href:'/search'},
  {n:'03',name:'SITES',role:'КОНВЕРСИЯ',meta:'WEB / CONVERSION / SEO',title:'Сайт клиники. Запуск за 1 день.',text:'Быстрые, адаптивные и SEO-ready сайты без WordPress и месяцев разработки.',flow:['BRIEF','BUILD','LIVE ●'],href:'/sites'}
];
const enquiries=[{type:'СТОМАТОЛОГИЯ',service:'ИМПЛАНТАЦИЯ',status:'НОВОЕ'},{type:'ЭСТЕТИКА',service:'ЛАЗЕРНАЯ ПРОЦЕДУРА',status:'ЦЕЛЕВОЕ'},{type:'МЕДИЦИНА',service:'КОНСУЛЬТАЦИЯ ВРАЧА',status:'НОВОЕ'}];
---
<BaseLayout lang="ru" title="RM CREATIVES — Привлечение пациентов для клиник" description="Meta Ads, Google Ads и конверсионные сайты для медицинских и beauty-клиник.">
<main>
<section class="hero shell"><div class="hero-top eyebrow"><span>ДЛЯ МЕДИЦИНСКИХ И BEAUTY-КЛИНИК</span><span>РИГА / ЕВРОПА</span></div><div class="hero-core"><h1>Привлечение пациентов<br/>для клиник.</h1><aside class="system-panel"><div class="panel-head eyebrow"><span>RM / СИСТЕМА ПРИВЛЕЧЕНИЯ</span><span class="live"><i></i> LIVE</span></div><div class="panel-stat"><span class="eyebrow muted">ПОЛУЧЕНО ОБРАЩЕНИЙ</span><strong>10,000+</strong></div><div class="panel-row"><span class="eyebrow muted">НИШИ</span><b>МЕДИЦИНА / BEAUTY</b></div><div class="panel-row"><span class="eyebrow muted">КАНАЛЫ</span><b>META / GOOGLE / WEB</b></div><div class="feed"><div class="feed-head eyebrow muted"><span>НОВЫЕ ОБРАЩЕНИЯ</span><span>СТАТУС</span></div>{enquiries.map((item,i)=><div class={`feed-row delay-${i}`}><div><b>{item.type}</b><span>{item.service}</span></div><em>{item.status}</em></div>)}</div></aside></div><div class="hero-bottom"><p>Meta Ads, Google Ads и конверсионные сайты исключительно для медицинских и beauty-клиник.</p><div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Обсудить проект ↗</a><a class="button secondary" href="#cases">Смотреть кейсы ↓</a></div></div></section>
<section class="signal"><div class="shell signal-inner eyebrow"><span>МЕДИЦИНА</span><span>СТОМАТОЛОГИЯ</span><span>ЭСТЕТИЧЕСКАЯ МЕДИЦИНА</span><span>BEAUTY</span><span>ОБРАЩЕНИЯ ↑</span></div></section>
<section class="services shell" id="services"><div class="products-head"><div><span class="eyebrow">RM PRODUCTS</span><h2>Три продукта.<br/>Одна система.</h2></div><p>Каждый продукт решает отдельную задачу в привлечении пациента — от спроса до обращения.</p></div><div class="product-grid">{services.map(service=><a class="product-card" href={service.href}><div class="product-top"><span class="eyebrow">RM PRODUCT / {service.n}</span><span class="product-arrow">↗</span></div><div class="product-main"><span class="eyebrow muted">{service.role}</span><h3>{service.name}</h3><p class="product-title">{service.title}</p><p class="product-text">{service.text}</p></div><div class="product-bottom"><span class="eyebrow muted">{service.meta}</span><div class="product-flow">{service.flow.map((step,i)=><><span>{step}</span>{i<service.flow.length-1&&<b>→</b>}</>)}</div></div></a>)}</div></section>
<section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>обращений пациентов</span></div><div><strong>5+</strong><span>лет в healthcare</span></div><div><strong>EU</strong><span>рынки</span></div><div><strong>3</strong><span>продукта</span></div></div></section><section class="cases shell" id="cases"><div class="section-head"><span class="eyebrow">КЕЙСЫ</span><h2>Результаты вместо обещаний.</h2><a href="/cases">Все кейсы ↗</a></div></section><section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">ПОЧЕМУ RM</span><h2>Работаем с клиниками.<br/>Считаем результат.</h2><div><p>Мы не продаём длинный список маркетинговых услуг. Мы строим систему привлечения пациентов вокруг трёх направлений, в которых можем отвечать за результат.</p><p class="muted">Meta — создаёт спрос. Google — забирает готовый спрос. Сайт — конвертирует его в обращение.</p></div></div></section><section class="cta shell"><span class="eyebrow">НАЧАТЬ ПРОЕКТ</span><h2>Нужно больше<br/>обращений?</h2><a href="mailto:hello@rmcreatives.com">Поговорим ↗</a></section>
</main></BaseLayout>
<style>
.hero{min-height:780px;display:flex;flex-direction:column;justify-content:space-between;padding:38px 0 52px}.hero-top{display:flex;justify-content:space-between}.hero-core{display:grid;grid-template-columns:minmax(0,2.25fr) minmax(330px,.75fr);gap:36px;align-items:end}.hero h1{margin:0;font-size:clamp(62px,8.7vw,138px);line-height:.86;letter-spacing:-.07em;font-weight:650}.system-panel{border:1px solid var(--ink);background:rgba(248,248,244,.34);min-height:420px;display:flex;flex-direction:column}.panel-head,.panel-row,.feed-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}.live{display:flex;align-items:center;gap:7px}.live i{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(200,255,26,.18)}.panel-stat{padding:20px 16px 25px;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.panel-stat strong{font-size:clamp(48px,4.4vw,72px);letter-spacing:-.065em;line-height:.9;font-weight:600}.panel-row{font-size:12px}.panel-row b{font-size:11px}.feed{margin-top:auto}.feed-row{min-height:58px;padding:10px 16px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;align-items:center;animation:signalIn .55s both}.feed-row:last-child{border-bottom:0}.feed-row div{display:flex;flex-direction:column;gap:3px}.feed-row b{font-size:11px;letter-spacing:.04em}.feed-row span{font-size:10px;color:var(--muted)}.feed-row em{font-style:normal;font-family:monospace;font-size:9px;border:1px solid var(--line);padding:5px 7px}.delay-1{animation-delay:.18s}.delay-2{animation-delay:.36s}@keyframes signalIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}.hero-bottom p{font-size:clamp(20px,1.8vw,28px);line-height:1.2;letter-spacing:-.035em;max-width:650px;margin:0}.hero-actions{display:flex;gap:10px;justify-content:flex-end}.button{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:650}.primary{background:var(--ink);color:var(--white)}.secondary{border:1px solid var(--line)}.signal{background:var(--accent);border-top:1px solid #a8d500;border-bottom:1px solid #a8d500}.signal-inner{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:20px}.services{padding:145px 0 125px}.products-head{display:grid;grid-template-columns:2fr 1fr;gap:60px;align-items:end;margin-bottom:58px}.products-head h2{font-size:clamp(46px,5.7vw,86px);line-height:.93;letter-spacing:-.06em;font-weight:600;margin:14px 0 0}.products-head p{max-width:420px;margin:0 0 5px;color:var(--muted);font-size:17px;line-height:1.5}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.product-card{min-height:590px;border:1px solid var(--line);padding:22px;display:flex;flex-direction:column;background:rgba(255,255,255,.12);overflow:hidden;transition:background .28s ease,border-color .28s ease,transform .28s ease}.product-card:hover{background:var(--accent);border-color:#a8d500;transform:translateY(-5px)}.product-top{display:flex;align-items:center;justify-content:space-between}.product-arrow{font-size:24px;transition:transform .25s ease}.product-card:hover .product-arrow{transform:translate(4px,-4px)}.product-main{margin-top:70px}.product-main h3{font-size:26px;line-height:1;letter-spacing:-.04em;margin:12px 0 38px;font-weight:700}.product-title{font-size:clamp(25px,2.2vw,36px);line-height:1.04;letter-spacing:-.045em;margin:0;max-width:390px;font-weight:580}.product-text{font-size:14px;line-height:1.5;color:var(--muted);max-width:390px;margin:22px 0 0;transition:color .28s ease}.product-card:hover .product-text,.product-card:hover .muted{color:#272727}.product-bottom{margin-top:auto;border-top:1px solid var(--line);padding-top:18px;display:flex;flex-direction:column;gap:16px}.product-card:hover .product-bottom{border-color:rgba(0,0,0,.22)}.product-flow{display:flex;align-items:center;gap:8px;font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;letter-spacing:.08em}.product-flow span{border:1px solid currentColor;padding:7px 8px;background:rgba(255,255,255,.22)}.product-flow b{font-weight:400}.section-head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:30px;margin-bottom:80px}.section-head h2,.about h2{font-size:clamp(42px,5.2vw,78px);line-height:.98;letter-spacing:-.055em;margin:-9px 0 0;font-weight:600}.section-head p{margin:0;color:var(--muted);line-height:1.45}.numbers{background:var(--dark);color:var(--white)}.numbers-grid{display:grid;grid-template-columns:repeat(4,1fr);min-height:315px}.numbers-grid>div{padding:42px 28px 32px 0;border-right:1px solid #2d2d2d;display:flex;flex-direction:column;justify-content:space-between}.numbers-grid>div:not(:first-child){padding-left:28px}.numbers strong{font-size:clamp(46px,5vw,78px);letter-spacing:-.055em;font-weight:550}.numbers span{color:#888;font-size:13px}.cases{padding:150px 0 80px}.cases .section-head a{font-size:13px;border-bottom:1px solid var(--ink);justify-self:start;padding-bottom:3px}.about{background:var(--dark);color:var(--white);padding:150px 0}.about-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:30px}.about-grid p{line-height:1.5;font-size:18px;margin:0 0 26px}.about .muted{color:#8b8b8b}.cta{padding:160px 0 70px;min-height:670px;display:flex;flex-direction:column}.cta h2{margin:auto 0 34px;font-size:clamp(66px,9vw,145px);line-height:.86;letter-spacing:-.07em;font-weight:600}.cta a{font-size:18px;border-bottom:1px solid var(--ink);align-self:flex-start;padding-bottom:5px}@media(max-width:1050px){.hero-core{grid-template-columns:1fr}.system-panel{min-height:340px}.hero{gap:50px}.hero-bottom,.section-head,.about-grid,.products-head{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.product-grid{grid-template-columns:1fr}.product-card{min-height:430px}.product-main{margin-top:45px}.numbers-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.hero{min-height:0;padding-top:28px;gap:42px}.hero-top span:last-child{display:none}.hero h1{font-size:clamp(52px,15vw,78px)}.system-panel{min-height:330px}.hero-actions{flex-direction:column}.button{width:100%}.signal-inner span:nth-child(n+4){display:none}.numbers-grid{grid-template-columns:1fr}.numbers-grid>div{min-height:170px;padding:28px 0!important}.services,.cases,.about{padding:100px 0}.product-card{min-height:390px;padding:18px}.product-main{margin-top:36px}.product-main h3{font-size:26px}.product-title{font-size:27px}.product-text{font-size:13px}}
</style>