---
import '../../styles/homepage.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[
  {n:'01',name:'RM Performance',meta:'META ADS / ПРИВЛЕЧЕНИЕ',title:"Создаём спрос через Meta Ads.",bullets:["Стратегия и креативы — за специалистом.", "ИИ помогает сравнивать тесты и качество обращений."],href:'/ru/performance',kind:'performance'},
  {n:'02',name:'RM Search',meta:'GOOGLE ADS / ГОТОВЫЙ СПРОС',title:"Привлекаем тех, кто уже ищет услугу.",bullets:["Стратегию и бюджет контролирует специалист.", "ИИ анализирует запросы, расходы и конверсии."],href:'/ru/search',kind:'search'},
  {n:'03',name:'RM Sites',meta:'WEB / КОНВЕРСИЯ / SEO',title:"Превращаем интерес в обращения.",bullets:["Структуру и контент создают специалисты.", "ИИ помогает с исследованиями и проверкой качества."],href:'/ru/sites',kind:'sites'}
];
const cases=[
 {client:'EPILINE',sector:'Эстетическая медицина / Рига · Юрмала',metric:'2,970',label:'Обращения из Meta · янв–авг 2026',tags:'КОМПЛЕКСНОЕ ПРОДВИЖЕНИЕ',href:'/ru/cases/epiline'},
 {client:'CONSILIUM MEDICUM',sector:'Медицинская клиника / Латвия',metric:'3,356',label:'Конверсии Google Ads · 2024',tags:'GOOGLE ADS / SEO / META',href:'/ru/cases/consilium-medicum'},
 {client:'DENTA',sector:'Стоматология / Латвия',metric:'16,227',label:'Отслеженные обращения · 2025',tags:'КОМПЛЕКСНОЕ ПРОДВИЖЕНИЕ / SEO',href:'/ru/cases/denta'},
 {client:'UNION KLINIKA',sector:'Медицинская клиника / Рига',metric:'1,021',label:'Обращения из Meta · май–дек 2024',tags:'САЙТ / META / GOOGLE',href:'/ru/cases/union-klinika'}
];
const enquiries=[{type:'СТОМАТОЛОГИЯ',service:'ИМПЛАНТАЦИЯ',status:'НОВОЕ'},{type:'ЭСТЕТИКА',service:'ЛАЗЕРНАЯ ПРОЦЕДУРА',status:'ЦЕЛЕВОЕ'},{type:'МЕДИЦИНА',service:'КОНСУЛЬТАЦИЯ ВРАЧА',status:'НОВОЕ'}];
---
<BaseLayout lang="ru" title="RM CREATIVES — Привлечение пациентов в клиники" description="Meta Ads, Google Ads и конверсионные сайты для медицинских и эстетических клиник.">
<main class="copy-page home-page">
<section class="hero shell"><div class="hero-top eyebrow"><span>RESULTS MATTER / MEDICAL &amp; AESTHETIC CLINICS</span><span>EUROPE + INTERNATIONAL</span></div><div class="hero-core"><h1>Привлечение пациентов для клиник.</h1><aside class="system-panel"><div class="panel-head eyebrow"><span>RM / СИСТЕМА ПРИВЛЕЧЕНИЯ</span><span class="live"><i></i> LIVE</span></div><div class="panel-stat"><span class="eyebrow muted">ПОЛУЧЕНО ОБРАЩЕНИЙ</span><strong>10,000+</strong></div><div class="panel-row"><span class="eyebrow muted">НИШИ</span><b>МЕДИЦИНА / ЭСТЕТИКА</b></div><div class="panel-row"><span class="eyebrow muted">КАНАЛЫ</span><b>META / GOOGLE / WEB</b></div><div class="feed"><div class="feed-head eyebrow muted"><span>НОВЫЕ ОБРАЩЕНИЯ</span><span>СТАТУС</span></div>{enquiries.map((item,i)=><div class={`feed-row delay-${i}`}><div><b>{item.type}</b><span>{item.service}</span></div><em>{item.status}</em></div>)}</div></aside></div><div class="hero-bottom"><p>Под управлением людей. Усилено ИИ.</p><div class="hero-actions"><a class="button primary" href="mailto:hello@rmcreatives.com">Обсудить систему роста ↗</a><a class="button secondary" href="#cases">Результаты клиник ↓</a></div></div></section>
<section class="signal"><div class="shell signal-inner eyebrow"><span>МЕДИЦИНА</span><span>СТОМАТОЛОГИЯ</span><span>ЭСТЕТИЧЕСКАЯ МЕДИЦИНА</span><span>ЭСТЕТИКА</span><span>ОБРАЩЕНИЯ ↑</span></div></section>
<section class="services shell" id="services"><div class="products-head"><div><span class="eyebrow">НАШИ ПРОДУКТЫ</span><h2>Три продукта. Одна система с ИИ.</h2></div><div class="products-head-copy"><span class="eyebrow">ТРИ ПРОДУКТА. ОДНА СИСТЕМА.</span><p>Создаём спрос, привлекаем пациентов из поиска и превращаем интерес в обращения. Специалисты управляют каналами; ИИ помогает анализировать больше и действовать быстрее.</p></div></div><div class="product-grid">{services.map(service=><a class="product-card" href={service.href}><div class="product-meta"><span>{service.n} / 03</span><span>{service.meta}</span></div><h3>{service.name}</h3><p class="product-title">{service.title}</p><div class={`product-visual ${service.kind}`}>{service.kind==='performance'&&<><div class="social-box">META</div><span>→</span><div class="lead-box"><i></i> ОБРАЩЕНИЕ</div><span>→</span><div class="plus-box">+1</div></>}{service.kind==='search'&&<><div class="search-bar"><b>G</b><span>имплантация зубов</span><em>⌕</em></div><div class="search-flow"><span>КЛИКАЮТ</span><b>→</b><span>ПЕРЕХОДЯТ</span><b>→</b><span>ОСТАВЛЯЮТ ЗАЯВКУ</span></div></>}{service.kind==='sites'&&<div class="browser"><div class="browser-top"><span>● ● ●</span><small>yourclinic.lv</small></div><div class="browser-body"><strong>Современная<br/>клиника</strong><button>Записаться</button><i>↑<br/>БОЛЬШЕ<br/>ЗАЯВОК</i></div></div>}</div><ul>{service.bullets.map(item=><li>{item}</li>)}</ul><div class="product-link"><span>УЗНАТЬ БОЛЬШЕ</span><span>→</span></div></a>)}</div><div class="products-foot eyebrow"><span>РЕАЛЬНЫЕ КЛИНИКИ. РЕАЛЬНЫЕ РЕЗУЛЬТАТЫ.</span><span>СОЗДАНО ДЛЯ КЛИНИК.</span></div></section>
<section class="numbers"><div class="shell numbers-grid"><div><strong>10,000+</strong><span>обращений пациентов</span></div><div><strong>5+</strong><span>лет в медицинском маркетинге</span></div><div><strong>ЕС</strong><span>рынки</span></div><div><strong>3</strong><span>продукта</span></div></div></section><section class="cases shell" id="cases"><div class="section-head horizontal"><div><span class="eyebrow">КЕЙСЫ</span><h2>Результаты вместо обещаний.</h2></div><a href="/ru/cases" class="text-link">Все кейсы ↗</a></div><div class="case-grid">{cases.map(item=><a class="case-card" href={item.href}><div class="case-meta eyebrow"><span>{item.tags}</span><span>↗</span></div><div class="case-space"></div><div class="case-result"><strong>{item.metric}</strong><span>{item.label}</span></div><div class="case-footer"><h3>{item.client}</h3><p>{item.sector}</p></div></a>)}</div></section><section class="about"><div class="shell about-grid"><span class="eyebrow">Человеческое решение. Масштаб ИИ.</span><h2>Больше внимания к каждому решению.</h2><div class="about-copy"><p>Специалист видит канал. ИИ помогает увидеть систему вокруг него.</p><p>GOOGLE ADS — Больше анализа запросов, расходов и конверсий. Меньше потерь бюджета.</p><p>META ADS — Сравниваем больше креативов, аудиторий и сигналов качества лидов. Быстрее учимся.</p><p>SEO / GEO — Анализируем спрос, Search Console, конкурентов и видимость в ИИ вместе.</p></div></div></section><section class="about" id="about"><div class="shell about-grid"><span class="eyebrow">ПОЧЕМУ RM</span><h2>Решения специалистов. Масштаб ИИ.</h2><div class="about-copy"><p>Мы строим единую систему привлечения пациентов вокруг приоритетов клиники. Решения принимают специалисты. ИИ даёт им больше данных и контекста, помогая быстрее находить то, что требует действия.</p></div></div></section><section class="cta shell"><span class="eyebrow">НАЧАТЬ ПРОЕКТ</span><h2>Нужно больше, чем ещё одна рекламная кампания?</h2><p>Давайте посмотрим на весь путь от спроса до обращения. Покажем, где опыт специалиста и AI-анализ дадут клинике самое практическое преимущество.</p><a href="mailto:hello@rmcreatives.com">Поговорим ↗</a></section>
</main></BaseLayout>
