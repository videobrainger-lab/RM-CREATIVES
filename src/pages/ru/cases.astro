---
import BaseLayout from '../../layouts/BaseLayout.astro';
const cases = [
{client:'EPILINE',type:'ФЛАГМАНСКИЙ КЕЙС',title:'Система привлечения пациентов, а не набор отдельных кампаний.',problem:'Клинике нужно было объединить платное привлечение, органический поиск, новый сайт и работу с лидами в одну систему.',solution:'Мы связали Meta Ads, Google Ads, SEO, сайт и CRM вокруг единого пути пациента.',result:'2 970',resultLabel:'обращений из Meta · январь–август 2026',href:'/ru/cases/epiline',featured:true,tags:'FLAGSHIP'},
{client:'CONSILIUM MEDICUM',type:'ФЛАГМАНСКИЙ КЕЙС',title:'Как забирать медицинский спрос в условиях жёстких рекламных ограничений.',problem:'Пациенты с высоким намерением уже искали услуги, но правила healthcare регулярно осложняли продвижение.',solution:'Выстроили многоканальное привлечение вокруг Google Ads, Meta и органического поиска с учётом медицинских ограничений.',result:'3 356',resultLabel:'конверсий Google Ads · 2024',href:'/ru/cases/consilium-medicum',featured:true,tags:'FLAGSHIP'},
{client:'DENTA',type:'ФЛАГМАНСКИЙ КЕЙС',title:'Как превратить стоматологию в полноценную систему привлечения пациентов.',problem:'Рост не должен был зависеть от одного рекламного канала. Клинике была нужна более сильная цифровая база.',solution:'Google, Meta, SEO и новый сайт развивали как единую acquisition-экосистему.',result:'16 227',resultLabel:'отслеживаемых обращений · 2025',href:'/ru/cases/denta',featured:true,tags:'FLAGSHIP'},
{client:'UNION KLINIKA',type:'ФЛАГМАНСКИЙ КЕЙС',title:'Рост медицинской клиники с ограниченным маркетинговым бюджетом.',problem:'Клинике нужны были дополнительные обращения и более сильное цифровое присутствие без раздутого проекта.',solution:'Объединили новый patient-first сайт с привлечением через Meta и Google.',result:'1 021',resultLabel:'обращение из Meta · май–декабрь 2024',href:'/ru/cases/union-klinika',featured:true,tags:'FLAGSHIP'},
{type:'META ADS',title:'Как масштабировать Meta и не потерять контроль над стоимостью обращения?',problem:'Рост объёма обычно приводит к удорожанию обращений.',solution:'Постоянно тестировали офферы, аудитории и креативы, удерживая канал управляемым месяц за месяцем.',result:'2 970',resultLabel:'обращений · январь–август 2026',href:'/ru/cases/epiline/meta-ads',tags:'META ADS'},
{type:'META ADS',title:'Создавать пациентский спрос за пределами Google Search.',problem:'Поиск забирает существующий спрос, но росту также нужно находить пациентов ещё до поискового запроса.',solution:'Meta-кампании расширяли охват и создавали дополнительный канал обращений.',result:'META',resultLabel:'paid social для клиники',href:'/ru/cases/consilium-medicum/meta-ads',tags:'META ADS'},
{type:'META ADS',title:'Как сделать paid social предсказуемым каналом для стоматологии.',problem:'Нужен был объём обращений без зависимости только от дорогого горячего поиска.',solution:'Meta создавал спрос и направлял заинтересованных пациентов прямо в воронки обращения.',result:'1 902',resultLabel:'обращения · январь–август 2026',href:'/ru/cases/denta/meta-ads',tags:'META ADS'},
{type:'META ADS',title:'Привлечение пациентов при ограниченном бюджете клиники.',problem:'Нужен был заметный поток обращений без большого медиабюджета.',solution:'Сфокусированные офферы и Meta-кампании концентрировали бюджет вокруг измеримых действий пациентов.',result:'€2.75',resultLabel:'средний CPL · май–декабрь 2024',href:'/ru/cases/union-klinika/meta-ads',tags:'META ADS'},
{type:'GOOGLE ADS',title:'Забирать пациентов, которые уже ищут лечение.',problem:'Горячий спрос уже существовал, но его нужно было эффективно превращать в измеримые обращения.',solution:'Поисковые кампании связали намерение пациента с релевантными страницами и отслеживанием конверсий.',result:'1 343',resultLabel:'конверсии · январь–август 2026',href:'/ru/cases/epiline/google-ads',tags:'GOOGLE ADS'},
{type:'GOOGLE ADS',title:'3 356 медицинских обращений из существующего поискового спроса.',problem:'Пациенты искали специалистов и услуги, но спрос был раздроблен по множеству запросов.',solution:'Сегментировали намерение и связали поисковые кампании с релевантными страницами клиники.',result:'€3.25',resultLabel:'стоимость конверсии · 2024',href:'/ru/cases/consilium-medicum/google-ads',tags:'GOOGLE ADS'},
{type:'MEDICAL GOOGLE ADS',title:'Что делать, когда Google постоянно ограничивает медицинскую рекламу?',problem:'Политики healthcare приводили к регулярным ограничениям и блокировкам по чувствительным медицинским темам.',solution:'Более широкое таргетирование, нейтральные формулировки, compliant-страницы и постоянный контроль аккаунта помогали сохранять привлечение.',result:'POLICY',resultLabel:'эффективность в рамках ограничений',href:'/ru/cases/consilium-medicum/medical-google-ads',tags:'GOOGLE ADS'},
{type:'GOOGLE ADS',title:'Масштабировать горячий стоматологический поиск и не разрушить CPA.',problem:'Стоматологический поиск ценен, потому что пациент близок к выбору клиники — и конкуренция очень высокая.',solution:'Структура кампаний и сегментация намерения концентрировали бюджет на запросах с максимальной вероятностью обращения.',result:'10 601',resultLabel:'конверсия · 2025',href:'/ru/cases/denta/google-ads',tags:'GOOGLE ADS'},
{type:'GOOGLE ADS',title:'Превращать медицинские поисковые запросы в обращения в клинику.',problem:'Пациенты уже искали услуги, но клинике нужен был структурированный способ забирать этот спрос.',solution:'Поисковые кампании связывали релевантные запросы с клиникой и страницами её услуг.',result:'SEARCH',resultLabel:'существующий пациентский спрос',href:'/ru/cases/union-klinika/google-ads',tags:'GOOGLE ADS'},
{type:'SEO',title:'Создать органический спрос за пределами названия клиники.',problem:'Платный трафик исчезает вместе с бюджетом. Клинике была нужна видимость по реальным запросам услуг.',solution:'Техническое, структурное и контентное SEO выстроило небрендовую видимость на двух языках.',result:'TOP 10',resultLabel:'275 органических обращений',href:'/ru/cases/epiline/seo',tags:'SEO'},
{type:'SEO',title:'Превратить вопросы пациентов в органическое привлечение.',problem:'Пациенты ищут симптомы и медицинские ответы задолго до выбора конкретной клиники.',solution:'Органическая видимость перехватывала этот ранний спрос и приводила его в экосистему клиники.',result:'24 632',resultLabel:'органических клика · январь–август 2026',href:'/ru/cases/consilium-medicum/seo',tags:'SEO'},
{type:'SEO',title:'От поисковой видимости к тысячам органических обращений.',problem:'Клинике нужен был источник пациентского спроса, где не приходится покупать каждый клик.',solution:'Долгосрочное SEO вывело ключевые запросы в ведущие позиции и нарастило органическое привлечение.',result:'TOP 5',resultLabel:'3 831 органическое обращение · 2025',href:'/ru/cases/denta/seo',tags:'SEO'},
{type:'WEBSITE',title:'Пересобрать сайт клиники и не потерять поисковую видимость.',problem:'Старый сайт был медленным, с ошибками и неудобным UX, но уже имел ценную видимость в поиске.',solution:'Пересобрали 44 страницы на двух языках и мигрировали сайт с сохранением ключевых позиций.',result:'44',resultLabel:'страницы · LV / RU',href:'/ru/cases/epiline/website',tags:'WEBSITE'},
{type:'WEBSITE',title:'Новый сайт как инфраструктура привлечения пациентов.',problem:'Реклама и SEO работают только настолько хорошо, насколько хорошо работает посадочная среда.',solution:'Пересобрали сайт вокруг услуг, поисковой видимости и коротких путей к обращению.',result:'NEW',resultLabel:'сайт для привлечения пациентов',href:'/ru/cases/denta/website',tags:'WEBSITE'},
{type:'WEBSITE',title:'Как пересобрать сайт клиники с ограниченным бюджетом?',problem:'Пациентам нужны были более понятные услуги, врачи и путь к записи, а клинике — экономичный проект.',solution:'Пересобрали структуру и UX в двуязычный patient-first сайт без раздутой разработки.',result:'NEW',resultLabel:'двуязычный сайт клиники',href:'/ru/cases/union-klinika/website',tags:'WEBSITE'},
{type:'CRM & BOOKING',title:'Лид — ещё не результат. Что происходит после обращения?',problem:'Маркетинг может привести обращение и всё равно потерять пациента на этапе обработки.',solution:'Kommo, WhatsApp и Altegio связали в понятный путь: обращение → диалог → запись → повторный визит.',result:'CRM',resultLabel:'лид → визит → повтор',href:'/ru/cases/epiline/crm-booking',tags:'CRM'}
];
const flagship=cases.filter(c=>c.featured); const stories=cases.filter(c=>!c.featured);
---
<BaseLayout lang="ru" title="Кейсы | RM CREATIVES" description="Кейсы роста клиник: Meta Ads, Google Ads, SEO, сайты, CRM и аналитика.">
<main class="shell page"><div class="top eyebrow"><span>БИБЛИОТЕКА КЕЙСОВ</span><span>{cases.length} ИСТОРИЙ / 4 КЛИНИКИ</span></div><section class="hero"><h1>Решённые задачи.<br/><em>Измеримые результаты.</em></h1><div><p>Не выбирайте кейс по цифре. Выберите задачу, которая похожа на вашу.</p><p class="muted">Начните с флагманского кейса или отфильтруйте библиотеку по части системы привлечения, которую хотите улучшить.</p></div></section><section class="flagships"><div class="section-title"><span class="eyebrow">НАЧНИТЕ ЗДЕСЬ / ФЛАГМАНСКИЕ ПРОЕКТЫ</span><h2>Вся история<br/>роста.</h2></div><div class="flag-grid">{flagship.map((item,i)=><a class={`flag flag-${i}`} href={item.href}><div class="flag-top eyebrow"><span>{item.client}</span><span>ПОЛНЫЙ КЕЙС ↗</span></div><h3>{item.title}</h3><p>{item.problem}</p><div class="flag-result"><strong>{item.result}</strong><span>{item.resultLabel}</span></div></a>)}</div></section><section class="library"><div class="library-head"><div><span class="eyebrow">ДЕТАЛЬНЫЕ КЕЙСЫ</span><h2>Выберите задачу.</h2></div><p>Каждая история работает отдельно. Выберите знакомую проблему — название клиента здесь вторично.</p></div><nav class="filters eyebrow"><button class="active" data-filter="ALL">ВСЕ</button><button data-filter="META ADS">META ADS</button><button data-filter="GOOGLE ADS">GOOGLE ADS</button><button data-filter="SEO">SEO</button><button data-filter="WEBSITE">САЙТЫ</button><button data-filter="CRM">CRM & АНАЛИТИКА</button></nav><div class="story-list">{stories.map((item,i)=><a class={`story story-${i%4}`} href={item.href} data-tags={item.tags}><div class="story-side"><span class="eyebrow">{item.type}</span><span class="story-no">{String(i+1).padStart(2,'0')}</span></div><div class="story-main"><h3>{item.title}</h3><div class="ps"><div><span>ЗАДАЧА</span><p>{item.problem}</p></div><div><span>ЧТО СДЕЛАЛИ</span><p>{item.solution}</p></div></div></div><div class="story-result"><strong>{item.result}</strong><span>{item.resultLabel}</span><em>ОТКРЫТЬ КЕЙС ↗</em></div></a>)}</div></section></main>
<script>const buttons=document.querySelectorAll('.filters button');const cards=document.querySelectorAll('.story');buttons.forEach(b=>b.addEventListener('click',()=>{const f=b.dataset.filter;buttons.forEach(x=>x.classList.remove('active'));b.classList.add('active');cards.forEach(c=>c.style.display=f==='ALL'||c.dataset.tags?.includes(f)?'grid':'none')}));</script>
</BaseLayout>
<style>
.page{padding:38px 0 150px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.hero{padding:95px 0 120px;display:grid;grid-template-columns:1.55fr .55fr;gap:90px;align-items:end}.hero h1{font-size:clamp(68px,9vw,140px);line-height:.84;letter-spacing:-.075em;margin:0;font-weight:650}.hero h1 em{font-style:normal;color:var(--accent)}.hero p{font-size:20px;line-height:1.35;margin:0 0 18px}.hero .muted{font-size:15px}.section-title{display:grid;grid-template-columns:.55fr 1fr;gap:60px;padding:28px 0 55px;border-top:1px solid var(--line)}.section-title h2,.library-head h2{font-size:clamp(48px,6vw,88px);line-height:.9;letter-spacing:-.06em;margin:0}.flag-grid{display:grid;grid-template-columns:1.25fr .75fr;grid-auto-rows:minmax(470px,auto);gap:10px}.flag{padding:28px;display:flex;flex-direction:column;background:#e5e4de;border:1px solid #d7d6cf}.flag-0{background:var(--accent)}.flag-1{background:var(--dark);color:var(--white)}.flag-2{grid-column:2;background:#d8d7d0}.flag-3{grid-column:1;grid-row:2;background:#f8f7f2}.flag-top{display:flex;justify-content:space-between}.flag h3{font-size:clamp(36px,4vw,62px);line-height:.98;letter-spacing:-.055em;max-width:800px;margin:70px 0 25px}.flag p{font-size:16px;line-height:1.5;max-width:600px;opacity:.68}.flag-result{margin-top:auto;border-top:1px solid currentColor;padding-top:22px;display:flex;align-items:end;justify-content:space-between;gap:30px}.flag-result strong{font-size:clamp(60px,7vw,105px);line-height:.8;letter-spacing:-.07em;font-weight:550}.flag-result span{font-size:12px;opacity:.6;text-align:right}.library{padding-top:150px}.library-head{display:grid;grid-template-columns:1.4fr .6fr;gap:80px;align-items:end}.library-head p{font-size:17px;line-height:1.5;color:var(--muted);max-width:420px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:55px 0 30px;padding-top:20px;border-top:1px solid var(--line)}.filters button{font:inherit;letter-spacing:inherit;background:transparent;border:1px solid var(--line);padding:9px 12px;cursor:pointer}.filters .active{background:var(--ink);color:white}.story-list{border-top:1px solid var(--ink)}.story{min-height:285px;display:grid;grid-template-columns:.28fr 1.25fr .42fr;gap:35px;padding:30px 20px;border-bottom:1px solid var(--line);transition:background .2s}.story:hover{background:#e7e6df}.story-1:hover{background:#e2e7ff}.story-2:hover{background:#ededeb}.story-3:hover{background:#e9e8e2}.story-side{display:flex;flex-direction:column;justify-content:space-between}.story-no{font:11px monospace;color:var(--muted)}.story-main h3{font-size:clamp(28px,3vw,46px);line-height:1.02;letter-spacing:-.045em;margin:0 0 42px;max-width:800px}.ps{display:grid;grid-template-columns:1fr 1fr;gap:45px}.ps span{font:9px monospace;letter-spacing:.1em;color:var(--muted)}.ps p{font-size:14px;line-height:1.45;margin:8px 0 0;color:var(--muted);max-width:390px}.story-result{border-left:1px solid var(--line);padding-left:25px;display:flex;flex-direction:column}.story-result strong{font-size:clamp(40px,4.5vw,68px);letter-spacing:-.065em;line-height:.9}.story-result span{font-size:11px;color:var(--muted);margin-top:10px}.story-result em{font:10px monospace;font-style:normal;margin-top:auto;border-bottom:1px solid var(--ink);padding-bottom:7px;align-self:flex-start}@media(max-width:900px){.hero,.section-title,.library-head{grid-template-columns:1fr}.flag-grid{grid-template-columns:1fr;grid-auto-rows:auto}.flag,.flag-2,.flag-3{grid-column:auto;grid-row:auto;min-height:430px}.story{grid-template-columns:1fr;gap:25px}.story-side{flex-direction:row}.story-result{border-left:0;border-top:1px solid var(--line);padding:20px 0 0;min-height:140px}.ps{grid-template-columns:1fr}.hero{gap:35px}.top span:last-child{display:none}}
</style>