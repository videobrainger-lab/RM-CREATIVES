---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const pages = {
    'cases': {title:'Кейсы RM CREATIVES', eyebrow:'БИБЛИОТЕКА КЕЙСОВ', headline:'Решённые задачи.\nИзмеримые результаты.', intro:'Выбирайте кейс не по названию клиента, а по задаче, которая похожа на вашу.', kind:'library'},
    'search': {title:'RM Search — Google Ads для клиник', eyebrow:'GOOGLE ADS / СУЩЕСТВУЮЩИЙ СПРОС', headline:'Забираем пациентов,\nкоторые уже ищут ваши услуги.', intro:'До запуска оцениваем спрос, клики и возможный объём обращений. После запуска строим поисковые кампании вокруг реального намерения пациента.', bullets:['Прогноз спроса до запуска','Структура по услугам и поисковому намерению','Прозрачная аналитика обращений'], cta:'/ru/contact'},
    'sites': {title:'RM Sites — сайты для клиник', eyebrow:'WEB / CONVERSION / SEO', headline:'Сайт клиники,\nкоторый помогает продавать.', intro:'Проектируем быстрые сайты для медицинских и эстетических клиник: понятные услуги, врачи, доверие, SEO и короткий путь до обращения.', bullets:['Продуманная структура и UX','SEO-ready архитектура','Интеграции с CRM и формами'], cta:'/ru/contact'},
    'insights': {title:'Insights — RM CREATIVES', eyebrow:'INSIGHTS', headline:'Практика маркетинга\nдля клиник.', intro:'Разборы рекламы, сайтов, SEO и систем привлечения пациентов. Без агентской воды — только то, что применяем в реальных проектах.', kind:'simple'},
    'privacy': {title:'Политика конфиденциальности — RM CREATIVES', eyebrow:'LEGAL', headline:'Политика\nконфиденциальности.', intro:'Здесь описано, какие данные мы можем получать через сайт, для чего используем их и как защищаем. По вопросам обработки данных напишите на clientcare@rmcreatives.com.', kind:'legal'},
    'terms': {title:'Условия использования — RM CREATIVES', eyebrow:'LEGAL', headline:'Условия\nиспользования.', intro:'Используя сайт RM CREATIVES, вы соглашаетесь с опубликованными условиями. Материалы сайта предназначены для информационных целей и не являются гарантией конкретного результата.', kind:'legal'},
    'cookies': {title:'Cookies — RM CREATIVES', eyebrow:'LEGAL', headline:'Политика\ncookies.', intro:'Сайт может использовать необходимые и аналитические cookie-файлы для корректной работы и улучшения пользовательского опыта.', kind:'legal'},
    'cases/epiline': {title:'Epiline — флагманский кейс', eyebrow:'ФЛАГМАНСКИЙ КЕЙС / EPILINE', headline:'Система привлечения пациентов,\nа не набор кампаний.', problem:'Клинике нужно было объединить платное привлечение, органический поиск, новый сайт и работу с лидами в одну систему.', solution:'Мы связали Meta Ads, Google Ads, SEO, сайт и CRM вокруг единого пути пациента.', result:'2 970', resultLabel:'обращений из Meta · январь–август 2026'},
    'cases/epiline/meta-ads': {title:'Epiline — Meta Ads', eyebrow:'META ADS', headline:'Как масштабировать Meta\nи не потерять контроль над CPL?', problem:'Рост объёма обращений обычно приводит к росту их стоимости.', solution:'Постоянно тестировали офферы, аудитории и креативы, удерживая канал управляемым месяц за месяцем.', result:'2 970', resultLabel:'обращений · январь–август 2026'},
    'cases/epiline/google-ads': {title:'Epiline — Google Ads', eyebrow:'GOOGLE ADS', headline:'Забрать пациентов,\nкоторые уже ищут лечение.', problem:'Спрос уже существовал, но его нужно было эффективно превращать в измеримые обращения.', solution:'Связали поисковое намерение с релевантными посадочными страницами и отслеживанием конверсий, чтобы видеть не только клики, но и реальные обращения по ключевым услугам.', result:'1 343', resultLabel:'конверсии · январь–август 2026'},
    'cases/epiline/seo': {title:'Epiline — SEO', eyebrow:'SEO / ORGANIC', headline:'Органический спрос\nза пределами бренда.', problem:'Платный трафик исчезает вместе с бюджетом. Клинике была нужна видимость по реальным запросам услуг.', solution:'Техническое, структурное и контентное SEO выстроило небрендовую видимость на двух языках.', result:'TOP 10', resultLabel:'275 органических обращений'},
    'cases/epiline/website': {title:'Epiline — новый сайт', eyebrow:'WEBSITE', headline:'Пересобрать сайт\nи не потерять поисковую видимость.', problem:'Старый сайт был медленным, с ошибками и неудобным UX, но уже имел ценную видимость в поиске.', solution:'Пересобрали 44 страницы на двух языках и мигрировали сайт с сохранением ключевых позиций.', result:'44', resultLabel:'страницы · LV / RU'},
    'cases/epiline/crm-booking': {title:'Epiline — CRM и запись', eyebrow:'CRM / BOOKING', headline:'Лид — ещё не результат.\nЧто происходит после заявки?', problem:'Маркетинг может привести обращение, а клиника всё равно потеряет пациента на этапе обработки.', solution:'Связали Kommo, WhatsApp и Altegio в понятный путь: обращение → диалог → запись → повторный визит.', result:'CRM', resultLabel:'лид → визит → повтор'},
    'cases/consilium-medicum': {title:'Consilium Medicum — флагманский кейс', eyebrow:'ФЛАГМАНСКИЙ КЕЙС / CONSILIUM MEDICUM', headline:'Медицинский спрос\nв условиях жёстких ограничений рекламы.', problem:'Пациенты активно искали услуги, но политика Google для медицины регулярно осложняла продвижение.', solution:'Выстроили систему вокруг Google Ads, Meta и органического поиска с учётом медицинских ограничений.', result:'3 356', resultLabel:'конверсий Google Ads · 2024'},
    'cases/consilium-medicum/google-ads': {title:'Consilium Medicum — Google Ads', eyebrow:'GOOGLE ADS', headline:'3 356 обращений\nиз существующего спроса.', problem:'Пациенты искали специалистов и услуги, но спрос был раздроблен по множеству запросов.', solution:'Сегментировали намерение и связали поисковые кампании с релевантными страницами клиники, отдельно контролируя эффективность групп запросов и стоимость получаемых конверсий.', result:'€3.25', resultLabel:'стоимость конверсии · 2024'},
    'cases/consilium-medicum/medical-google-ads': {title:'Consilium Medicum — медицинская реклама Google', eyebrow:'MEDICAL GOOGLE ADS', headline:'Что делать, когда Google\nограничивает медицинскую рекламу?', problem:'Политики healthcare приводили к ограничениям и блокировкам по чувствительным медицинским темам.', solution:'Использовали более широкое таргетирование, нейтральные формулировки, compliant-страницы и постоянный контроль статусов.', result:'POLICY', resultLabel:'эффективность в рамках ограничений'},
    'cases/consilium-medicum/meta-ads': {title:'Consilium Medicum — Meta Ads', eyebrow:'META ADS', headline:'Создать спрос\nза пределами Google Search.', problem:'Поиск забирает существующий спрос, но росту клиники требовалось находить пациентов ещё до поискового запроса.', solution:'Meta-кампании расширяли охват и создавали дополнительный канал обращений, позволяя работать с аудиторией раньше момента активного поиска врача или медицинской услуги.', result:'META', resultLabel:'paid social для клиники'},
    'cases/consilium-medicum/seo': {title:'Consilium Medicum — SEO', eyebrow:'SEO / ORGANIC', headline:'Превратить вопросы пациентов\nв органическое привлечение.', problem:'Пациенты ищут симптомы и ответы задолго до выбора конкретной клиники.', solution:'Органическая видимость перехватывала этот ранний спрос и приводила его в экосистему клиники через информационные и сервисные страницы, связанные с реальными поисковыми сценариями пациентов.', result:'24 632', resultLabel:'органических клика · январь–август 2026'},
    'cases/denta': {title:'Denta — флагманский кейс', eyebrow:'ФЛАГМАНСКИЙ КЕЙС / DENTA', headline:'Стоматология как\nполноценная acquisition-система.', problem:'Рост не должен был зависеть от одного рекламного канала. Нужна была сильная цифровая база.', solution:'Google, Meta, SEO и новый сайт развивали как единую экосистему привлечения пациентов.', result:'16 227', resultLabel:'отслеживаемых обращений · 2025'},
    'cases/denta/google-ads': {title:'Denta — Google Ads', eyebrow:'GOOGLE ADS', headline:'Масштабировать горячий спрос\nи не разрушить CPA.', problem:'Стоматологический поиск ценен, потому что пациент близок к выбору клиники, но конкуренция очень высокая.', solution:'Структура кампаний и сегментация намерения концентрировали бюджет на запросах с максимальной вероятностью обращения.', result:'10 601', resultLabel:'конверсия · 2025'},
    'cases/denta/meta-ads': {title:'Denta — Meta Ads', eyebrow:'META ADS', headline:'Сделать paid social\nпредсказуемым каналом стоматологии.', problem:'Нужен был объём обращений без зависимости только от дорогого горячего поиска.', solution:'Meta создавал спрос и направлял заинтересованных пациентов прямо в воронки обращения, а регулярное тестирование креативов и офферов помогало удерживать канал управляемым по стоимости.', result:'1 902', resultLabel:'обращения · январь–август 2026'},
    'cases/denta/seo': {title:'Denta — SEO', eyebrow:'SEO / ORGANIC', headline:'От поисковой видимости\nк тысячам органических обращений.', problem:'Клинике нужен был источник пациентов, где не приходится покупать каждый клик.', solution:'Долгосрочное SEO вывело ключевые запросы в ведущие позиции и нарастило органическое привлечение.', result:'TOP 5', resultLabel:'3 831 органическое обращение · 2025'},
    'cases/denta/website': {title:'Denta — новый сайт', eyebrow:'WEBSITE', headline:'Новый сайт как\nинфраструктура привлечения.', problem:'Реклама и SEO работают только настолько хорошо, насколько хорошо работает посадочная среда.', solution:'Пересобрали сайт вокруг услуг, поисковой видимости и коротких путей к обращению, чтобы платный и органический трафик попадал на понятные страницы с логичным следующим действием.', result:'NEW', resultLabel:'сайт для привлечения пациентов'},
    'cases/union-klinika': {title:'Union Klinika — флагманский кейс', eyebrow:'ФЛАГМАНСКИЙ КЕЙС / UNION KLINIKA', headline:'Рост медицинской клиники\nс ограниченным бюджетом.', problem:'Клинике нужны были дополнительные обращения и более сильное цифровое присутствие без огромного проекта.', solution:'Объединили новый patient-first сайт с привлечением через Meta и Google.', result:'1 021', resultLabel:'обращение Meta · май–декабрь 2024'},
    'cases/union-klinika/meta-ads': {title:'Union Klinika — Meta Ads', eyebrow:'META ADS', headline:'Привлечение пациентов\nпри ограниченном бюджете.', problem:'Нужно было получать стабильные обращения без раздутого рекламного бюджета.', solution:'Сфокусировали Meta Ads на понятных медицинских офферах и постоянно оптимизировали стоимость обращения, перераспределяя бюджет в пользу связок, которые давали наиболее устойчивый результат.', result:'€2.75', resultLabel:'средний CPL · май–декабрь 2024'},
    'cases/union-klinika/google-ads': {title:'Union Klinika — Google Ads', eyebrow:'GOOGLE ADS', headline:'Забирать горячий спрос\nв поиске.', problem:'Часть пациентов уже искала услуги клиники в Google и была близка к выбору.', solution:'Поисковые кампании связали существующий спрос с релевантными услугами и посадочными страницами.', result:'SEARCH', resultLabel:'Google Ads для медицинских услуг'},
    'cases/union-klinika/website': {title:'Union Klinika — новый сайт', eyebrow:'WEBSITE', headline:'Как пересобрать сайт клиники\nс ограниченным бюджетом?', problem:'Пациентам нужны были понятные услуги, врачи и путь до записи, а проект должен был остаться экономичным.', solution:'Пересобрали структуру и UX в двуязычный patient-first сайт без раздутой разработки.', result:'NEW', resultLabel:'двуязычный сайт клиники'}
  };
  return Object.entries(pages).map(([slug, page]) => ({ params: { slug }, props: { page, slug } }));
}

const { page, slug } = Astro.props;
const isLibrary = page.kind === 'library';
const caseLinks = [['Epiline','/ru/cases/epiline'],['Consilium Medicum','/ru/cases/consilium-medicum'],['Denta','/ru/cases/denta'],['Union Klinika','/ru/cases/union-klinika']];
---
<BaseLayout lang="ru" title={page.title} description={page.intro || page.problem || 'RM CREATIVES — маркетинг и привлечение пациентов для клиник.'}>
<main class="ru-page shell">
  <div class="top eyebrow"><span>{page.eyebrow}</span><a href={`/${slug}`}>EN ↗</a></div>
  <section class="hero"><h1>{page.headline.split('\n').map((line, i) => <>{line}{i===0 && <br/>}</>)}</h1>{page.intro && <p>{page.intro}</p>}</section>
  {page.problem && <section class="case-grid"><div><span class="eyebrow">ЗАДАЧА</span><h2>{page.problem}</h2></div><div><span class="eyebrow">ЧТО СДЕЛАЛИ</span><p>{page.solution}</p></div><div class="result"><strong>{page.result}</strong><span>{page.resultLabel}</span></div></section>}
  {page.bullets && <section class="bullets">{page.bullets.map((b, i) => <div><span class="eyebrow">0{i+1}</span><h3>{b}</h3></div>)}</section>}
  {isLibrary && <section class="library"><span class="eyebrow">ФЛАГМАНСКИЕ КЕЙСЫ</span><div class="cards">{caseLinks.map(([name,href]) => <a href={href}><h3>{name}</h3><span>ОТКРЫТЬ КЕЙС ↗</span></a>)}</div></section>}
  {page.cta && <section class="cta"><h2>Обсудить проект?</h2><a href={page.cta}>Оставить заявку ↗</a></section>}
  {page.kind==='legal' && <section class="legal"><p>Полная юридическая версия документа доступна также на английском языке.</p><a href={`/${slug}`}>Открыть английскую версию ↗</a></section>}
  {page.problem && <div class="case-nav"><a href="/ru/cases">← Все кейсы</a><a href={`/${slug}`}>ENGLISH VERSION ↗</a></div>}
</main>
</BaseLayout>
<style>
.ru-page{padding:38px 0 130px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.hero{padding:100px 0 90px;display:grid;grid-template-columns:1.45fr .55fr;gap:70px;align-items:end}.hero h1{font-size:clamp(58px,8vw,120px);line-height:.88;letter-spacing:-.065em;margin:0}.hero p{font-size:18px;line-height:1.5;color:var(--muted);margin:0}.case-grid{border-top:1px solid var(--ink);display:grid;grid-template-columns:1fr .7fr .55fr;gap:55px;padding:40px 0 90px}.case-grid h2{font-size:clamp(30px,3.5vw,52px);line-height:1.05;letter-spacing:-.045em;margin:25px 0 0}.case-grid p{font-size:18px;line-height:1.55;color:var(--muted);margin:25px 0 0}.result{border-left:1px solid var(--line);padding-left:30px;display:flex;flex-direction:column;justify-content:center}.result strong{font-size:clamp(52px,6vw,90px);letter-spacing:-.07em;line-height:.9}.result span{margin-top:12px;color:var(--muted);font-size:12px}.bullets{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.bullets>div{padding:30px;border-right:1px solid var(--line);min-height:230px}.bullets h3{font-size:25px;line-height:1.15;margin:60px 0 0}.library{padding-top:20px}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:30px}.cards a{min-height:260px;padding:25px;background:#e5e4de;display:flex;flex-direction:column;justify-content:space-between}.cards a:nth-child(2){background:var(--dark);color:white}.cards a:nth-child(3){background:var(--accent)}.cards h3{font-size:36px;margin:0}.cards span{font:10px monospace}.cta,.legal{margin-top:90px;padding-top:30px;border-top:1px solid var(--line)}.cta h2{font-size:56px;margin:0 0 25px}.cta a,.legal a{border-bottom:1px solid var(--ink)}.case-nav{margin-top:80px;padding-top:20px;border-top:1px solid var(--line);display:flex;justify-content:space-between;font:10px monospace}@media(max-width:800px){.hero,.case-grid{grid-template-columns:1fr}.hero{padding:70px 0 60px}.result{border-left:0;border-top:1px solid var(--line);padding:25px 0}.bullets,.cards{grid-template-columns:1fr}.bullets>div{border-right:0;border-bottom:1px solid var(--line)}}
</style>