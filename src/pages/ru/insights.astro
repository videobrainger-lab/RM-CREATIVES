---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="ru" title="Insights | RM CREATIVES" description="Практические материалы о привлечении пациентов, Meta Ads, Google Ads, SEO и сайтах клиник.">
<main class="page shell">
  <div class="top eyebrow"><span>INSIGHTS</span><span>RM CREATIVES / KNOWLEDGE</span></div>
  <section class="hero"><h1>Практика маркетинга<br/>для клиник.</h1><p>Разборы рекламы, сайтов, SEO и систем привлечения пациентов. Без агентской воды — только то, что применяем в реальных проектах.</p></section>
  <section class="soon"><div><span class="eyebrow">СКОРО</span><h2>Новые статьи<br/>уже готовим.</h2></div><div class="subscribe"><p>Скоро здесь появятся новые практические статьи и разборы реальных проектов. Оставьте email — напишем, когда выйдет новый материал.</p><form data-subscribe><div class="form-row"><label class="sr-only" for="email-ru">Email</label><input id="email-ru" type="email" name="email" placeholder="ВАШ EMAIL" required autocomplete="email"/><button type="submit">ПОДПИСАТЬСЯ ↗</button></div><small>Только новые материалы RM CREATIVES. Без спама.</small><div class="success" hidden><span class="eyebrow">ГОТОВО</span><strong>Спасибо. Вы подписаны.</strong><p>Напишем вам, когда выйдет новый материал.</p></div><div class="error" hidden><span class="eyebrow">ОШИБКА</span><strong>Не получилось подписать.</strong><p>Попробуйте ещё раз через минуту.</p></div></form></div></section>
</main>
<script>
const form=document.querySelector('form[data-subscribe]');
if(form){form.addEventListener('submit',async(e)=>{e.preventDefault();const email=form.querySelector('input[name="email"]')?.value?.trim();const button=form.querySelector('button[type="submit"]');const row=form.querySelector('.form-row');const note=form.querySelector('small');const success=form.querySelector('.success');const error=form.querySelector('.error');if(!email)return;const original=button?.textContent;if(error)error.hidden=true;if(button){button.disabled=true;button.textContent='ОТПРАВЛЯЕМ…';}try{const response=await fetch('/.netlify/functions/subscribe',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email})});if(!response.ok)throw new Error('SendPulse subscription failed');if(row)row.hidden=true;if(note)note.hidden=true;if(success)success.hidden=false;form.reset();}catch(err){console.warn('SendPulse subscription failed',err);if(error)error.hidden=false;}finally{if(button){button.disabled=false;button.textContent=original||'ПОДПИСАТЬСЯ ↗';}}});}
</script>
</BaseLayout>
<style>
.page{padding:38px 0 140px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.hero{padding:100px 0 110px;display:grid;grid-template-columns:1.45fr .55fr;gap:70px;align-items:end}.hero h1{font-size:clamp(58px,8vw,120px);line-height:.88;letter-spacing:-.065em;margin:0;font-weight:650}.hero p{font-size:18px;line-height:1.5;color:var(--muted);margin:0}.soon{border-top:1px solid var(--ink);padding:40px 0 0;display:grid;grid-template-columns:1.25fr .75fr;gap:80px}.soon h2{font-size:clamp(48px,6vw,88px);line-height:.9;letter-spacing:-.06em;margin:35px 0 0}.subscribe{padding-top:35px}.subscribe>p{font-size:18px;line-height:1.55;color:var(--muted);margin:0 0 35px;max-width:540px}.form-row{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid var(--ink)}input{appearance:none;border:0;background:transparent;padding:18px 0;font:inherit;font-size:16px;outline:none;min-width:0}button{border:0;background:var(--ink);color:white;padding:0 22px;font:11px monospace;letter-spacing:.08em;cursor:pointer}button:disabled{opacity:.65;cursor:wait}small{display:block;margin-top:12px;color:var(--muted);font-size:11px}.success,.error{border-top:1px solid var(--ink);padding-top:22px}.success strong,.error strong{display:block;font-size:28px;letter-spacing:-.03em;margin-top:12px}.success p,.error p{font-size:14px;color:var(--muted);margin:8px 0 0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:800px){.hero,.soon{grid-template-columns:1fr}.hero{padding:70px 0}.soon{gap:35px}.top span:last-child{display:none}.form-row{grid-template-columns:1fr}.form-row button{padding:17px 20px}}
</style>