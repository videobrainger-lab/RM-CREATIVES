---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/consilium-medicum/google-ads',label:'GOOGLE ADS',copy:'Захват существующего медицинского спроса.'},{href:'/ru/cases/consilium-medicum/medical-google-ads',label:'MEDICAL ADS',copy:'Работа с ограничениями медицинской рекламы.'},{href:'/ru/cases/consilium-medicum/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса вне поиска.'},{href:'/ru/cases/consilium-medicum/seo',label:'SEO',copy:'Органическая видимость по медицинским запросам.'}];
---
<RuCaseLayout title="Consilium Medicum — медицинский Google Ads" description="Практический кейс о работе с ограничениями и блокировками Google Ads в медицинской тематике." client="CONSILIUM MEDICUM" clientLabel="МЕДИЦИНСКАЯ КЛИНИКА" eyebrow="MEDICAL GOOGLE ADS" headline="Когда Google" accent="ограничивает медицину." intro="Healthcare-реклама живёт внутри более жёстких правил. Чувствительные темы, формулировки и посадочные страницы могут ограничивать охват или блокировать объявления — поэтому compliance становится частью performance-маркетинга." metrics={[{value:'POLICY',label:'ограничения как часть стратегии'},{value:'COMPLIANT',label:'объявления и страницы'},{value:'ALWAYS ON',label:'контроль статусов кампаний'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ПРОБЛЕМА</span><div><h2>Хорошая кампания<br/>может не запуститься.</h2><p class="statement">В медицинской рекламе эффективность начинается с того, что платформа вообще разрешает показать.</p><p>Ограничения касались чувствительных медицинских тем, формулировок и отдельных сценариев таргетинга. Поэтому рекламная стратегия должна была учитывать политику Google ещё до запуска.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">COMPLIANCE FLOW</span><h2>Эффективность<br/>внутри правил.</h2><div class="flow"><span>УСЛУГА</span><b>→</b><span>ПОЛИТИКА GOOGLE</span><b>→</b><span>НЕЙТРАЛЬНЫЙ ОФФЕР</span><b>→</b><span>COMPLIANT PAGE</span><b>→</b><span>ЗАПУСК</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">ПОДХОД</span><div><h2>Не бороться<br/>с платформой.</h2><p class="statement">Задача — найти рабочую форму продвижения, а не маскировать запрещённое.</p><p>Использовались более нейтральные формулировки, допустимые структуры объявлений, compliant-посадочные страницы и постоянный контроль статусов, чтобы быстрее реагировать на ограничения.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">COPY</span><strong>NEUTRAL</strong><small>без чувствительных обещаний</small></div><div class="proof"><span class="eyebrow">LANDING</span><strong>COMPLIANT</strong><small>страницы в рамках правил</small></div><div class="proof"><span class="eyebrow">CONTROL</span><strong>DAILY</strong><small>контроль статусов и отклонений</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Политика —<br/>часть медиаплана.</h2><p class="statement">В healthcare нельзя сначала придумать рекламу, а потом проверять, разрешена ли она.</p><p>Ограничения платформы нужно учитывать на уровне оффера, посадочной страницы и структуры кампаний с самого начала.</p></div></div></div></section>
</RuCaseLayout>