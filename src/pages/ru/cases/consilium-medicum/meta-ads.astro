---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/consilium-medicum/google-ads',label:'GOOGLE ADS',copy:'Захват существующего медицинского спроса.'},{href:'/ru/cases/consilium-medicum/medical-google-ads',label:'MEDICAL ADS',copy:'Работа с ограничениями медицинской рекламы.'},{href:'/ru/cases/consilium-medicum/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса вне поиска.'},{href:'/ru/cases/consilium-medicum/seo',label:'SEO',copy:'Органическая видимость по медицинским запросам.'}];
---
<RuCaseLayout title="Consilium Medicum — Meta Ads" description="Как Meta Ads дополняли поисковое привлечение Consilium Medicum и расширяли воронку пациентов." client="CONSILIUM MEDICUM" clientLabel="МЕДИЦИНСКАЯ КЛИНИКА" eyebrow="META ADS" headline="Не ждать" accent="поискового запроса." intro="Google работает с уже сформированным спросом. Meta позволяла обращаться к аудитории раньше — до момента, когда человек начал активно искать врача или конкретную медицинскую услугу." metrics={[{value:'META',label:'отдельный paid social канал'},{value:'DEMAND',label:'работа до активного поиска'},{value:'FULL FUNNEL',label:'дополнение Google и SEO'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Расширить<br/>воронку.</h2><p class="statement">Если работать только с поиском, клиника зависит от уже существующего спроса.</p><p>Meta использовалась для привлечения внимания к направлениям клиники и создания дополнительной точки входа в patient journey.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">DEMAND GENERATION</span><h2>До того,<br/>как начнут искать.</h2><div class="flow"><span>АУДИТОРИЯ</span><b>→</b><span>КРЕАТИВ</span><b>→</b><span>ИНТЕРЕС</span><b>→</b><span>КЛИНИКА</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">РОЛЬ КАНАЛА</span><div><h2>Не замена Google.<br/>Дополнение.</h2><p class="statement">Разные каналы работают на разных этапах решения пациента.</p><p>Google захватывает активный спрос, SEO работает с информационными и сервисными запросами, а Meta помогает формировать интерес раньше. Вместе это создаёт более широкую систему привлечения.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">SEARCH</span><strong>GOOGLE</strong><small>активный спрос</small></div><div class="proof"><span class="eyebrow">DISCOVERY</span><strong>META</strong><small>создание интереса</small></div><div class="proof"><span class="eyebrow">ORGANIC</span><strong>SEO</strong><small>долгосрочная видимость</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Один канал<br/>не видит весь путь.</h2><p class="statement">Пациент редко начинает и заканчивает выбор клиники в одной рекламной системе.</p><p>Поэтому Meta рассматривалась как часть общей acquisition-архитектуры, а не как отдельная кампания ради показателей кабинета.</p></div></div></div></section>
</RuCaseLayout>