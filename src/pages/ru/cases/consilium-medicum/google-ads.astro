---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/consilium-medicum/google-ads',label:'GOOGLE ADS',copy:'Захват существующего медицинского спроса.'},{href:'/ru/cases/consilium-medicum/medical-google-ads',label:'MEDICAL ADS',copy:'Работа с ограничениями медицинской рекламы.'},{href:'/ru/cases/consilium-medicum/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса вне поиска.'},{href:'/ru/cases/consilium-medicum/seo',label:'SEO',copy:'Органическая видимость по медицинским запросам.'}];
---
<RuCaseLayout title="Consilium Medicum — Google Ads" description="Как Consilium Medicum получила 3 356 конверсий из Google Ads в 2024 году при CPA €3,25." client="CONSILIUM MEDICUM" clientLabel="МЕДИЦИНСКАЯ КЛИНИКА" eyebrow="GOOGLE ADS" headline="Сложный спрос." accent="Понятная структура." intro="Медицинский поиск фрагментирован: пациенты ищут врачей, симптомы, обследования и конкретные услуги. Кампании нужно было организовать так, чтобы каждый тип намерения попадал в релевантный сценарий." metrics={[{value:'3 356',label:'конверсий / 2024'},{value:'€3,25',label:'CPA / 2024'},{value:'€0,20',label:'CPC / 2024'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Разобрать<br/>медицинский спрос.</h2><p class="statement">Один общий рекламный аккаунт не должен смешивать десятки разных намерений.</p><p>Структура кампаний разделяла специалистов, услуги и поисковые сценарии, чтобы объявления и посадочные страницы соответствовали тому, что реально ищет пациент.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">GOOGLE ADS / 2024</span><h2>3 356 конверсий.<br/>CPA €3,25.</h2><div class="flow"><span>ПОИСК</span><b>→</b><span>СЕГМЕНТ НАМЕРЕНИЯ</span><b>→</b><span>ОБЪЯВЛЕНИЕ</span><b>→</b><span>СТРАНИЦА</span><b>→</b><span>КОНВЕРСИЯ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЭФФЕКТИВНОСТЬ</span><div><h2>Не только объём.<br/>Экономика.</h2><p class="statement">Медицинская реклама может быть эффективной даже в сложной конкурентной среде.</p><p>В 2024 году кампании дали 3 356 конверсий при CPA €3,25 и CPC €0,20. CTR по отдельным группам находился в диапазоне 6,59–17,78%, а конверсия — 4,17–7,42%.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">CONVERSIONS</span><strong>3 356</strong><small>2024</small></div><div class="proof"><span class="eyebrow">CPA</span><strong>€3,25</strong><small>2024</small></div><div class="proof"><span class="eyebrow">CPC</span><strong>€0,20</strong><small>2024</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Медицина требует<br/>точности.</h2><p class="statement">Чем сложнее спрос, тем важнее архитектура аккаунта.</p><p>Именно структурирование намерения позволяет видеть, какие направления действительно приводят пациентов, а какие просто расходуют бюджет.</p></div></div></div></section>
</RuCaseLayout>