---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/union-klinika/meta-ads',label:'META ADS',copy:'Стабильный поток обращений при ограниченном бюджете.'},{href:'/ru/cases/union-klinika/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/union-klinika/website',label:'WEBSITE',copy:'Практичный сайт вокруг пути пациента.'}];
---
<RuCaseLayout title="Union Klinika — Meta Ads" description="Как Union Klinika получила 1 021 обращение из Meta Ads за май–декабрь 2024 при средневзвешенном CPL €2,75." client="UNION KLINIKA" clientLabel="МЕДИЦИНСКАЯ КЛИНИКА" eyebrow="META ADS" headline="Ограниченный бюджет." accent="Измеримый поток." intro="Задача была не в максимальном охвате, а в стабильном количестве обращений при понятной экономике. Meta стала основным источником дополнительного спроса для клиники." metrics={[{value:'1 021',label:'обращение / май–дек 2024'},{value:'€2,75',label:'средневзвешенный CPL'},{value:'255',label:'пиковый месяц / октябрь'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Получать больше<br/>без большого бюджета.</h2><p class="statement">Для небольшой клиники важна не рекламная активность сама по себе, а стоимость каждого дополнительного обращения.</p><p>Кампании строились вокруг понятных офферов и услуг, где можно было быстро увидеть связь между расходом и количеством заявок.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">META ADS / МАЙ–ДЕКАБРЬ 2024</span><h2>1 021 обращение.<br/>CPL €2,75.</h2><div class="flow"><span>ОФФЕР</span><b>→</b><span>КРЕАТИВ</span><b>→</b><span>META</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">ДИНАМИКА</span><div><h2>Рост месяц<br/>за месяцем.</h2><p class="statement">Канал набирал объём по мере накопления данных и тестирования связок.</p><p>С мая по октябрь количество обращений выросло с 22 до 255 в месяц. Затем объём корректировался, но канал продолжал давать измеримый результат.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">МАЙ</span><strong>22</strong><small>обращения</small></div><div class="proof"><span class="eyebrow">ОКТЯБРЬ</span><strong>255</strong><small>обращений</small></div><div class="proof"><span class="eyebrow">ВСЕГО</span><strong>1 021</strong><small>обращение за период</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Меньше масштаба.<br/>Больше дисциплины.</h2><p class="statement">При ограниченном бюджете каждая гипотеза должна быстро доказывать свою ценность.</p><p>Поэтому Meta оптимизировалась не ради охвата, а вокруг стоимости и количества реальных обращений.</p></div></div></div></section>
</RuCaseLayout>