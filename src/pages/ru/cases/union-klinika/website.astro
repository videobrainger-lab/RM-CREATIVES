---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/union-klinika/meta-ads',label:'META ADS',copy:'Стабильный поток обращений при ограниченном бюджете.'},{href:'/ru/cases/union-klinika/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/union-klinika/website',label:'WEBSITE',copy:'Практичный сайт вокруг пути пациента.'}];
---
<RuCaseLayout title="Union Klinika — сайт" description="Как Union Klinika получила практичный сайт, построенный вокруг пути пациента и задач привлечения." client="UNION KLINIKA" clientLabel="МЕДИЦИНСКАЯ КЛИНИКА" eyebrow="WEBSITE" headline="Не огромный проект." accent="Рабочий инструмент." intro="Клинике не нужен был дорогой digital-продукт ради статуса. Нужен был понятный сайт, который поддерживает рекламу, объясняет услуги и ведёт человека к обращению." metrics={[{value:'PATIENT-FIRST',label:'структура вокруг пациента'},{value:'META + GOOGLE',label:'две рекламные точки входа'},{value:'LEAN',label:'практичный объём проекта'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Сделать сайт<br/>по делу.</h2><p class="statement">Ограниченный бюджет не означает, что сайт должен быть слабым.</p><p>Приоритет получили страницы и элементы, которые реально влияют на путь пациента: понятные услуги, доверие, контакты и короткий переход к обращению.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">PATIENT-FIRST WEBSITE</span><h2>Меньше лишнего.<br/>Больше ясности.</h2><div class="flow"><span>РЕКЛАМА / ПОИСК</span><b>→</b><span>УСЛУГА</span><b>→</b><span>ДОВЕРИЕ</span><b>→</b><span>КОНТАКТ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">АРХИТЕКТУРА</span><div><h2>Сайт как часть<br/>acquisition.</h2><p class="statement">Каждая ключевая страница должна помогать рекламному или поисковому сценарию.</p><p>Сайт проектировался вместе с будущими источниками трафика, поэтому Meta и Google не приводили людей на случайные универсальные страницы.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">META</span><strong>DISCOVERY</strong><small>создание интереса</small></div><div class="proof"><span class="eyebrow">GOOGLE</span><strong>INTENT</strong><small>захват готового спроса</small></div><div class="proof"><span class="eyebrow">WEBSITE</span><strong>ACTION</strong><small>путь к обращению</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Сайт должен<br/>решать задачу.</h2><p class="statement">Не количество страниц делает сайт сильным, а то, насколько хорошо они поддерживают путь пациента.</p><p>Для Union Klinika мы сознательно строили компактный и практичный digital-фундамент вместо перегруженного проекта.</p></div></div></div></section>
</RuCaseLayout>