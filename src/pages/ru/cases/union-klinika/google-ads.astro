---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/union-klinika/meta-ads',label:'META ADS',copy:'Стабильный поток обращений при ограниченном бюджете.'},{href:'/ru/cases/union-klinika/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/union-klinika/website',label:'WEBSITE',copy:'Практичный сайт вокруг пути пациента.'}];
---
<RuCaseLayout title="Union Klinika — Google Ads" description="Как Google Ads помогали Union Klinika забирать существующий спрос пациентов в рамках общей системы привлечения." client="UNION KLINIKA" clientLabel="МЕДИЦИНСКАЯ КЛИНИКА" eyebrow="GOOGLE ADS" headline="Пациенты уже ищут." accent="Нужно быть рядом." intro="Поисковая реклама дополняла Meta, перехватывая людей, которые уже сформулировали запрос на врача, услугу или консультацию." metrics={[{value:'SEARCH',label:'готовый спрос'},{value:'HIGH INTENT',label:'пациенты ближе к решению'},{value:'1 SYSTEM',label:'в связке с Meta и сайтом'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Не пропускать<br/>горячий спрос.</h2><p class="statement">Если пациент уже ищет услугу, клиника должна быть видна именно в этот момент.</p><p>Google Ads использовался как канал захвата сформированного намерения и направлял человека на релевантные страницы сайта.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">SEARCH JOURNEY</span><h2>Запрос.<br/>Ответ. Обращение.</h2><div class="flow"><span>ПАЦИЕНТ ИЩЕТ</span><b>→</b><span>GOOGLE ADS</span><b>→</b><span>СТРАНИЦА УСЛУГИ</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">РОЛЬ КАНАЛА</span><div><h2>Meta создаёт.<br/>Google забирает.</h2><p class="statement">Сильная система не заставляет один канал делать всё.</p><p>Meta помогала создавать дополнительный интерес, а Google ловил тех, кто уже находился в активной фазе выбора. Сайт соединял оба источника в единый patient journey.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">DISCOVERY</span><strong>META</strong><small>создание спроса</small></div><div class="proof"><span class="eyebrow">INTENT</span><strong>GOOGLE</strong><small>готовый спрос</small></div><div class="proof"><span class="eyebrow">CONVERSION</span><strong>WEB</strong><small>точка обращения</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Не выбирать<br/>между каналами.</h2><p class="statement">Разные источники отвечают на разные стадии спроса.</p><p>Вместо попытки найти один «лучший» канал мы распределяли роли между Meta, Google и сайтом.</p></div></div></div></section>
</RuCaseLayout>