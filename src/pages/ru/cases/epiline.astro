1.4fr .7fr;gap:50px}.seo-head h2{font-size:clamp(48px,6vw,92px);line-height:.92;letter-spacing:-.06em;margin:0}.rankings{margin-top:90px;border-top:1px solid rgba(255,255,255,.45)}.rankings div{display:flex;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.45);padding:18px 0;font-size:clamp(20px,2.2vw,34px)}.website{padding:150px 0}.crm{padding:140px 0}.crm>div>h2{margin-top:35px}.crm-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.flow{display:flex;flex-direction:column;text-align:center;gap:9px}.flow span{border:1px solid #444;padding:18px;font-family:monospace;font-size:11px}.flow span:nth-of-type(3){background:var(--accent);color:white}.flow b{font-weight:400;color:#666}.conclusion{padding:160px 0}.conclusion>p{font-size:24px;line-height:1.45;max-width:900px;color:var(--muted)}.timeline{display:flex;align-items:center;gap:20px;margin:100px 0 60px}.timeline strong{font-size:clamp(45px,6vw,90px);letter-spacing:-.06em}.timeline i{height:1px;background:var(--ink);flex:1}.conclusion h3{font-size:clamp(40px,5vw,76px);line-height:1;letter-spacing:-.055em}.related{padding:130px 0;border-top:1px solid var(--line)}.related-head{display:grid;grid-template-columns:.7fr 2fr;gap:70px}.related-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.related-grid>a{min-height:330px;border:1px solid var(--line);padding:22px;display:flex;flex-direction:column}.related-grid>a:first-child{background:var(--accent);color:white}.related h3{font-size:25px;line-height:1.05;letter-spacing:-.04em;margin:50px 0 16px}.related p{font-size:13px;line-height:1.5;color:var(--muted)}.soon{margin-top:auto;border-top:1px solid currentColor;padding-top:12px}.cta{padding:150px 0 180px;border-top:1px solid var(--line)}.cta h2{font-size:clamp(60px,9vw,140px);line-height:.86;letter-spacing:-.07em;margin:40px 0 70px}.cta>a{font-size:20px;border-bottom:1px solid var(--ink)}@media(max-width:800px){.intro,.story,.split,.seo-head,.crm-grid,.related-head{grid-template-columns:1fr}.metric-grid{grid-template-columns:1fr 1fr}.related-grid{grid-template-columns:1fr}.tags{text-align:left}.story,.channel,.website,.crm,.conclusion,.related{padding-top:90px;padding-bottom:90px}}
