---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/epiline/meta-ads',label:'META ADS',copy:'Масштабирование paid social с контролем CPL.'},{href:'/ru/cases/epiline/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/epiline/seo',label:'SEO',copy:'Небрендовая органическая видимость на двух языках.'},{href:'/ru/cases/epiline/website',label:'WEBSITE',copy:'Новый двуязычный сайт без потери SEO.'}];
---
<RuCaseLayout title="Epiline — Meta Ads" description="Как Epiline получила 2 970 обращений из Meta Ads за январь–август 2026 при средневзвешенном CPL €5,85." client="EPILINE" clientLabel="ЭСТЕТИЧЕСКАЯ МЕДИЦИНА" eyebrow="META ADS" headline="Масштабировать." accent="Не потерять контроль." intro="Рост объёма часто поднимает стоимость лида. Для Epiline Meta строилась как постоянно управляемая система: офферы, креативы и аудитории тестировались месяц за месяцем." metrics={[{value:'2 970',label:'обращений / янв–авг 2026'},{value:'€5,85',label:'средневзвешенный CPL'},{value:'509',label:'максимум обращений за месяц'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Расти<br/>без хаоса.</h2><p class="statement">Масштаб — это не просто больше бюджета. Это больше точек, где эффективность может сломаться.</p><p>Поэтому работа шла через регулярный цикл тестирования: гипотеза, креатив, оффер, результат, перераспределение бюджета.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">META ADS / ЯНВ–АВГ 2026</span><h2>2 970 обращений.<br/>CPL €5,85.</h2><div class="flow"><span>КРЕАТИВ</span><b>→</b><span>ОФФЕР</span><b>→</b><span>АУДИТОРИЯ</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">ДИНАМИКА</span><div><h2>Не один удачный месяц.<br/>Система.</h2><p class="statement">Ценность канала — в повторяемости результата.</p><p>В течение восьми месяцев объём менялся, но канал сохранял рабочую экономику. Пиковый месяц дал 509 обращений.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">ЯНВАРЬ</span><strong>327</strong><small>обращений · €4,92 CPL</small></div><div class="proof"><span class="eyebrow">ИЮЛЬ</span><strong>509</strong><small>обращений · €5,64 CPL</small></div><div class="proof"><span class="eyebrow">8 МЕСЯЦЕВ</span><strong>2 970</strong><small>обращений всего</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Креатив —<br/>часть системы.</h2><p class="statement">В Meta результат нельзя отделить от качества оффера и скорости тестирования.</p><p>Поэтому мы не относились к рекламе как к настройке один раз. Канал постоянно обновлялся и адаптировался под реальные данные.</p></div></div></div></section>
</RuCaseLayout>