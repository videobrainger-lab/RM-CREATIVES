---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/epiline/meta-ads',label:'META ADS',copy:'Масштабирование paid social с контролем CPL.'},{href:'/ru/cases/epiline/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/epiline/seo',label:'SEO',copy:'Небрендовая органическая видимость на двух языках.'},{href:'/ru/cases/epiline/website',label:'WEBSITE',copy:'Новый двуязычный сайт без потери SEO.'}];
---
<RuCaseLayout title="Epiline — CRM и запись" description="Как Epiline связала рекламу, сайт, Kommo CRM, WhatsApp и Altegio в единую систему обработки обращений." client="EPILINE" clientLabel="ЭСТЕТИЧЕСКАЯ МЕДИЦИНА" eyebrow="CRM / BOOKING" headline="Лид — ещё" accent="не результат." intro="Маркетинг может привести обращение, но клиника всё равно потеряет пациента после формы. Поэтому acquisition-система продолжалась дальше рекламы — в CRM, коммуникации и онлайн-записи." metrics={[{value:'KOMMO',label:'CRM'},{value:'WHATSAPP',label:'коммуникация'},{value:'ALTEGIO',label:'онлайн-запись'},{value:'1 FLOW',label:'единый путь пациента'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Не терять<br/>обращения после рекламы.</h2><p class="statement">Стоимость лида ничего не значит, если дальше пациент проваливается между системами.</p><p>Нужно было связать источник обращения, контакт менеджера, переписку и запись так, чтобы путь пациента был виден и управляем.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">PATIENT FLOW</span><h2>От рекламы<br/>до визита.</h2><div class="flow"><span>ADS / WEBSITE</span><b>→</b><span>KOMMO</span><b>→</b><span>WHATSAPP</span><b>→</b><span>FOLLOW-UP</span><b>→</b><span>ALTEGIO</span><b>→</b><span>ВИЗИТ</span><b>→</b><span>ПОВТОР</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">СИСТЕМА</span><div><h2>Один путь<br/>вместо разрозненных сервисов.</h2><p class="statement">CRM должна помогать клинике видеть, что происходит с каждым обращением.</p><p>Связка Kommo, WhatsApp и Altegio позволила выстроить последовательный процесс: новый лид фиксируется, получает ответ, переводится в запись и дальше может отслеживаться до визита и повторного контакта.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">CRM</span><strong>KOMMO</strong><small>центральная точка лида</small></div><div class="proof"><span class="eyebrow">DIALOGUE</span><strong>WA</strong><small>оперативная коммуникация</small></div><div class="proof"><span class="eyebrow">BOOKING</span><strong>ALTEGIO</strong><small>переход к записи</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Маркетинг не заканчивается<br/>на CPL.</h2><p class="statement">Настоящий результат появляется тогда, когда обращение доходит до записи и визита.</p><p>Поэтому мы рассматриваем post-lead процесс как часть acquisition-системы, а не как отдельную внутреннюю проблему клиники.</p></div></div></div></section>
</RuCaseLayout>