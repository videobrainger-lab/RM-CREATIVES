---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/epiline/meta-ads',label:'META ADS',copy:'Масштабирование paid social с контролем CPL.'},{href:'/ru/cases/epiline/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/epiline/seo',label:'SEO',copy:'Небрендовая органическая видимость на двух языках.'},{href:'/ru/cases/epiline/website',label:'WEBSITE',copy:'Новый двуязычный сайт без потери SEO.'}];
---
<RuCaseLayout title="Epiline — Google Ads" description="Как Epiline получила 1 343 конверсии из Google Ads за январь–август 2026 при средневзвешенном CPA $5,35." client="EPILINE" clientLabel="ЭСТЕТИЧЕСКАЯ МЕДИЦИНА" eyebrow="GOOGLE ADS" headline="Спрос уже есть." accent="Нужно его забрать." intro="Пациенты уже искали услуги клиники. Задача — связать поисковое намерение с релевантными посадочными и измерять не клики, а реальные конверсии." metrics={[{value:'1 343',label:'конверсии / янв–авг 2026'},{value:'$5,35',label:'средневзвешенный CPA'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Не терять<br/>готовый спрос.</h2><p class="statement">Когда человек уже ищет процедуру, реклама должна привести его максимально близко к решению.</p><p>Кампании сегментировались по услугам и намерению, чтобы запрос, объявление и посадочная страница говорили об одном и том же.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">GOOGLE ADS / ЯНВ–АВГ 2026</span><h2>1 343 конверсии<br/>при CPA $5,35.</h2><div class="flow"><span>ПОИСКОВЫЙ ЗАПРОС</span><b>→</b><span>РЕЛЕВАНТНОЕ ОБЪЯВЛЕНИЕ</span><b>→</b><span>ПОСАДОЧНАЯ</span><b>→</b><span>КОНВЕРСИЯ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">ПОДХОД</span><div><h2>Клик —<br/>не результат.</h2><p class="statement">Оптимизация строилась вокруг конверсий, а не дешёвого трафика.</p><p>Это позволяло оценивать поисковые кампании по бизнес-результату и направлять бюджет туда, где намерение пациента было наиболее сильным.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">КОНВЕРСИИ</span><strong>1 343</strong><small>январь–август 2026</small></div><div class="proof"><span class="eyebrow">CPA</span><strong>$5,35</strong><small>средневзвешенное значение</small></div><div class="proof"><span class="eyebrow">СВЯЗКА</span><strong>QUERY</strong><small>→ ad → page → conversion</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Реклама должна<br/>продолжать поиск.</h2><p class="statement">Чем точнее ответ на намерение пациента, тем меньше лишнего трения.</p><p>Поэтому Google Ads работал не отдельно от сайта, а как продолжение поискового сценария пациента.</p></div></div></div></section>
</RuCaseLayout>