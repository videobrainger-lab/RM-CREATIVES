---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/epiline/meta-ads',label:'META ADS',copy:'Масштабирование paid social с контролем CPL.'},{href:'/ru/cases/epiline/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/epiline/seo',label:'SEO',copy:'Небрендовая органическая видимость на двух языках.'},{href:'/ru/cases/epiline/website',label:'WEBSITE',copy:'Новый двуязычный сайт без потери SEO.'}];
---
<RuCaseLayout title="Epiline — SEO" description="Как Epiline построила небрендовую органическую видимость на двух языках и получила 275 органических обращений." client="EPILINE" clientLabel="ЭСТЕТИЧЕСКАЯ МЕДИЦИНА" eyebrow="SEO / ORGANIC" headline="Не только бренд." accent="Реальный спрос." intro="Клинике нужна была видимость не только по собственному названию, но и по запросам пациентов, которые ищут процедуры и решения. SEO строилось на двух языках и было связано с новой архитектурой сайта." metrics={[{value:'TOP 10',label:'поисковая видимость'},{value:'275',label:'органических обращений'},{value:'2 150+',label:'небрендовых кликов'},{value:'2',label:'языка'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Стать заметными<br/>до выбора бренда.</h2><p class="statement">Большая часть ценного спроса начинается не с названия клиники, а с вопроса или услуги.</p><p>Мы выстраивали страницы вокруг реального поискового намерения: процедуры, проблемы и информационные запросы должны были приводить пациента в экосистему Epiline.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">ORGANIC / NON-BRAND</span><h2>2 150+ небрендовых<br/>кликов.</h2><div class="flow"><span>ПОИСКОВЫЙ СПРОС</span><b>→</b><span>GOOGLE</span><b>→</b><span>СТРАНИЦА УСЛУГИ</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">АРХИТЕКТУРА</span><div><h2>SEO на<br/>двух языках.</h2><p class="statement">Двуязычный сайт — это две полноценные поисковые структуры, а не один сайт с переводом.</p><p>Страницы, технические настройки и внутренняя структура выстраивались так, чтобы обе языковые версии могли независимо набирать поисковую видимость.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">ВИДИМОСТЬ</span><strong>TOP 10</strong><small>по целевым запросам</small></div><div class="proof"><span class="eyebrow">ОРГАНИКА</span><strong>275</strong><small>обращений</small></div><div class="proof"><span class="eyebrow">ЯЗЫКИ</span><strong>2</strong><small>полноценные SEO-версии</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>SEO должно<br/>ловить спрос.</h2><p class="statement">Позиции важны только тогда, когда они приводят релевантных людей.</p><p>Поэтому видимость оценивалась вместе с небрендовым трафиком и обращениями, а не отдельно от них.</p></div></div></div></section>
</RuCaseLayout>