---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/epiline/meta-ads',label:'META ADS',copy:'Масштабирование paid social с контролем CPL.'},{href:'/ru/cases/epiline/google-ads',label:'GOOGLE ADS',copy:'Захват существующего спроса пациентов.'},{href:'/ru/cases/epiline/seo',label:'SEO',copy:'Небрендовая органическая видимость на двух языках.'},{href:'/ru/cases/epiline/website',label:'WEBSITE',copy:'Новый двуязычный сайт без потери SEO.'}];
---
<RuCaseLayout title="Epiline — сайт" description="Как Epiline получила новый двуязычный сайт на 44 страницы с SEO-миграцией и сохранением ключевой поисковой видимости." client="EPILINE" clientLabel="ЭСТЕТИЧЕСКАЯ МЕДИЦИНА" eyebrow="WEBSITE" headline="Пересобрать сайт." accent="Не потерять SEO." intro="Старый сайт имел технические и UX-проблемы, но уже обладал ценной поисковой видимостью. Новый проект нужно было запустить без обнуления накопленного органического капитала." metrics={[{value:'44',label:'страницы / обе языковые версии'},{value:'2',label:'языка'},{value:'4 мес',label:'срок реализации'},{value:'TOP 5',label:'ключевая видимость сохранена'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Новый сайт<br/>без SEO-обнуления.</h2><p class="statement">Редизайн не должен уничтожать то, что уже работает в поиске.</p><p>Мы пересобрали структуру, UX и страницы, одновременно планируя перенос URL, метаданных и редиректов, чтобы сохранить поисковую ценность старого сайта.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">WEBSITE / MIGRATION</span><h2>44 страницы.<br/>2 языка.</h2><div class="flow"><span>СТАРЫЙ САЙТ</span><b>→</b><span>КАРТА URL</span><b>→</b><span>НОВАЯ АРХИТЕКТУРА</span><b>→</b><span>301 REDIRECTS</span><b>→</b><span>ЗАПУСК</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">МИГРАЦИЯ</span><div><h2>Сохранить<br/>поисковый капитал.</h2><p class="statement">При переезде сайта каждая ценная старая страница должна понимать, куда она переезжает.</p><p>Мы подготовили SEO-миграцию, настроили редиректы и перенесли структуру так, чтобы пользователи и поисковые системы не попадали в тупики после запуска.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">СТРУКТУРА</span><strong>44</strong><small>страницы в двух языковых версиях</small></div><div class="proof"><span class="eyebrow">СРОК</span><strong>4 мес</strong><small>от структуры до запуска</small></div><div class="proof"><span class="eyebrow">SEO</span><strong>TOP 5</strong><small>ключевая видимость сохранена</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Редизайн —<br/>не старт с нуля.</h2><p class="statement">Хорошая миграция сохраняет накопленный спрос и одновременно улучшает продукт.</p><p>Новый сайт Epiline стал сильнее визуально и функционально, не отказываясь от уже заработанной поисковой видимости.</p></div></div></div></section>
</RuCaseLayout>