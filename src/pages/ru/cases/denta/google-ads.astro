---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/denta/google-ads',label:'GOOGLE ADS',copy:'Масштабирование горячего стоматологического спроса.'},{href:'/ru/cases/denta/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса за пределами поиска.'},{href:'/ru/cases/denta/seo',label:'SEO',copy:'Органическое привлечение и видимость в TOP-5.'},{href:'/ru/cases/denta/website',label:'WEBSITE',copy:'Сайт как инфраструктура для рекламы и органики.'}];
---
<RuCaseLayout title="Denta — Google Ads" description="Как Denta масштабировала горячий поисковый спрос и получила 10 601 конверсию в 2025 году." client="DENTA" clientLabel="СТОМАТОЛОГИЯ" eyebrow="GOOGLE ADS" headline="Горячий спрос." accent="Под контролем." intro="Стоматологический поиск ценен: пациент уже ищет решение. Задача была масштабировать этот спрос без потери управляемости по стоимости конверсии." metrics={[{value:'10 601',label:'конверсия / 2025'},{value:'€2,07',label:'средневзвешенный CPA / 2025'},{value:'8 087',label:'конверсий / янв–авг 2026'},{value:'€2,76',label:'средневзвешенный CPA / янв–авг 2026'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Не просто покупать<br/>клики.</h2><p class="statement">Поиск должен приводить людей, которые готовы сделать следующий шаг.</p><p>Кампании строились вокруг намерения пациента: услуги, симптомы, лечение и конкретные запросы разделялись так, чтобы бюджет не растворялся в широком трафике.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">GOOGLE ADS / 2025</span><h2>10 601 конверсия<br/>при CPA €2,07.</h2><div class="flow"><span>ЗАПРОС</span><b>→</b><span>РЕКЛАМА</span><b>→</b><span>РЕЛЕВАНТНАЯ СТРАНИЦА</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">МАСШТАБ</span><div><h2>Рост без<br/>потери структуры.</h2><p class="statement">Чем больше объём, тем важнее сегментация и контроль.</p><p>Мы отслеживали стоимость и объём конверсий по направлениям, перераспределяя бюджет в пользу кампаний, которые давали более качественный и предсказуемый результат.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">2025</span><strong>10 601</strong><small>конверсия</small></div><div class="proof"><span class="eyebrow">2025</span><strong>€2,07</strong><small>средневзвешенный CPA</small></div><div class="proof"><span class="eyebrow">2026 / ЯНВ–АВГ</span><strong>8 087</strong><small>конверсий</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Структура<br/>важнее объёма.</h2><p class="statement">Сильная поисковая реклама начинается не со ставок, а с понимания намерения пациента.</p><p>Именно поэтому кампании можно масштабировать без превращения Google Ads в дорогой источник случайных переходов.</p></div></div></div></section>
</RuCaseLayout>