---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/denta/google-ads',label:'GOOGLE ADS',copy:'Масштабирование горячего стоматологического спроса.'},{href:'/ru/cases/denta/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса за пределами поиска.'},{href:'/ru/cases/denta/seo',label:'SEO',copy:'Органическое привлечение и видимость в TOP-5.'},{href:'/ru/cases/denta/website',label:'WEBSITE',copy:'Сайт как инфраструктура для рекламы и органики.'}];
---
<RuCaseLayout title="Denta — сайт" description="Как сайт Denta стал инфраструктурой для платного и органического привлечения пациентов." client="DENTA" clientLabel="СТОМАТОЛОГИЯ" eyebrow="WEBSITE" headline="Сайт — не витрина." accent="Это инфраструктура." intro="Реклама и SEO не могут работать сильнее посадочной среды. Поэтому сайт Denta пересобирался вокруг услуг, поискового спроса и короткого пути пациента к обращению." metrics={[{value:'16 227',label:'отслеживаемых обращений / 2025'},{value:'TOP 5',label:'поисковая видимость'},{value:'4',label:'связанных канала роста'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Свести каналы<br/>в одну точку.</h2><p class="statement">Google, Meta и SEO приводят людей. Сайт должен превращать этот трафик в действие.</p><p>Структура строилась вокруг понятных услуг, релевантных посадочных страниц и логичного следующего шага для пациента.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">PATIENT JOURNEY</span><h2>Меньше трения.<br/>Ближе к обращению.</h2><div class="flow"><span>РЕКЛАМА / ПОИСК</span><b>→</b><span>НУЖНАЯ УСЛУГА</span><b>→</b><span>ДОВЕРИЕ</span><b>→</b><span>КОНТАКТ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">РОЛЬ САЙТА</span><div><h2>Один фундамент<br/>для всех каналов.</h2><p class="statement">Сильный сайт улучшает не один канал, а всю систему привлечения.</p><p>Поисковая реклама получает релевантные посадочные, SEO — правильную архитектуру и контентную базу, Meta — понятную точку приземления для заинтересованного пациента.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">GOOGLE ADS</span><strong>10 601</strong><small>конверсия / 2025</small></div><div class="proof"><span class="eyebrow">SEO</span><strong>3 831</strong><small>органическое обращение / 2025</small></div><div class="proof"><span class="eyebrow">META</span><strong>1 639</strong><small>обращений / 2025</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Сайт работает<br/>внутри системы.</h2><p class="statement">Красивый интерфейс сам по себе не является результатом.</p><p>Его задача — поддерживать acquisition: помогать пациенту понять предложение, довериться клинике и сделать следующий шаг.</p></div></div></div></section>
</RuCaseLayout>