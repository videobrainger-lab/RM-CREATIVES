---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[
 {href:'/ru/cases/denta/google-ads',label:'GOOGLE ADS',copy:'Масштабирование горячего стоматологического спроса.'},
 {href:'/ru/cases/denta/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса за пределами поиска.'},
 {href:'/ru/cases/denta/seo',label:'SEO',copy:'Органическое привлечение и видимость в TOP-5.'},
 {href:'/ru/cases/denta/website',label:'WEBSITE',copy:'Сайт как инфраструктура для рекламы и органики.'}
];
---
<RuCaseLayout title="Denta — SEO" description="Как Denta превратила SEO в полноценный канал привлечения и достигла видимости в TOP-5." client="DENTA" clientLabel="СТОМАТОЛОГИЯ" eyebrow="SEO / ORGANIC" headline="Трафик — это хорошо." accent="Обращения — лучше." intro="SEO рассматривали не как работу ради позиций, а как ещё одну систему привлечения пациентов. Видимость, полезные страницы и новый сайт должны были давать измеримые органические обращения." metrics={[{value:'TOP 5',label:'достигнутая поисковая видимость'},{value:'3 831',label:'органических обращений / 2025'},{value:'2 680',label:'органических обращений / янв–авг 2026'},{value:'500',label:'органических обращений / апрель 2025'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Забрать больше<br/>поискового спроса.</h2><p class="statement">Платный поиск арендует видимость. SEO создаёт актив, который продолжает работать.</p><p>Нужно было связать позиции в Google со страницами, которые отвечают на реальный запрос пациента и превращают внимание в звонки и обращения.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">ОРГАНИЧЕСКОЕ ПРИВЛЕЧЕНИЕ / 2025</span><h2>3 831 органическое<br/>обращение за год.</h2><div class="flow"><span>ВОПРОС ПАЦИЕНТА</span><b>→</b><span>GOOGLE</span><b>→</b><span>СТРАНИЦА DENTA</span><b>→</b><span>ОРГАНИЧЕСКИЙ ВИЗИТ</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">ВИДИМОСТЬ</span><div><h2>Войти<br/>в TOP 5.</h2><p class="statement">Проект вышел в TOP-5 по поисковой видимости, а органика стала заметным источником обращений.</p><p>Отчётность показывает сотни отслеживаемых органических обращений в месяц в 2025 и 2026 годах. В апреле 2025 канал дал 500 обращений.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">2024</span><strong>1 239</strong><small>органических обращений</small></div><div class="proof"><span class="eyebrow">2025</span><strong>3 831</strong><small>органических обращений</small></div><div class="proof"><span class="eyebrow">2026 / ЯНВ–АВГ</span><strong>2 680</strong><small>органических обращений</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Позиции —<br/>не финиш.</h2><p class="statement">Видимость имеет смысл только тогда, когда создаёт новый путь пациента в клинику.</p><p>Поэтому результат SEO здесь оценивается не только по позициям, но и по обращениям. Именно их сочетание показывает реальную бизнес-ценность канала.</p></div></div></div></section>
</RuCaseLayout>