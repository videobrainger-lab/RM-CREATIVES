---
import RuCaseLayout from '../../../../layouts/RuCaseLayout.astro';
const related=[{href:'/ru/cases/denta/google-ads',label:'GOOGLE ADS',copy:'Масштабирование горячего стоматологического спроса.'},{href:'/ru/cases/denta/meta-ads',label:'META ADS',copy:'Создание дополнительного спроса за пределами поиска.'},{href:'/ru/cases/denta/seo',label:'SEO',copy:'Органическое привлечение и видимость в TOP-5.'},{href:'/ru/cases/denta/website',label:'WEBSITE',copy:'Сайт как инфраструктура для рекламы и органики.'}];
---
<RuCaseLayout title="Denta — Meta Ads" description="Как Meta Ads стали для Denta предсказуемым каналом привлечения пациентов." client="DENTA" clientLabel="СТОМАТОЛОГИЯ" eyebrow="META ADS" headline="Спрос можно" accent="создавать." intro="Google забирает уже существующий спрос. Meta позволила расширить воронку и получать обращения от людей, которые ещё не начали активно искать стоматологию." metrics={[{value:'1 639',label:'обращений / 2025'},{value:'€7,35',label:'средневзвешенный CPL / 2025'},{value:'1 902',label:'обращения / янв–авг 2026'},{value:'€6,10',label:'CPL / янв–авг 2026'}]} related={related}>
<section class="case-section shell"><div class="two"><span class="eyebrow">ЗАДАЧА</span><div><h2>Расширить<br/>источник спроса.</h2><p class="statement">Если полагаться только на поиск, рост ограничен тем, сколько людей уже ищут услугу.</p><p>Meta использовалась как отдельный канал создания интереса: через офферы, креативы и воронки обращения мы находили потенциальных пациентов раньше поискового запроса.</p></div></div></section>
<section class="accent-section"><div class="shell"><span class="eyebrow">META ADS / ЯНВ–АВГ 2026</span><h2>1 902 обращения<br/>при CPL €6,10.</h2><div class="flow"><span>КРЕАТИВ</span><b>→</b><span>ИНТЕРЕС</span><b>→</b><span>ОФФЕР</span><b>→</b><span>ОБРАЩЕНИЕ</span></div></div></section>
<section class="case-section shell"><div class="two"><span class="eyebrow">СИСТЕМА</span><div><h2>Тестировать.<br/>Сравнивать. Масштабировать.</h2><p class="statement">Paid social становится предсказуемым только при постоянном тестировании.</p><p>Креативы и офферы регулярно обновлялись, а бюджет переносился в связки, которые давали лучший баланс объёма и стоимости обращения.</p></div></div><div class="proof-grid"><div class="proof"><span class="eyebrow">2025</span><strong>1 639</strong><small>обращений</small></div><div class="proof"><span class="eyebrow">2025</span><strong>€7,35</strong><small>средневзвешенный CPL</small></div><div class="proof"><span class="eyebrow">2026 / ЯНВ–АВГ</span><strong>1 902</strong><small>обращения</small></div></div></section>
<section class="case-section dark"><div class="shell"><div class="two"><span class="eyebrow">ПРИНЦИП</span><div><h2>Не ждать,<br/>пока вас найдут.</h2><p class="statement">Meta даёт клинике возможность самой создавать новый спрос.</p><p>В связке с Google и SEO это снижает зависимость от одного канала и делает acquisition-систему устойчивее.</p></div></div></div></section>
</RuCaseLayout>