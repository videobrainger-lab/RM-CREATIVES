---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const stories=[
 {href:'/ru/cases/consilium-medicum/google-ads',tag:'GOOGLE ADS',metric:'3 356',unit:'отслеживаемых конверсий',title:'Забирать существующий спрос пациентов.',copy:'Главная performance-история: Google Search со средней стоимостью конверсии €3,25.'},
 {href:'/ru/cases/consilium-medicum/medical-google-ads',tag:'MEDICAL GOOGLE ADS',metric:'POLICY',unit:'ограничения + блокировки',title:'Продолжать привлечение, когда Google ограничивает рекламу.',copy:'Операционная сторона медицинской рекламы: одобрения, ограничения, посадочные страницы и восстановление кампаний.'},
 {href:'/ru/cases/consilium-medicum/meta-ads',tag:'META ADS',metric:'META',unit:'paid social для клиники',title:'Создать ещё одну точку входа для пациентов.',copy:'Meta использовалась как дополнительный канал привлечения за пределами существующего поискового спроса.'},
 {href:'/ru/cases/consilium-medicum/seo',tag:'SEO / ORGANIC',metric:'24 632',unit:'органических клика · янв–авг 2026',title:'Забирать часть спроса из органического поиска.',copy:'Сервисные страницы и медицинский контент превратили поисковую видимость в устойчивый канал органического трафика.'}
];
---
<BaseLayout lang="ru" title="Consilium Medicum — кейс медицинской клиники | RM CREATIVES" description="Завершённый проект Consilium Medicum: Google Ads, ограничения медицинской рекламы, Meta Ads и SEO. 3 356 конверсий Google Ads в 2024 году.">
<main><section class="hero shell"><div class="crumb eyebrow"><a href="/ru/cases">КЕЙСЫ</a><span> / CONSILIUM MEDICUM</span></div><div class="hero-grid"><div><span class="eyebrow">МЕДИЦИНСКАЯ КЛИНИКА / ЗАВЕРШЁННЫЙ ПРОЕКТ</span><h1>Одна клиника.<br/><em>Четыре истории роста.</em></h1></div><div><p>Consilium Medicum был долгосрочным проектом RM, который завершился в 2026 году. Вместо того чтобы сжать годы работы в одну карточку с логотипом, мы показываем отдельные задачи, которые решали в Google Ads, медицинских ограничениях, Meta и органическом поиске.</p><span class="eyebrow">ПРОЕКТ ЗАВЕРШЁН / 2026</span></div></div></section>
<section class="stories shell">{stories.map((s,i)=><a class:list={['story',i===0&&'featured']} href={s.href}><div class="top"><span class="eyebrow">{String(i+1).padStart(2,'0')} / {s.tag}</span><b>ОТКРЫТЬ КЕЙС ↗</b></div><div class="metric"><strong>{s.metric}</strong><small>{s.unit}</small></div><div class="copy"><h2>{s.title}</h2><p>{s.copy}</p></div></a>)}</section>
<section class="proof dark"><div class="shell"><span class="eyebrow">ДАННЫЕ ПРОЕКТА</span><h2>Разные каналы.<br/>Одна бизнес-задача.</h2><div class="flow"><span>GOOGLE SEARCH</span><b>+</b><span>META</span><b>+</b><span>ORGANIC</span><b>→</b><span>ОБРАЩЕНИЯ ПАЦИЕНТОВ</span></div><p>Там, где не было сквозной атрибуции от CRM до визита, мы не превращаем обращения в придуманные цифры пациентов или выручки. Каждый подкейс показывает ровно то, что реально измерялось.</p></div></section>
</main></BaseLayout>
<style>.hero{padding:38px 0 110px}.crumb{padding-bottom:16px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.45fr .55fr;gap:80px;padding:90px 0 20px;align-items:end}.hero h1{font-size:clamp(62px,8vw,126px);line-height:.86;letter-spacing:-.07em;margin:18px 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero-grid p{font-size:17px;line-height:1.55;color:var(--muted)}.stories{padding-bottom:140px}.story{display:grid;grid-template-columns:.6fr .8fr 1fr;gap:40px;min-height:420px;padding:30px 0;border-top:1px solid var(--line);color:inherit}.story:last-child{border-bottom:1px solid var(--line)}.top{display:flex;flex-direction:column;justify-content:space-between}.top b{font:10px monospace}.metric{display:flex;flex-direction:column;justify-content:center}.metric strong{font-size:clamp(60px,8vw,120px);letter-spacing:-.075em;line-height:.85}.metric small{font:10px monospace;color:var(--muted);margin-top:15px}.copy{display:flex;flex-direction:column;justify-content:flex-end}.copy h2{font-size:clamp(34px,4vw,58px);line-height:.95;letter-spacing:-.05em;margin:0 0 22px}.copy p{font-size:14px;line-height:1.55;color:var(--muted);max-width:450px}.story.featured .metric strong{color:var(--accent)}.proof{padding:130px 0}.proof h2{font-size:clamp(52px,7vw,100px);line-height:.9;letter-spacing:-.065em}.proof p{max-width:650px;color:#888;font-size:13px;line-height:1.6;margin-top:50px}.flow{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font:10px monospace}.flow span{border:1px solid #444;padding:12px}@media(max-width:800px){.hero-grid,.story{grid-template-columns:1fr}.story{min-height:0;padding:35px 0}.top{gap:30px}.metric{padding:35px 0}.stories{padding-bottom:90px}.proof{padding:90px 0}}</style>