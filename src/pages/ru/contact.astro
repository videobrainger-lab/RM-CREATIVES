---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsentCheckbox from '../../components/ConsentCheckbox.astro';
---
<BaseLayout lang="ru" title="Обсудить проект | RM CREATIVES" description="Расскажите RM CREATIVES о вашей клинике и задаче по привлечению пациентов.">
  <main class="contact shell">
    <div class="intro">
      <span class="eyebrow">НАЧАТЬ ПРОЕКТ / RM CREATIVES</span>
      <h1>Поговорим.</h1>
      <p>Расскажите немного о вашей клинике и задаче. Мы изучим информацию и свяжемся с вами.</p>
    </div>
    <form name="project-enquiry-ru" method="POST" action="/ru/thank-you" data-netlify="true" netlify-honeypot="bot-field" class="form">
      <input type="hidden" name="form-name" value="project-enquiry-ru" />
      <p class="hidden"><label>Не заполняйте это поле: <input name="bot-field" /></label></p>
      <label><span>Имя *</span><input type="text" name="name" autocomplete="name" required /></label>
      <label><span>Клиника / компания *</span><input type="text" name="company" autocomplete="organization" required /></label>
      <div class="split">
        <label><span>Email *</span><input type="email" name="email" autocomplete="email" required /></label>
        <label><span data-phone-label>Телефон</span><input type="tel" name="phone" autocomplete="tel" /></label>
      </div>
      <fieldset class="contact-method">
        <legend>Как с вами удобнее связаться? *</legend>
        <div class="contact-options">
          <label><input type="radio" name="preferred_contact" value="email" required /><span>Email</span></label>
          <label><input type="radio" name="preferred_contact" value="phone" /><span>Позвонить</span></label>
          <label><input type="radio" name="preferred_contact" value="whatsapp" /><span>WhatsApp</span></label>
        </div>
        <p>Мы используем выбранный канал только для ответа на эту заявку.</p>
      </fieldset>
      <label><span>Что вас интересует? *</span><select name="service" required><option value="">Выберите</option><option value="Industry marketing">Маркетинг стоматологии / медицины / эстетики</option><option>RM Performance — Meta Ads</option><option>RM Search — Google Ads</option><option>RM Sites — сайт</option><option>Несколько продуктов</option></select></label>
      <label><span>Коротко о задаче</span><textarea name="message" rows="5"></textarea></label>
      <ConsentCheckbox lang="ru" />
      <button type="submit">Отправить заявку ↗</button>
    </form>
  </main>
</BaseLayout>
<script is:inline>
  if (new URLSearchParams(window.location.search).get('interest') === 'industry-marketing') {
    const service = document.querySelector('select[name="service"]');
    if (service) service.value = 'Industry marketing';
  }
</script>
<style>
.contact{display:grid;grid-template-columns:1fr 1fr;gap:9vw;padding:90px 0 130px;min-height:760px}.eyebrow{font-family:monospace;font-size:11px;letter-spacing:.12em}.intro h1{font-size:clamp(72px,9vw,140px);line-height:.86;letter-spacing:-.07em;margin:42px 0 34px;font-weight:600}.intro p{font-size:22px;line-height:1.35;color:var(--muted);max-width:520px}.form{border-top:1px solid var(--ink);padding-top:4px}.form>label,.split label{display:flex;flex-direction:column;border-bottom:1px solid var(--line);padding:22px 0 14px;gap:10px}.form label span,.contact-method legend{font-family:monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}input,select,textarea{width:100%;border:0;background:transparent;color:var(--ink);font:inherit;font-size:18px;padding:4px 0;outline:none;resize:vertical}select{cursor:pointer}.split{display:grid;grid-template-columns:1fr 1fr;gap:30px}.contact-method{margin:0;padding:22px 0 18px;border:0;border-bottom:1px solid var(--line)}.contact-method legend{padding:0}.contact-options{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.contact-options label{display:flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid var(--line);cursor:pointer}.contact-options input{width:auto;margin:0;accent-color:var(--ink)}.contact-options label span{font-family:inherit;font-size:15px;letter-spacing:0;text-transform:none;color:var(--ink)}.contact-method p{margin:12px 0 0;color:var(--muted);font-size:13px;line-height:1.4}button{margin-top:28px;border:0;background:var(--ink);color:var(--white);min-height:58px;padding:0 28px;font:inherit;font-weight:700;cursor:pointer}.hidden{position:absolute;left:-9999px}@media(max-width:800px){.contact{grid-template-columns:1fr;gap:60px;padding:60px 0 90px}.split{grid-template-columns:1fr}.intro h1{margin-top:30px}}
</style>
