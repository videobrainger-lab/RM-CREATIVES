---
import BaseLayout from './BaseLayout.astro';

interface Metric { value: string; label: string; }
interface SystemStep { title: string; copy: string; }
interface ServiceSection { eyebrow: string; title: string; copy: string[]; bullets?: string[]; href?: string; linkLabel?: string; tone?: 'light' | 'dark' | 'accent'; }
interface ProcessStep { title: string; copy: string; }
interface FaqItem { question: string; answer: string; }

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  intro: string;
  metrics: Metric[];
  problemIntro: string[];
  problems: string[];
  systemSteps: SystemStep[];
  serviceSections: ServiceSection[];
  reasons: string[];
  caseIntro: string[];
  process: ProcessStep[];
  faqs: FaqItem[];
  serviceName: string;
}

const {
  title, description, eyebrow, headline, intro, metrics, problemIntro, problems,
  systemSteps, serviceSections, reasons, caseIntro, process, faqs, serviceName
} = Astro.props;
---

<BaseLayout title={title} description={description} hasRuAlternate={true} serviceName={serviceName}>
  <main class="industry-page">
    <section class="industry-hero shell">
      <div class="hero-kicker eyebrow"><span>{eyebrow}</span><span>US / UK / EUROPE</span></div>
      <div class="hero-grid">
        <div>
          <h1>{headline}</h1>
          <div class="hero-actions">
            <a class="button primary" href="/contact?interest=dental-marketing">Request a demand forecast ↗</a>
            <a class="button secondary" href="/cases/denta">View the DENTA case study</a>
          </div>
        </div>
        <p>{intro}</p>
      </div>
    </section>

    <section class="proof-band" aria-label="DENTA results">
      <div class="shell metric-grid">
        {metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
      </div>
      <p class="shell proof-note">DENTA reporting, 2025. Tracked enquiries include recorded calls and lead actions across the measured acquisition system.</p>
    </section>

    <section class="section shell problem-section">
      <div class="section-label eyebrow">THE GROWTH PROBLEM</div>
      <div class="section-copy">
        <h2>A patient-acquisition system for dental clinics.</h2>
        {problemIntro.map((paragraph) => <p class="lead-copy">{paragraph}</p>)}
        <ul>{problems.map((problem) => <li>{problem}</li>)}</ul>
        <p>We bring these parts into one patient-acquisition system. The objective is not simply more traffic. It is clearer demand, stronger conversion and a measurable route from search to enquiry.</p>
      </div>
    </section>

    <section class="system-section dark-section">
      <div class="shell">
        <div class="section-head">
          <span class="eyebrow">THE SYSTEM</span>
          <h2>From demand to<br/>measurable enquiry.</h2>
        </div>
        <div class="system-grid">
          {systemSteps.map((step, index) => <article><span class="eyebrow">0{index + 1}</span><h3>{step.title}</h3><p>{step.copy}</p></article>)}
        </div>
      </div>
    </section>

    {serviceSections.map((section, index) => (
      <section class:list={['section', 'service-section', section.tone === 'dark' && 'dark-section', section.tone === 'accent' && 'accent-section']}>
        <div class="shell service-grid">
          <div class="section-label eyebrow">{section.eyebrow} / 0{index + 1}</div>
          <div class="section-copy">
            <h2>{section.title}</h2>
            {section.copy.map((paragraph) => <p class="lead-copy">{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {section.href && <a class="text-link" href={section.href}>{section.linkLabel} ↗</a>}
          </div>
        </div>
      </section>
    ))}

    <section class="section why-section">
      <div class="shell service-grid">
        <div class="section-label eyebrow">WHY RM CREATIVES</div>
        <div class="section-copy">
          <h2>One system.<br/>Clearer decisions.</h2>
          <ol class="reason-list">{reasons.map((reason, index) => <li><span>0{index + 1}</span><p>{reason}</p></li>)}</ol>
          <p>We do not promise rankings, patient volumes or revenue. We build a transparent acquisition system, test it against real demand and improve it with evidence.</p>
        </div>
      </div>
    </section>

    <section class="case-section accent-section">
      <div class="shell case-grid">
        <div>
          <span class="eyebrow">DENTA CASE STUDY</span>
          <h2>From disconnected activity to measurable patient demand.</h2>
        </div>
        <div>
          {caseIntro.map((paragraph) => <p>{paragraph}</p>)}
          <div class="case-metrics">{metrics.slice(0, 3).map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
          <a class="button dark" href="/cases/denta">View the full DENTA case study ↗</a>
        </div>
      </div>
    </section>

    <section class="section shell process-section">
      <div class="section-label eyebrow">HOW WE WORK</div>
      <div class="section-copy">
        <h2>Start with the constraint.<br/>Then build the system.</h2>
        <div class="process-list">{process.map((step, index) => <article><span class="eyebrow">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div></article>)}</div>
      </div>
    </section>

    <section class="faq-section dark-section">
      <div class="shell faq-grid">
        <div><span class="eyebrow">FAQ</span><h2>Questions before<br/>we start.</h2></div>
        <div>{faqs.map((item) => <details><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="final-cta shell">
      <span class="eyebrow">START WITH DEMAND</span>
      <h2>Turn dental demand<br/>into measurable enquiries.</h2>
      <p>We will review your treatments, target locations and current marketing signals, then outline the most credible opportunities for SEO, Google Ads and conversion.</p>
      <a class="button primary" href="/contact?interest=dental-marketing">Request a demand forecast ↗</a>
      <small>No guarantees. Clear assumptions, measurable actions and a plan built around your market.</small>
    </section>
  </main>
</BaseLayout>

<style>
  .industry-page{overflow:hidden}.industry-hero{padding:38px 0 100px}.hero-kicker{display:flex;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:7vw;align-items:end;padding-top:78px}.hero-grid h1{font-size:clamp(62px,8.8vw,136px);line-height:.85;letter-spacing:-.072em;font-weight:600;margin:0}.hero-grid>p{font-size:clamp(19px,1.8vw,26px);line-height:1.35;color:var(--muted);margin:0}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:45px}.button{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}.primary{background:var(--accent);color:white}.secondary{border:1px solid var(--line)}.dark{background:var(--dark);color:white}.proof-band{background:var(--dark);color:var(--white);padding:0 0 22px}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr)}.metric-grid>div{min-height:190px;padding:34px 24px;border-right:1px solid #303030;display:flex;flex-direction:column;justify-content:space-between}.metric-grid>div:first-child{border-left:1px solid #303030}.metric-grid strong{font-size:clamp(42px,5vw,72px);letter-spacing:-.065em}.metric-grid span,.proof-note{font-size:11px;line-height:1.4;color:#92928e}.proof-note{margin-top:20px}.section{padding:130px 0}.problem-section,.service-grid,.process-section{display:grid;grid-template-columns:.42fr 1fr;gap:8vw}.section-copy h2,.section-head h2,.case-grid h2,.faq-grid h2,.final-cta h2{font-size:clamp(48px,6.3vw,92px);line-height:.92;letter-spacing:-.06em;font-weight:550;margin:0 0 42px}.lead-copy{font-size:clamp(19px,2vw,28px);line-height:1.35;letter-spacing:-.02em}.section-copy>p:not(.lead-copy){font-size:16px;line-height:1.6;color:var(--muted)}.section-copy ul{padding:0;margin:42px 0;list-style:none;border-top:1px solid var(--line)}.section-copy li{padding:18px 0;border-bottom:1px solid var(--line);font-size:16px;line-height:1.4}.section-copy li::before{content:'→';margin-right:16px;color:var(--accent)}.dark-section{background:var(--dark);color:var(--white)}.dark-section .muted,.dark-section p{color:#a0a09b}.accent-section{background:var(--accent);color:white}.system-section{padding:130px 0}.section-head{display:grid;grid-template-columns:.42fr 1fr;gap:8vw;margin-bottom:70px}.system-grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid #333}.system-grid article{min-height:310px;padding:26px 22px;border-right:1px solid #333;display:flex;flex-direction:column}.system-grid article:first-child{border-left:1px solid #333}.system-grid h3{font-size:24px;line-height:1.1;margin:70px 0 16px}.system-grid p{font-size:14px;line-height:1.5;margin-top:auto}.service-section:nth-of-type(even){background:#e6e5df}.service-section.dark-section{background:var(--dark)}.service-section.accent-section{background:var(--accent)}.service-section.dark-section li,.service-section.accent-section li{border-color:rgba(255,255,255,.25)}.text-link{display:inline-block;margin-top:18px;padding-bottom:7px;border-bottom:1px solid currentColor;font:700 11px monospace;letter-spacing:.08em;text-transform:uppercase}.reason-list{list-style:none!important;margin-top:0!important}.reason-list li{display:grid;grid-template-columns:70px 1fr;align-items:start}.reason-list li::before{display:none}.reason-list span{font:11px monospace;color:var(--muted)}.reason-list p{margin:0;font-size:20px;line-height:1.4}.case-section{padding:130px 0}.case-grid{display:grid;grid-template-columns:1fr .72fr;gap:8vw}.case-grid p{font-size:18px;line-height:1.5}.case-metrics{margin:40px 0}.case-metrics div{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-top:1px solid rgba(255,255,255,.45)}.case-metrics strong{font-size:30px}.case-metrics span{font-size:12px;text-align:right}.process-list{border-top:1px solid var(--line)}.process-list article{display:grid;grid-template-columns:70px 1fr;gap:18px;padding:25px 0;border-bottom:1px solid var(--line)}.process-list h3{font-size:26px;margin:0 0 8px}.process-list p{margin:0;color:var(--muted);line-height:1.55}.faq-section{padding:130px 0}.faq-grid{display:grid;grid-template-columns:.75fr 1fr;gap:8vw}.faq-grid details{border-top:1px solid #333;padding:22px 0}.faq-grid details:last-child{border-bottom:1px solid #333}.faq-grid summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:20px;font-size:20px}.faq-grid summary::-webkit-details-marker{display:none}.faq-grid details p{font-size:15px;line-height:1.6;padding-right:45px;margin:18px 0 0}.final-cta{padding:140px 0}.final-cta h2{margin:25px 0 35px}.final-cta>p{max-width:700px;font-size:20px;line-height:1.45;color:var(--muted)}.final-cta small{display:block;margin-top:22px;color:var(--muted)}
  @media(max-width:900px){.hero-grid,.problem-section,.service-grid,.process-section,.section-head,.case-grid,.faq-grid{grid-template-columns:1fr}.metric-grid{grid-template-columns:repeat(2,1fr)}.system-grid{grid-template-columns:1fr 1fr}.section-label{margin-bottom:25px}.hero-grid{padding-top:55px}.hero-grid>p{max-width:720px}.case-grid{gap:40px}}
  @media(max-width:600px){.industry-hero{padding-bottom:70px}.hero-kicker span:last-child{display:none}.metric-grid,.system-grid{grid-template-columns:1fr}.metric-grid>div,.system-grid article{min-height:160px;border-left:1px solid #303030}.section,.system-section,.case-section,.faq-section,.final-cta{padding:85px 0}.hero-actions{flex-direction:column;align-items:stretch}.system-grid h3{margin-top:40px}.reason-list li,.process-list article{grid-template-columns:44px 1fr}}
</style>
