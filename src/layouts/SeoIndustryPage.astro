---
import BaseLayout from './BaseLayout.astro';
import type { IndustryPage } from '../data/industryPages';
const { page }:{page:IndustryPage}=Astro.props;
const ru=page.lang==='ru';
const contact=ru?'/ru/contact':'/contact';
const cta=ru?'Запросить прогноз спроса':'Request a demand forecast';
const caseLabel=ru?`Посмотреть кейс ${page.proofClient}`:`View the ${page.proofClient} case study`;
---
<BaseLayout title={page.title} description={page.description} lang={page.lang} hasRuAlternate={page.hasAlternate!==false} serviceName={page.eyebrow}>
<main class="seo-page">
  <section class="hero shell"><div class="kicker eyebrow"><span>{page.eyebrow}</span><span>{page.geo}</span></div><div class="hero-grid"><div><h1>{page.headline}</h1><div class="actions"><a class="btn primary" href={`${contact}?interest=industry-marketing`}>{cta} ↗</a><a class="btn secondary" href={page.proofHref}>{caseLabel}</a></div></div><p>{page.intro}</p></div></section>
  <section class="proof"><div class="shell metrics">{page.metrics.map(m=><div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div><p class="shell note">{page.proofNote}</p></section>
  <section class="content shell"><span class="eyebrow">{ru?'ЗАДАЧА':'THE CHALLENGE'}</span><div><h2>{ru?'Спрос — это начало. Нужна система.':'Demand is the start. The system creates growth.'}</h2><p class="lead">{page.challenge}</p><p>{ru?'Мы соединяем поисковый спрос, платные каналы, посадочные страницы и аналитику вокруг измеримых обращений — без обещаний гарантированного результата.':'We connect search demand, paid channels, landing pages and measurement around qualified enquiries—without promising guaranteed outcomes.'}</p></div></section>
  <section class="dark"><div class="shell content"><span class="eyebrow">{ru?'ЧТО ВХОДИТ':'WHAT WE BUILD'}</span><div><h2>{ru?'От спроса до обращения.':'From demand to enquiry.'}</h2><ol>{page.capabilities.map((x,i)=><li><b>0{i+1}</b><span>{x}</span></li>)}</ol></div></div></section>
  <section class="content shell"><span class="eyebrow">{ru?'СВЯЗАННЫЕ СТРАНИЦЫ':'CONNECTED CLUSTER'}</span><div><h2>{ru?'Один кластер. Несколько точек входа.':'One cluster. Multiple points of entry.'}</h2><div class="links">{page.related.map(x=><a href={x.href}><span>{x.label}</span><b>↗</b></a>)}</div></div></section>
  <section class="accent"><div class="shell case"><div><span class="eyebrow">{page.proofClient} / {ru?'КЕЙС':'CASE STUDY'}</span><h2>{ru?'Доказательство из реального проекта.':'Proof from a real clinic project.'}</h2></div><div><p>{ru?'Кейс показывает, как каналы, страницы и измерение работают как единая система привлечения пациентов.':'The case shows how channels, pages and measurement work together as one patient-acquisition system.'}</p><a class="btn darkbtn" href={page.proofHref}>{caseLabel} ↗</a></div></div></section>
  <section class="content shell"><span class="eyebrow">{ru?'КАК НАЧИНАЕМ':'HOW WE START'}</span><div><h2>{ru?'Диагностика. Приоритеты. План на 90 дней.':'Diagnostic. Priorities. A 90-day plan.'}</h2><p class="lead">{ru?'Сначала оцениваем спрос, текущую видимость, рекламные аккаунты, страницы и отслеживание. Затем определяем последовательность работ.':'We first assess demand, current visibility, advertising accounts, landing pages and tracking. Then we sequence the work around the highest-value constraints.'}</p></div></section>
  <section class="final shell"><span class="eyebrow">{ru?'СЛЕДУЮЩИЙ ШАГ':'NEXT STEP'}</span><h2>{ru?'Превратим спрос в измеримые обращения.':'Turn demand into measurable enquiries.'}</h2><p>{ru?'Расскажите об услугах, географии и текущем маркетинге — мы обозначим наиболее реалистичные точки роста.':'Tell us about your services, markets and current acquisition activity. We will outline the most credible growth opportunities.'}</p><a class="btn primary" href={`${contact}?interest=industry-marketing`}>{cta} ↗</a></section>
</main></BaseLayout>
<style>.seo-page{overflow:hidden}.hero{padding:38px 0 100px}.kicker{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:16px}.hero-grid,.content,.case{display:grid;grid-template-columns:1.25fr .75fr;gap:8vw;align-items:end}.hero-grid{padding-top:78px}.hero h1,.content h2,.case h2,.final h2{font-size:clamp(52px,7.5vw,112px);line-height:.88;letter-spacing:-.065em;font-weight:550;margin:0}.hero-grid>p,.lead{font-size:clamp(19px,2vw,28px);line-height:1.35;color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:42px}.btn{min-height:54px;padding:0 22px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}.primary{background:var(--accent);color:white}.secondary{border:1px solid var(--line)}.proof,.dark{background:var(--dark);color:white}.proof{padding-bottom:20px}.metrics{display:grid;grid-template-columns:repeat(3,1fr)}.metrics div{min-height:180px;padding:30px 22px;border-right:1px solid #333;display:flex;flex-direction:column;justify-content:space-between}.metrics div:first-child{border-left:1px solid #333}.metrics strong{font-size:clamp(42px,5vw,70px)}.metrics span,.note{font-size:11px;color:#92928e}.note{margin-top:18px}.content{padding:130px 0;align-items:start}.content h2{font-size:clamp(44px,5.7vw,82px);margin-bottom:40px}.content p{font-size:17px;line-height:1.55;color:var(--muted)}.content ol{list-style:none;padding:0;margin:0;border-top:1px solid #333}.content li{display:grid;grid-template-columns:70px 1fr;padding:22px 0;border-bottom:1px solid #333;font-size:20px}.content li b{font:11px monospace;color:#777}.links{display:grid;grid-template-columns:1fr 1fr;gap:8px}.links a{min-height:150px;border:1px solid var(--line);padding:20px;display:flex;justify-content:space-between;align-items:flex-end}.accent{background:var(--accent);color:white;padding:120px 0}.case{align-items:start}.case h2{font-size:clamp(46px,6vw,86px);margin-top:25px}.case p{font-size:20px;line-height:1.45}.darkbtn{background:#111;color:white;margin-top:30px}.final{padding:140px 0}.final h2{margin:25px 0 35px}.final p{max-width:700px;font-size:20px;line-height:1.45;color:var(--muted)}@media(max-width:850px){.hero-grid,.content,.case{grid-template-columns:1fr}.metrics,.links{grid-template-columns:1fr}.content,.accent,.final{padding:85px 0}.hero-grid{padding-top:55px}.kicker span:last-child{display:none}.actions{flex-direction:column;align-items:stretch}}</style>
