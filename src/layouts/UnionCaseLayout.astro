---
import BaseLayout from './BaseLayout.astro';
const {title,description,eyebrow,headline,accent,intro,metrics=[]}=Astro.props;
const related=[
 {href:'/cases/union-klinika/meta-ads',label:'META ADS',copy:'Patient acquisition built around services, offers and bilingual creative.'},
 {href:'/cases/union-klinika/google-ads',label:'GOOGLE ADS',copy:'Capturing existing medical demand through search.'},
 {href:'/cases/union-klinika/website',label:'WEBSITE',copy:'A new bilingual clinic website built as acquisition infrastructure.'}
];
---
<BaseLayout title={`${title} | RM CREATIVES`} description={description}>
<main><section class="hero shell"><div class="crumb eyebrow"><a href="/cases">CASES</a><span> / </span><a href="/cases/union-klinika">UNION KLINIKA</a><span> / {eyebrow}</span></div><div class="hero-grid"><div><span class="eyebrow">UNION KLINIKA / RIGA</span><h1>{headline}<br/><em>{accent}</em></h1></div><p>{intro}</p></div><div class="metrics">{metrics.map(m=><div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div></section><slot/><section class="related dark"><div class="shell"><span class="eyebrow">MORE FROM THIS CLIENT</span><div class="related-head"><h2>One clinic.<br/>Three systems.</h2><a href="/cases/union-klinika">OVERVIEW ↗</a></div><div class="related-grid">{related.map(r=><a href={r.href}><span class="eyebrow">{r.label}</span><p>{r.copy}</p><b>OPEN CASE ↗</b></a>)}</div></div></section></main></BaseLayout>
<style is:global>
main{overflow:hidden}.hero{padding:38px 0 110px}.crumb{padding-bottom:16px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.45fr .55fr;gap:80px;padding:90px 0 75px;align-items:end}.hero h1{font-size:clamp(62px,8vw,126px);line-height:.86;letter-spacing:-.07em;margin:18px 0 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero-grid>p{font-size:17px;line-height:1.55;color:var(--muted)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line)}.metrics div{padding:28px 18px;border-right:1px solid var(--line)}.metrics div:last-child{border:0}.metrics strong{display:block;font-size:clamp(38px,5vw,68px);letter-spacing:-.06em}.metrics span{font-size:11px;color:var(--muted)}.case-section{padding:130px 0}.two{display:grid;grid-template-columns:.5fr 1.3fr;gap:80px}.two h2{font-size:clamp(48px,6.5vw,94px);line-height:.92;letter-spacing:-.06em;margin:0 0 35px}.two p{max-width:720px;font-size:16px;line-height:1.6;color:var(--muted)}.statement{font-size:24px!important;line-height:1.35!important;color:var(--ink)!important}.dark{background:var(--dark);color:var(--white)}.dark p{color:#999}.dark .statement{color:var(--white)!important}.accent-section{background:var(--accent);padding:130px 0}.accent-section h2{font-size:clamp(50px,7vw,100px);line-height:.9;letter-spacing:-.065em;margin:25px 0}.flow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:60px;font:10px monospace}.flow span{border:1px solid currentColor;padding:11px}.related{padding:120px 0}.related-head{display:flex;justify-content:space-between;align-items:end;margin:30px 0 60px}.related-head h2{font-size:clamp(52px,7vw,100px);line-height:.9;letter-spacing:-.065em;margin:0}.related-head a{font:10px monospace;color:inherit}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.related-grid>a{border:1px solid #333;min-height:280px;padding:22px;display:flex;flex-direction:column;color:inherit}.related-grid p{font-size:17px;line-height:1.4;color:#aaa;margin-top:55px}.related-grid b{font:10px monospace;margin-top:auto}.rows{margin-top:55px;border-top:1px solid currentColor}.row{display:grid;grid-template-columns:.5fr 1fr .35fr;gap:20px;padding:20px 0;border-bottom:1px solid currentColor;font-size:13px}.row strong{text-align:right}@media(max-width:800px){.hero-grid,.two{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.related-grid{grid-template-columns:1fr}.case-section,.accent-section{padding:90px 0}.row{grid-template-columns:1fr}.row strong{text-align:left}.related-head{display:block}.related-head a{display:block;margin-top:25px}}
</style>