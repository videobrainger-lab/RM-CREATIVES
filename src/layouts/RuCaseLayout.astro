---
import BaseLayout from './BaseLayout.astro';
const {title,description,client,clientLabel,eyebrow,headline,accent,intro,metrics=[],related=[]}=Astro.props;
const clientSlug = client.toLowerCase().replace(/\s+/g,'-');
---
<BaseLayout lang="ru" title={`${title} | RM CREATIVES`} description={description}>
<main>
<section class="hero shell">
  <div class="crumb eyebrow"><a href="/ru/cases">КЕЙСЫ</a><span> / </span><a href={`/ru/cases/${clientSlug}`}>{client}</a><span> / {eyebrow}</span></div>
  <div class="hero-grid"><div><span class="eyebrow">{client} / {clientLabel}</span><h1>{headline}<br/><em>{accent}</em></h1></div><p>{intro}</p></div>
  <div class="metrics" style={`--metric-count:${metrics.length}`}>{metrics.map(m=><div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div>
</section>
<slot/>
<section class="related dark"><div class="shell"><span class="eyebrow">ЕЩЁ ПО ЭТОМУ КЛИЕНТУ</span><div class="related-head"><h2>Одна клиника.<br/>Несколько систем роста.</h2><a href={`/ru/cases/${clientSlug}`}>ОБЗОР ↗</a></div><div class="related-grid">{related.map(r=><a href={r.href}><span class="eyebrow">{r.label}</span><p>{r.copy}</p><b>ОТКРЫТЬ КЕЙС ↗</b></a>)}</div></div></section>
</main>
</BaseLayout>
<style is:global>
main{overflow:hidden}.hero{padding:38px 0 110px}.crumb{padding-bottom:16px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.45fr .55fr;gap:80px;padding:90px 0 75px;align-items:end}.hero h1{font-size:clamp(62px,8vw,126px);line-height:.86;letter-spacing:-.07em;margin:18px 0 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero-grid>p{font-size:17px;line-height:1.55;color:var(--muted)}.metrics{display:grid;grid-template-columns:repeat(var(--metric-count,4),1fr);border-block:1px solid var(--line)}.metrics div{padding:28px 18px;border-right:1px solid var(--line)}.metrics div:last-child{border:0}.metrics strong{display:block;font-size:clamp(38px,5vw,68px);letter-spacing:-.06em}.metrics span{font-size:11px;color:var(--muted)}.case-section{padding:130px 0}.two{display:grid;grid-template-columns:.5fr 1.3fr;gap:80px}.two h2{font-size:clamp(48px,6.5vw,94px);line-height:.92;letter-spacing:-.06em;margin:0 0 35px}.two p{max-width:720px;font-size:16px;line-height:1.6;color:var(--muted)}.statement{font-size:24px!important;line-height:1.35!important;color:var(--ink)!important}.dark{background:var(--dark);color:var(--white)}.dark p{color:#999}.dark .statement{color:var(--white)!important}.accent-section{background:var(--accent);color:#fff;padding:130px 0}.accent-section *{color:inherit}.accent-section h2{font-size:clamp(50px,7vw,100px);line-height:.9;letter-spacing:-.065em;margin:25px 0}.data-list{margin-top:55px;border-top:1px solid currentColor}.data-row{display:grid;grid-template-columns:.5fr 1fr .45fr;gap:20px;padding:20px 0;border-bottom:1px solid currentColor;font-size:13px}.data-row strong{text-align:right}.flow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:60px;font:10px monospace}.flow span{border:1px solid currentColor;padding:11px}.related{padding:120px 0}.related-head{display:flex;justify-content:space-between;align-items:end;margin:30px 0 60px}.related-head h2{font-size:clamp(52px,7vw,100px);line-height:.9;letter-spacing:-.065em;margin:0}.related-head a{font:10px monospace;color:inherit}.related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.related-grid>a{border:1px solid #333;min-height:280px;padding:22px;display:flex;flex-direction:column;color:inherit}.related-grid p{font-size:16px;line-height:1.4;color:#aaa;margin-top:55px}.related-grid b{font:10px monospace;margin-top:auto}.proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:60px}.proof{border:1px solid var(--line);padding:24px;min-height:240px;display:flex;flex-direction:column}.proof strong{font-size:50px;letter-spacing:-.06em;margin-top:auto}.proof small{color:var(--muted)}@media(max-width:800px){.hero-grid,.two{grid-template-columns:1fr}.metrics,.related-grid,.proof-grid{grid-template-columns:1fr 1fr}.case-section,.accent-section{padding:90px 0}.data-row{grid-template-columns:1fr}.data-row strong{text-align:left}.related-head{display:block}.related-head a{display:block;margin-top:25px}}@media(max-width:560px){.metrics,.related-grid,.proof-grid{grid-template-columns:1fr}}
</style>