---
import BaseLayout from './BaseLayout.astro';
const { title, description, eyebrow, headline, accent, intro, metrics = [], nextHref='/cases/epiline', nextLabel='Back to Epiline' } = Astro.props;
---
<BaseLayout title={`${title} | RM CREATIVES`} description={description}>
<main>
<section class="hero shell"><div class="top eyebrow"><a href="/cases/epiline">EPILINE / CASE SYSTEM</a><span>{eyebrow}</span></div><h1>{headline}<br/><em>{accent}</em></h1><div class="intro"><p>{intro}</p><span class="eyebrow">RIGA · JURMALA / LATVIA</span></div></section>
{metrics.length > 0 && <section class="metrics"><div class="shell metric-grid">{metrics.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div></section>}
<slot />
<section class="next shell"><span class="eyebrow">EPILINE / RELATED</span><h2>One client.<br/>One connected system.</h2><div class="links"><a href="/cases/epiline/meta-ads">META ADS ↗</a><a href="/cases/epiline/google-ads">GOOGLE ADS ↗</a><a href="/cases/epiline/seo">SEO ↗</a><a href="/cases/epiline/website">WEBSITE ↗</a><a href="/cases/epiline/crm-booking">CRM & BOOKING ↗</a></div><a class="back" href={nextHref}>{nextLabel} →</a></section>
</main></BaseLayout>
<style is:global>
.hero{padding:58px 0 90px}.top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:16px}.hero h1{font-size:clamp(68px,10vw,158px);line-height:.82;letter-spacing:-.075em;margin:90px 0 70px;font-weight:650}.hero h1 em{font-style:normal;color:var(--accent)}.intro{display:grid;grid-template-columns:1.2fr .8fr;gap:70px;align-items:end}.intro p{font-size:clamp(22px,2.2vw,34px);line-height:1.2;letter-spacing:-.035em;margin:0;max-width:780px}.intro>span{text-align:right}.metrics{background:var(--dark);color:var(--white)}.metric-grid{display:grid;grid-template-columns:repeat(var(--metric-count,4),1fr)}.metric-grid>div{min-height:260px;padding:34px 24px;border-right:1px solid #303030;display:flex;flex-direction:column;justify-content:space-between}.metric-grid>div:first-child{border-left:1px solid #303030}.metric-grid strong{font-size:clamp(48px,5vw,78px);letter-spacing:-.06em;font-weight:550}.metric-grid span{font-size:13px;color:#888;line-height:1.4}.case-section{padding:140px 0}.case-section.dark{background:var(--dark);color:var(--white)}.case-section.accent{background:var(--accent)}.two{display:grid;grid-template-columns:.7fr 1.5fr;gap:80px}.case-section h2,.next h2{font-size:clamp(48px,6vw,92px);line-height:.92;letter-spacing:-.06em;margin:0 0 45px;font-weight:600}.case-section p{font-size:17px;line-height:1.65;color:var(--muted);max-width:760px}.dark p{color:#999}.statement{font-size:clamp(30px,4vw,58px)!important;line-height:1.05!important;letter-spacing:-.045em;color:inherit!important}.data-list{margin-top:50px;border-top:1px solid var(--line)}.data-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;padding:17px 0;border-bottom:1px solid var(--line);font-size:14px}.data-row strong{text-align:right}.bars{display:flex;align-items:end;gap:8px;height:280px;margin-top:55px;border-bottom:1px solid currentColor;padding:0 0 12px}.bar{flex:1;display:flex;flex-direction:column;justify-content:flex-end;gap:9px;height:100%}.bar i{display:block;background:var(--accent);min-height:5px}.accent .bar i{background:var(--ink)}.bar b{font-size:11px}.bar span{font-family:monospace;font-size:9px;color:var(--muted)}.flow{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:60px}.flow span{border:1px solid currentColor;padding:16px 20px;font-family:monospace;font-size:11px}.flow b{font-weight:400}.next{padding:140px 0 170px;border-top:1px solid var(--line)}.next h2{margin-top:30px}.links{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:60px 0}.links a{padding:22px 12px;border-right:1px solid var(--line);font-family:monospace;font-size:10px}.back{display:inline-block;border-bottom:1px solid var(--ink);padding-bottom:5px}@media(max-width:800px){.hero{padding-top:30px}.hero h1{margin:65px 0 50px}.intro,.two{grid-template-columns:1fr}.intro>span{text-align:left}.metric-grid{grid-template-columns:1fr 1fr}.metric-grid>div{min-height:190px}.case-section,.next{padding-top:90px;padding-bottom:90px}.links{grid-template-columns:1fr}.links a{border-right:0;border-bottom:1px solid var(--line)}.data-row{grid-template-columns:1fr auto}.data-row span:nth-child(2){display:none}.top span{display:none}}
</style>