---
import BaseLayout from './BaseLayout.astro';

interface Section { title: string; body: string; bullets?: string[]; }
interface Link { href: string; label: string; }
interface Props {
  lang?: 'en' | 'ru';
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  intro: string;
  updated: string;
  takeaways: string[];
  sections: Section[];
  sources: Link[];
  related: Link[];
}

const { lang = 'en', title, description, eyebrow, headline, intro, updated, takeaways, sections, sources, related } = Astro.props;
const ru = lang === 'ru';
---
<BaseLayout title={title} description={description} lang={lang} hasRuAlternate={false}>
  <main class="authority-page">
    <section class="hero shell">
      <div class="meta eyebrow"><span>{eyebrow}</span><span>{ru ? 'ОБНОВЛЕНО' : 'UPDATED'} {updated}</span></div>
      <div class="hero-grid"><h1>{headline}</h1><p>{intro}</p></div>
    </section>

    <section class="summary"><div class="shell summary-grid"><span class="eyebrow">{ru ? 'КРАТКАЯ ПРОВЕРКА' : 'EXECUTIVE CHECK'}</span><ol>{takeaways.map((item, i) => <li><b>0{i + 1}</b><span>{item}</span></li>)}</ol></div></section>

    <article class="shell article">
      <div class="article-main">
        {sections.map((section, i) => <section id={`section-${i + 1}`}><span class="eyebrow">0{i + 1}</span><h2>{section.title}</h2><p>{section.body}</p>{section.bullets && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}</section>)}
      </div>
      <aside><span class="eyebrow">{ru ? 'ОФИЦИАЛЬНЫЕ ИСТОЧНИКИ' : 'OFFICIAL SOURCES'}</span>{sources.map(source => <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}<p>{ru ? 'Правила платформ и местные требования меняются. Перед запуском проверяйте актуальные условия для каждого рынка. Материал не является юридической консультацией.' : 'Platform policies and local advertising rules change. Confirm the current requirements for every market before launch. This guide is not legal advice.'}</p></aside>
    </article>

    <section class="related shell"><span class="eyebrow">{ru ? 'СВЯЗАННЫЕ МАТЕРИАЛЫ И УСЛУГИ' : 'CONNECTED GUIDES & SERVICES'}</span><div>{related.map(link => <a href={link.href}><span>{link.label}</span><b>↗</b></a>)}</div></section>
    <section class="cta"><div class="shell"><span class="eyebrow">{ru ? 'ПРОДВИЖЕНИЕ С УЧЁТОМ ПРАВИЛ' : 'POLICY-AWARE ACQUISITION'}</span><h2>{ru ? 'Стройте масштабируемые кампании, где требования учтены до запуска.' : 'Build campaigns that can scale without treating compliance as an afterthought.'}</h2><a href={ru ? '/ru/contact?interest=industry-marketing' : '/contact?interest=industry-marketing'}>{ru ? 'Обсудить продвижение клиники' : 'Discuss your clinic marketing'} ↗</a></div></section>
  </main>
</BaseLayout>

<style>
  .authority-page{overflow:hidden}.hero{padding:38px 0 105px}.meta{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:16px}.hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:7vw;align-items:end;padding-top:76px}.hero h1{font-size:clamp(55px,7.6vw,112px);line-height:.88;letter-spacing:-.065em;font-weight:550;margin:0}.hero p{font-size:clamp(19px,2vw,27px);line-height:1.4;color:var(--muted);margin:0}.summary{background:var(--dark);color:white}.summary-grid{display:grid;grid-template-columns:.55fr 1.45fr;gap:7vw;padding-top:82px;padding-bottom:82px}.summary ol{list-style:none;padding:0;margin:0;border-top:1px solid #353535}.summary li{display:grid;grid-template-columns:65px 1fr;gap:18px;padding:22px 0;border-bottom:1px solid #353535;font-size:19px;line-height:1.35}.summary b{font:11px monospace;color:#777}.article{display:grid;grid-template-columns:1fr 280px;gap:9vw;padding-top:115px;padding-bottom:120px}.article-main section{padding-bottom:90px}.article h2{font-size:clamp(38px,5vw,68px);line-height:.95;letter-spacing:-.045em;font-weight:550;margin:18px 0 28px}.article p,.article li{font-size:18px;line-height:1.65;color:var(--muted)}.article ul{padding-left:22px}.article li{padding:5px 0}.article aside{position:sticky;top:30px;align-self:start;border-top:1px solid var(--line);padding-top:20px;display:flex;flex-direction:column;gap:15px}.article aside a{font-size:14px;line-height:1.35;text-decoration:underline;text-underline-offset:3px}.article aside p{font-size:12px;line-height:1.5;margin-top:18px}.related{padding-bottom:120px}.related>div{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:28px}.related a{min-height:150px;border:1px solid var(--line);padding:20px;display:flex;justify-content:space-between;align-items:flex-end}.cta{background:var(--accent);color:white;padding:110px 0}.cta h2{font-size:clamp(45px,6vw,84px);line-height:.92;letter-spacing:-.055em;font-weight:550;max-width:1000px;margin:25px 0 40px}.cta a{display:inline-flex;background:#111;color:white;min-height:54px;padding:0 22px;align-items:center;font-size:13px;font-weight:700}@media(max-width:820px){.hero-grid,.summary-grid,.article{grid-template-columns:1fr}.article aside{position:static}.related>div{grid-template-columns:1fr}.hero-grid{padding-top:55px}.hero{padding-bottom:75px}.article{padding-top:80px}.meta span:last-child{display:none}}
</style>
