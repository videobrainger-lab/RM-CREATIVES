---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MarketingConsent from '../components/MarketingConsent.astro';
interface Props { title?: string; description?: string; lang?: 'en' | 'ru'; noindex?: boolean; }
const pathname = Astro.url.pathname;
const inferredLang = pathname.startsWith('/ru') ? 'ru' : 'en';
const seoByPath: Record<string, { title: string; description: string }> = {
  '/': { title: 'Patient Acquisition for Clinics | RM CREATIVES', description: 'Patient acquisition for medical, dental and aesthetic clinics through Meta Ads, Google Ads and high-converting clinic websites.' },
  '/ru/': { title: 'Привлечение пациентов для клиник | RM CREATIVES', description: 'Привлечение пациентов для медицинских, стоматологических и эстетических клиник через Meta Ads, Google Ads и конверсионные сайты.' },
  '/performance/': { title: 'Meta Ads for Clinics — Pay per Enquiry | RM CREATIVES', description: 'Meta Ads for clinics with a transparent pay-per-enquiry model. Strategy, creatives, campaign management and optimisation focused on qualified enquiries.' },
  '/ru/performance/': { title: 'Meta Ads для клиник — оплата за обращения | RM CREATIVES', description: 'Meta Ads для клиник с прозрачной оплатой за обращения. Стратегия, креативы, запуск и оптимизация рекламы с фокусом на целевые заявки.' },
  '/search/': { title: 'Google Ads for Clinics | RM Search by RM CREATIVES', description: 'Google Search Ads for clinics that capture existing patient demand. Forecasting, campaign structure, optimisation and measurable conversion performance.' },
  '/ru/search/': { title: 'Google Ads для клиник | RM Search by RM CREATIVES', description: 'Поисковая реклама Google Ads для клиник: прогноз до запуска, структура кампаний, оптимизация и привлечение пациентов с существующим спросом.' },
  '/sites/': { title: 'Clinic Website Design & Development | RM CREATIVES', description: 'High-converting websites for medical, dental and aesthetic clinics. Fast launch, clear patient journeys, mobile-first UX and SEO-ready architecture.' },
  '/ru/sites/': { title: 'Разработка сайтов для клиник | RM CREATIVES', description: 'Конверсионные сайты для медицинских, стоматологических и эстетических клиник: быстрый запуск, понятный путь пациента, mobile-first UX и SEO-архитектура.' },
  '/cases/': { title: 'Clinic Marketing Cases & Results | RM CREATIVES', description: 'Real clinic marketing case studies across Meta Ads, Google Ads, SEO, websites and CRM. Problems solved, systems built and measurable results.' },
  '/ru/cases/': { title: 'Кейсы маркетинга клиник и результаты | RM CREATIVES', description: 'Реальные кейсы клиник: Meta Ads, Google Ads, SEO, сайты и CRM. Решённые задачи, построенные системы и измеримые результаты.' },
  '/insights/': { title: 'Clinic Marketing Insights & Guides | RM CREATIVES', description: 'Practical insights on clinic marketing, patient acquisition, Meta Ads, Google Ads, SEO, websites and conversion systems from real projects.' },
  '/ru/insights/': { title: 'Маркетинг клиник: статьи и разборы | RM CREATIVES', description: 'Практические материалы о маркетинге клиник, привлечении пациентов, Meta Ads, Google Ads, SEO, сайтах и системах конверсии.' },
  '/contact/': { title: 'Discuss a Clinic Marketing Project | RM CREATIVES', description: 'Tell us about your clinic, current acquisition channels and growth goals. We will review the task and suggest the most relevant next step.' },
  '/ru/contact/': { title: 'Обсудить маркетинг клиники | RM CREATIVES', description: 'Расскажите о клинике, текущих каналах привлечения и целях роста. Мы изучим задачу и предложим наиболее подходящий следующий шаг.' }
};
const normalizedPath = pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : `${pathname}/`;
const mappedSeo = seoByPath[normalizedPath];
const { title: rawTitle = inferredLang === 'ru' ? 'Привлечение пациентов для клиник | RM CREATIVES' : 'Patient Acquisition for Clinics | RM CREATIVES', description: rawDescription = inferredLang === 'ru' ? 'Привлечение пациентов через Meta Ads, Google Ads и конверсионные сайты для медицинских клиник и бьюти-студий.' : 'Patient acquisition through Meta Ads, Google Ads and high-converting websites for medical clinics and beauty studios.', lang = inferredLang, noindex = false } = Astro.props;
const title = mappedSeo?.title || rawTitle;
const description = mappedSeo?.description || rawDescription;
const autoNoindex = noindex || /(^|\/)(thank-you|404)(\/|$)/.test(pathname) || /(^|\/)(privacy|terms|cookies)(\/|$)/.test(pathname);
const canonical = new URL(normalizedPath, 'https://rmcreatives.com');
const enPath = inferredLang === 'ru' ? (normalizedPath.replace(/^\/ru(?=\/|$)/, '') || '/') : normalizedPath;
const ruPath = inferredLang === 'ru' ? normalizedPath : (normalizedPath === '/' ? '/ru/' : `/ru${normalizedPath}`);
const enAlternate = new URL(enPath, 'https://rmcreatives.com');
const ruAlternate = new URL(ruPath, 'https://rmcreatives.com');
const pathParts = normalizedPath.split('/').filter(Boolean).filter((part, index) => !(index === 0 && part === 'ru'));
const breadcrumbNames: Record<string, { en: string; ru: string }> = { cases:{en:'Cases',ru:'Кейсы'},performance:{en:'Performance',ru:'Performance'},search:{en:'Search',ru:'Search'},sites:{en:'Sites',ru:'Сайты'},insights:{en:'Insights',ru:'Insights'},contact:{en:'Contact',ru:'Контакты'},epiline:{en:'Epiline',ru:'Epiline'},denta:{en:'Denta',ru:'Denta'},'consilium-medicum':{en:'Consilium Medicum',ru:'Consilium Medicum'},'union-klinika':{en:'Union Klinika',ru:'Union Klinika'},'meta-ads':{en:'Meta Ads',ru:'Meta Ads'},'google-ads':{en:'Google Ads',ru:'Google Ads'},seo:{en:'SEO',ru:'SEO'},website:{en:'Website',ru:'Сайт'},'crm-booking':{en:'CRM & Booking',ru:'CRM и запись'},'medical-google-ads':{en:'Medical Google Ads',ru:'Google Ads для медицины'} };
const breadcrumbItems=[{'@type':'ListItem',position:1,name:inferredLang==='ru'?'Главная':'Home',item:inferredLang==='ru'?'https://rmcreatives.com/ru/':'https://rmcreatives.com/'}];
let builtPath=inferredLang==='ru'?'/ru':'';
pathParts.forEach((part,index)=>{builtPath+=`/${part}`;breadcrumbItems.push({'@type':'ListItem',position:index+2,name:breadcrumbNames[part]?.[inferredLang]||part.replace(/-/g,' '),item:`https://rmcreatives.com${builtPath}/`});});
const graph:any[]=[
  {'@type':'Organization','@id':'https://rmcreatives.com/#organization',name:'RM CREATIVES',url:'https://rmcreatives.com/',email:'clientcare@rmcreatives.com',logo:{'@type':'ImageObject',url:'https://rmcreatives.com/rm-logo.svg',width:1080,height:1080},sameAs:['https://www.instagram.com/rm_bureau/','https://www.facebook.com/marketing.roast']},
  {'@type':'WebSite','@id':'https://rmcreatives.com/#website',url:'https://rmcreatives.com/',name:'RM CREATIVES',publisher:{'@id':'https://rmcreatives.com/#organization'},inLanguage:['en','ru']},
  {'@type':'WebPage','@id':`${canonical.href}#webpage`,url:canonical.href,name:title,description,isPartOf:{'@id':'https://rmcreatives.com/#website'},about:{'@id':'https://rmcreatives.com/#organization'},inLanguage:lang}
];
if(pathParts.length) graph.push({'@type':'BreadcrumbList','@id':`${canonical.href}#breadcrumb`,itemListElement:breadcrumbItems});
const servicePath=pathParts[0];
if(['performance','search','sites'].includes(servicePath)){
  const serviceNames:Record<string,{en:string;ru:string}>={performance:{en:'Meta Ads patient acquisition for clinics',ru:'Привлечение пациентов для клиник через Meta Ads'},search:{en:'Google Ads for clinics',ru:'Google Ads для клиник'},sites:{en:'Clinic website design and development',ru:'Разработка сайтов для клиник'}};
  graph.push({'@type':'Service','@id':`${canonical.href}#service`,name:serviceNames[servicePath][inferredLang],description,provider:{'@id':'https://rmcreatives.com/#organization'},url:canonical.href,areaServed:'Europe'});
}
const schema={'@context':'https://schema.org','@graph':graph};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><meta name="robots" content={autoNoindex?'noindex,follow':'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}/><meta name="googlebot" content={autoNoindex?'noindex,follow':'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}/><meta name="theme-color" content="#0b0b0b"/><meta name="format-detection" content="telephone=no"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={canonical}/>{!autoNoindex&&<><link rel="alternate" hreflang="en" href={enAlternate}/><link rel="alternate" hreflang="ru" href={ruAlternate}/><link rel="alternate" hreflang="x-default" href={enAlternate}/></>}<meta property="og:type" content="website"/><meta property="og:site_name" content="RM CREATIVES"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang==='ru'?'ru_RU':'en_US'}/><meta property="og:locale:alternate" content={lang==='ru'?'en_US':'ru_RU'}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><script async src="https://www.googletagmanager.com/gtag/js?id=G-2GWL58D9PQ"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-2GWL58D9PQ');</script><script type="application/ld+json" set:html={JSON.stringify(schema)}/><title>{title}</title></head><body><SiteHeader/><slot/><SiteFooter/><MarketingConsent/>
<script is:inline>
(()=>{
  const track=(name,params={})=>{if(typeof window.gtag==='function')window.gtag('event',name,params);};
  const path=window.location.pathname;
  const lang=document.documentElement.lang||'en';
  const serviceMatch=path.match(/^\/(?:ru\/)?(performance|search|sites)\/?$/);
  if(serviceMatch)track('service_interest',{service:serviceMatch[1],language:lang,page_path:path});
  if(/^\/(?:ru\/)?contact\/?$/.test(path))track('view_contact',{language:lang,page_path:path});
  document.addEventListener('click',e=>{
    const link=e.target.closest('a[href]');if(!link)return;
    const href=link.getAttribute('href')||'';
    if(href.startsWith('mailto:'))track('contact_click',{contact_method:'email',language:lang,page_path:path});
    if(href.startsWith('tel:'))track('contact_click',{contact_method:'phone',language:lang,page_path:path});
  });
})();
</script>
<script is:inline>
(()=>{const panel=document.querySelector('.system-panel');const stat=panel?.querySelector('.panel-stat');const counter=stat?.querySelector('strong');const label=stat?.querySelector('.eyebrow');const feed=panel?.querySelector('.feed');if(!panel||!stat||!counter||!label||!feed)return;const isRu=document.documentElement.lang==='ru';const BASE_COUNT=10000,BASE_TIME=new Date('2026-09-11T00:00:00+03:00').getTime(),AVG_PER_DAY=39,ratePerMs=AVG_PER_DAY/86400000,now=Date.now(),target=Math.max(BASE_COUNT,Math.floor(BASE_COUNT+Math.max(0,now-BASE_TIME)*ratePerMs));label.textContent=isRu?'ОБРАЩЕНИЙ В КЛИНИКИ КЛИЕНТОВ / 2026':'CLIENT CLINIC ENQUIRIES / 2026';stat.classList.add('live-counter-stat');const note=document.createElement('span');note.className='counter-note eyebrow muted';note.textContent=isRu?'LIVE ESTIMATE · ОБНОВЛЯЕТСЯ АВТОМАТИЧЕСКИ':'LIVE ESTIMATE · UPDATES AUTOMATICALLY';stat.appendChild(note);const flash=document.createElement('span');flash.className='counter-flash eyebrow';flash.textContent=isRu?'+1 ОБРАЩЕНИЕ':'+1 ENQUIRY';stat.appendChild(flash);const format=v=>new Intl.NumberFormat(isRu?'ru-RU':'en-US').format(v);counter.textContent=format(target);})();
</script></body></html>
<style is:global>
:root{--bg:#f2f1ec;--ink:#101010;--muted:#73736e;--line:#cfcec7;--accent:#1f4fff;--accent-deep:#1647e8;--dark:#0c0c0c;--white:#f8f8f4}*{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:clip}body{margin:0;max-width:100%;overflow-x:clip;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img,svg,video{max-width:100%;height:auto}.shell,.container{width:min(1180px,calc(100% - 48px));margin-left:auto;margin-right:auto}.eyebrow{font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:11px;letter-spacing:.11em;text-transform:uppercase}.muted{color:var(--muted)}h1,h2,h3,p{margin-top:0}.display{font-size:clamp(52px,8vw,116px);line-height:.88;letter-spacing:-.065em;font-weight:500}.section-title{font-size:clamp(38px,5vw,76px);line-height:.94;letter-spacing:-.05em;font-weight:500}.lead{font-size:clamp(20px,2.1vw,30px);line-height:1.25;letter-spacing:-.025em}.btn{display:inline-flex;align-items:center;justify-content:center;padding:15px 20px;border:1px solid var(--ink);text-decoration:none;font-size:13px}.btn.primary{background:var(--accent);border-color:var(--accent);color:white}.btn.dark{background:var(--dark);border-color:var(--dark);color:white}.rule{border-top:1px solid var(--line)}@media(max-width:720px){.shell,.container{width:min(100% - 28px,1180px)}}
</style>