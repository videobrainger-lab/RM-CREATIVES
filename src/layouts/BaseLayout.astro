  '/cases/consilium-medicum/meta-ads/': { title: 'Meta Ads for a Medical Clinic — Consilium Case | RM CREATIVES', description: 'How Meta Ads supported patient acquisition for Consilium Medicum within the constraints of healthcare advertising.' },
  '/cases/consilium-medicum/seo/': { title: 'Medical Clinic SEO — Consilium Case | RM CREATIVES', description: 'Consilium Medicum SEO case: 24,632 organic clicks from January to August 2026 and strong rankings for medical search queries.' },
  '/cases/union-klinika/': { title: 'Union Klinika Marketing Case Study | RM CREATIVES', description: 'Union Klinika patient acquisition case across Meta Ads, Google Ads and clinic website development.' },
  '/cases/union-klinika/meta-ads/': { title: 'Meta Ads for a Clinic — Union Klinika Case | RM CREATIVES', description: 'Union Klinika Meta Ads case: 1,021 enquiries from May to December 2024 at a weighted cost per lead of €2.75.' },
  '/cases/union-klinika/google-ads/': { title: 'Google Ads for a Clinic — Union Klinika Case | RM CREATIVES', description: 'How Google Search Ads captured existing patient demand for Union Klinika as part of a multi-channel acquisition system.' },
