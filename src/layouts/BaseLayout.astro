  '/ru/cases/epiline/seo/': { title: 'SEO для бьюти-клиники — кейс Epiline | RM CREATIVES', description: 'Как Epiline вышла в TOP 10 поиска и получила 275 органических обращений благодаря SEO на двух языках.' },
  '/ru/cases/epiline/website/': { title: 'Разработка сайта клиники — кейс Epiline | RM CREATIVES', description: 'Новый двуязычный сайт Epiline на 44 страницы: WordPress, SEO-миграция, редиректы и сохранение позиций TOP-5.' },
  '/ru/cases/epiline/crm-booking/': { title: 'CRM и онлайн-запись клиники — кейс Epiline | RM CREATIVES', description: 'Как связали рекламу, сайт, Kommo CRM, WhatsApp и Altegio в единую систему работы с обращениями пациентов.' },
  '/ru/cases/denta/': { title: 'Маркетинг стоматологии Denta — кейс | RM CREATIVES', description: 'Кейс Denta: 16 227 отслеживаемых обращений в 2025 году через Google Ads, Meta Ads, SEO и сайт.' },
  '/ru/cases/denta/google-ads/': { title: 'Google Ads для стоматологии — кейс Denta | RM CREATIVES', description: 'Кейс Denta: 10 601 конверсия из Google Ads в 2025 году при средневзвешенном CPA €2,07.' },
  '/ru/cases/denta/meta-ads/': { title: 'Meta Ads для стоматологии — кейс Denta | RM CREATIVES', description: 'Кейс Meta Ads Denta: 1 639 обращений в 2025 году и ещё 1 902 обращения за январь–август 2026.' },
  '/ru/cases/denta/seo/': { title: 'SEO для стоматологии — кейс Denta | RM CREATIVES', description: 'Кейс SEO Denta: видимость в TOP-5 и 3 831 органическое обращение в 2025 году.' },
  '/ru/cases/denta/website/': { title: 'Сайт стоматологической клиники — кейс Denta | RM CREATIVES', description: 'Как сайт Denta работает внутри измеримой системы привлечения пациентов из платного и органического поиска.' },
  '/ru/cases/consilium-medicum/': { title: 'Маркетинг Consilium Medicum — кейс клиники | RM CREATIVES', description: 'Кейс медицинской клиники: Google Ads, Meta Ads и SEO, включая 3 356 конверсий Google Ads в 2024 году.' },
  '/ru/cases/consilium-medicum/google-ads/': { title: 'Google Ads для медицинской клиники — Consilium | RM CREATIVES', description: 'Кейс Consilium Medicum: 3 356 конверсий Google Ads в 2024 году при CPA €3,25.' },
  '/ru/cases/consilium-medicum/medical-google-ads/': { title: 'Ограничения Google Ads в медицине — кейс | RM CREATIVES', description: 'Практический кейс о рекламе медицинской клиники в Google Ads: ограничения, блокировки и работа с политиками платформы.' },
  '/ru/cases/consilium-medicum/meta-ads/': { title: 'Meta Ads для медицинской клиники — Consilium | RM CREATIVES', description: 'Как Meta Ads использовались для привлечения обращений в Consilium Medicum с учётом ограничений медицинской рекламы.' },
  '/ru/cases/consilium-medicum/seo/': { title: 'SEO медицинской клиники — Consilium Medicum | RM CREATIVES', description: 'Кейс SEO Consilium Medicum: 24 632 органических клика за январь–август 2026 и сильные позиции по медицинским запросам.' },
  '/ru/cases/union-klinika/': { title: 'Маркетинг Union Klinika — кейс клиники | RM CREATIVES', description: 'Кейс Union Klinika: система привлечения пациентов через Meta Ads, Google Ads и сайт клиники.' },
  '/ru/cases/union-klinika/meta-ads/': { title: 'Meta Ads для клиники — кейс Union Klinika | RM CREATIVES', description: 'Кейс Union Klinika: 1 021 обращение из Meta Ads за май–декабрь 2024 при средневзвешенном CPL €2,75.' },
  '/ru/cases/union-klinika/google-ads/': { title: 'Google Ads для клиники — кейс Union Klinika | RM CREATIVES', description: 'Как поисковая реклама Google Ads забирала существующий спрос пациентов для Union Klinika.' },
  '/ru/cases/union-klinika/website/': { title: 'Сайт клиники с ограниченным бюджетом — Union | RM CREATIVES', description: 'Кейс разработки практичного сайта Union Klinika вокруг пути пациента и задач привлечения обращений.' }
};
const normalizedPath = pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : `${pathname}/`;
const mappedSeo = seoByPath[normalizedPath];
const { title: rawTitle = inferredLang === 'ru' ? 'Привлечение пациентов для клиник | RM CREATIVES' : 'Patient Acquisition for Clinics | RM CREATIVES', description: rawDescription = inferredLang === 'ru' ? 'Привлечение пациентов через Meta Ads, Google Ads и конверсионные сайты для медицинских клиник и бьюти-студий.' : 'Patient acquisition through Meta Ads, Google Ads and high-converting websites for medical clinics and beauty studios.', lang = inferredLang, noindex = false } = Astro.props;
const title = mappedSeo?.title || rawTitle;
const description = (mappedSeo?.description || rawDescription).replace(/медицинских и beauty-клиник/gi, 'медицинских клиник и бьюти-студий').replace(/медицинских и бьюти-клиник/gi, 'медицинских клиник и бьюти-студий').replace(/medical and beauty clinics/gi, 'medical clinics and beauty studios').replace(/medical, dental and beauty clinics/gi, 'medical and aesthetic clinics, dental clinics and beauty studios');
const autoNoindex = noindex || /(^|\/)(thank-you|404)(\/|$)/.test(pathname) || /(^|\/)(privacy|terms|cookies)(\/|$)/.test(pathname);
const canonical = new URL(normalizedPath, 'https://rmcreatives.com');
const enPath = inferredLang === 'ru' ? (normalizedPath.replace(/^\/ru(?=\/|$)/, '') || '/') : normalizedPath;
const ruPath = inferredLang === 'ru' ? normalizedPath : (normalizedPath === '/' ? '/ru/' : `/ru${normalizedPath}`);
const enAlternate = new URL(enPath, 'https://rmcreatives.com'); const ruAlternate = new URL(ruPath, 'https://rmcreatives.com');
const pathParts = normalizedPath.split('/').filter(Boolean).filter((part, index) => !(index === 0 && part === 'ru'));
const breadcrumbNames: Record<string, { en: string; ru: string }> = { cases:{en:'Cases',ru:'Кейсы'},performance:{en:'Performance',ru:'Performance'},search:{en:'Search',ru:'Search'},sites:{en:'Sites',ru:'Сайты'},insights:{en:'Insights',ru:'Insights'},contact:{en:'Contact',ru:'Контакты'},epiline:{en:'Epiline',ru:'Epiline'},denta:{en:'Denta',ru:'Denta'},'consilium-medicum':{en:'Consilium Medicum',ru:'Consilium Medicum'},'union-klinika':{en:'Union Klinika',ru:'Union Klinika'},'meta-ads':{en:'Meta Ads',ru:'Meta Ads'},'google-ads':{en:'Google Ads',ru:'Google Ads'},seo:{en:'SEO',ru:'SEO'},website:{en:'Website',ru:'Сайт'},'crm-booking':{en:'CRM & Booking',ru:'CRM и запись'},'medical-google-ads':{en:'Medical Google Ads',ru:'Google Ads для медицины'} };
const breadcrumbItems=[{'@type':'ListItem',position:1,name:inferredLang==='ru'?'Главная':'Home',item:inferredLang==='ru'?'https://rmcreatives.com/ru/':'https://rmcreatives.com/'}]; let builtPath=inferredLang==='ru'?'/ru':''; pathParts.forEach((part,index)=>{builtPath+=`/${part}`;breadcrumbItems.push({'@type':'ListItem',position:index+2,name:breadcrumbNames[part]?.[inferredLang]||part.replace(/-/g,' '),item:`https://rmcreatives.com${builtPath}/`});});
const graph:any[]=[{'@type':'Organization','@id':'https://rmcreatives.com/#organization',name:'RM CREATIVES',url:'https://rmcreatives.com/',email:'clientcare@rmcreatives.com',sameAs:['https://www.instagram.com/rm_bureau/','https://www.facebook.com/marketing.roast']},{'@type':'WebSite','@id':'https://rmcreatives.com/#website',url:'https://rmcreatives.com/',name:'RM CREATIVES',publisher:{'@id':'https://rmcreatives.com/#organization'},inLanguage:['en','ru']},{'@type':'WebPage','@id':`${canonical.href}#webpage`,url:canonical.href,name:title,description,isPartOf:{'@id':'https://rmcreatives.com/#website'},about:{'@id':'https://rmcreatives.com/#organization'},inLanguage:lang}];
if(pathParts.length)graph.push({'@type':'BreadcrumbList','@id':`${canonical.href}#breadcrumb`,itemListElement:breadcrumbItems});
const servicePath=pathParts[0]; if(['performance','search','sites'].includes(servicePath)){const serviceNames:Record<string,{en:string;ru:string}>={performance:{en:'Meta Ads patient acquisition for clinics',ru:'Привлечение пациентов для клиник через Meta Ads'},search:{en:'Google Ads for clinics',ru:'Google Ads для клиник'},sites:{en:'Clinic website design and development',ru:'Разработка сайтов для клиник'}};graph.push({'@type':'Service','@id':`${canonical.href}#service`,name:serviceNames[servicePath][inferredLang],description,provider:{'@id':'https://rmcreatives.com/#organization'},url:canonical.href,areaServed:'Europe'});}
if(servicePath==='cases' && pathParts.length>=2) graph.push({'@type':'Article','@id':`${canonical.href}#case-study`,headline:title,description,mainEntityOfPage:{'@id':`${canonical.href}#webpage`},author:{'@id':'https://rmcreatives.com/#organization'},publisher:{'@id':'https://rmcreatives.com/#organization'},inLanguage:lang});
const schema={'@context':'https://schema.org','@graph':graph};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><meta name="robots" content={autoNoindex?'noindex,follow':'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}/><meta name="googlebot" content={autoNoindex?'noindex,follow':'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}/><meta name="theme-color" content="#0b0b0b"/><meta name="format-detection" content="telephone=no"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={canonical}/>{!autoNoindex&&<><link rel="alternate" hreflang="en" href={enAlternate}/><link rel="alternate" hreflang="ru" href={ruAlternate}/><link rel="alternate" hreflang="x-default" href={enAlternate}/></>}<meta property="og:type" content={servicePath==='cases'&&pathParts.length>=2?'article':'website'}/><meta property="og:site_name" content="RM CREATIVES"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang==='ru'?'ru_RU':'en_US'}/><meta property="og:locale:alternate" content={lang==='ru'?'en_US':'ru_RU'}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/><title>{title}</title></head><body><SiteHeader/><slot/><SiteFooter/>
<script is:inline>
(()=>{const panel=document.querySelector('.system-panel');const stat=panel?.querySelector('.panel-stat');const counter=stat?.querySelector('strong');const label=stat?.querySelector('.eyebrow');const feed=panel?.querySelector('.feed');if(!panel||!stat||!counter||!label||!feed)return;const isRu=document.documentElement.lang==='ru';const BASE_COUNT=10000,BASE_TIME=new Date('2026-09-11T00:00:00+03:00').getTime(),AVG_PER_DAY=39,ratePerMs=AVG_PER_DAY/86400000,now=Date.now(),target=Math.max(BASE_COUNT,Math.floor(BASE_COUNT+Math.max(0,now-BASE_TIME)*ratePerMs));label.textContent=isRu?'ОБРАЩЕНИЙ В КЛИНИКИ КЛИЕНТОВ / 2026':'CLIENT CLINIC ENQUIRIES / 2026';stat.classList.add('live-counter-stat');const note=document.createElement('span');note.className='counter-note eyebrow muted';note.textContent=isRu?'LIVE ESTIMATE · ОБНОВЛЯЕТСЯ АВТОМАТИЧЕСКИ':'LIVE ESTIMATE · UPDATES AUTOMATICALLY';stat.appendChild(note);const flash=document.createElement('span');flash.className='counter-flash eyebrow';flash.textContent=isRu?'+1 ОБРАЩЕНИЕ':'+1 ENQUIRY';stat.appendChild(flash);const format=v=>new Intl.NumberFormat(isRu?'ru-RU':'en-US').format(v);counter.textContent=format(target);})();
</script></body></html>
<style is:global>
:root{--bg:#f2f1ec;--ink:#101010;--muted:#73736e;--line:#cfcec7;--accent:#1f4fff;--accent-deep:#1647e8;--dark:#0c0c0c;--white:#f8f8f4}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}img{max-width:100%;height:auto}.container{width:min(1180px,calc(100% - 48px));margin:0 auto}.eyebrow{font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:11px;letter-spacing:.11em;text-transform:uppercase}.muted{color:var(--muted)}h1,h2,h3,p{margin-top:0}.display{font-size:clamp(52px,8vw,116px);line-height:.88;letter-spacing:-.065em;font-weight:500}.section-title{font-size:clamp(38px,5vw,76px);line-height:.94;letter-spacing:-.05em;font-weight:500}.lead{font-size:clamp(20px,2.1vw,30px);line-height:1.25;letter-spacing:-.025em}.btn{display:inline-flex;align-items:center;justify-content:center;padding:15px 20px;border:1px solid var(--ink);text-decoration:none;font-size:13px}.btn.primary{background:var(--accent);border-color:var(--accent);color:white}.btn.dark{background:var(--dark);border-color:var(--dark);color:white}.rule{border-top:1px solid var(--line)}@media(max-width:720px){.container{width:min(100% - 28px,1180px)}}
</style>