---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title?: string; description?: string; lang?: 'en' | 'ru'; }
const inferredLang = Astro.url.pathname.startsWith('/ru') ? 'ru' : 'en';
const { title = inferredLang === 'ru' ? 'RM CREATIVES — Привлечение пациентов для клиник' : 'RM CREATIVES — Patient acquisition for clinics', description = inferredLang === 'ru' ? 'Meta Ads, Google Ads и конверсионные сайты для медицинских и beauty-клиник.' : 'Meta Ads, Google Ads and high-converting websites for medical and beauty clinics.', lang = inferredLang } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://rmcreatives.com');
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><meta name="theme-color" content="#0b0b0b"/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href="https://rmcreatives.com/"/><link rel="alternate" hreflang="ru" href="https://rmcreatives.com/ru/"/><link rel="alternate" hreflang="x-default" href="https://rmcreatives.com/"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><title>{title}</title></head><body><SiteHeader/><slot/><SiteFooter/>
<script is:inline>
(()=>{const panel=document.querySelector('.system-panel');const stat=panel?.querySelector('.panel-stat');const counter=stat?.querySelector('strong');const label=stat?.querySelector('.eyebrow');const feed=panel?.querySelector('.feed');if(!panel||!stat||!counter||!label||!feed)return;const isRu=document.documentElement.lang==='ru';const BASE_COUNT=10000,BASE_TIME=new Date('2026-09-11T00:00:00+03:00').getTime(),AVG_PER_DAY=39,ratePerMs=AVG_PER_DAY/86400000,now=Date.now(),target=Math.max(BASE_COUNT,Math.floor(BASE_COUNT+Math.max(0,now-BASE_TIME)*ratePerMs));label.textContent=isRu?'ОБРАЩЕНИЙ В КЛИНИКИ КЛИЕНТОВ / 2026':'CLIENT CLINIC ENQUIRIES / 2026';stat.classList.add('live-counter-stat');const note=document.createElement('span');note.className='counter-note eyebrow muted';note.textContent=isRu?'LIVE ESTIMATE · ОБНОВЛЯЕТСЯ АВТОМАТИЧЕСКИ':'LIVE ESTIMATE · UPDATES AUTOMATICALLY';stat.appendChild(note);const flash=document.createElement('span');flash.className='counter-flash eyebrow';flash.textContent=isRu?'+1 ОБРАЩЕНИЕ':'+1 ENQUIRY';stat.appendChild(flash);const events=isRu?[['СТОМАТОЛОГИЯ','ИМПЛАНТАЦИЯ','НОВОЕ'],['ЭСТЕТИКА','ЛАЗЕРНАЯ ПРОЦЕДУРА','ЦЕЛЕВОЕ'],['МЕДИЦИНА','КОНСУЛЬТАЦИЯ ВРАЧА','НОВОЕ'],['СТОМАТОЛОГИЯ','ВИНИРЫ','НОВОЕ'],['ЭСТЕТИКА','ИНЪЕКЦИОННАЯ КОСМЕТОЛОГИЯ','ЦЕЛЕВОЕ'],['МЕДИЦИНА','ДИАГНОСТИКА','НОВОЕ'],['BEAUTY','ЛАЗЕРНАЯ ЭПИЛЯЦИЯ','НОВОЕ']]:[['DENTAL','IMPLANT CONSULTATION','NEW'],['AESTHETIC','LASER TREATMENT','QUALIFIED'],['MEDICAL','SPECIALIST CONSULTATION','NEW'],['DENTAL','VENEERS','NEW'],['AESTHETIC','INJECTABLE TREATMENT','QUALIFIED'],['MEDICAL','DIAGNOSTICS','NEW'],['BEAUTY','LASER HAIR REMOVAL','NEW']];const format=v=>new Intl.NumberFormat(isRu?'ru-RU':'en-US').format(v);const reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;if(reduced)counter.textContent=format(target);else{const start=Math.max(0,target-137),duration=1450,started=performance.now(),ease=t=>1-Math.pow(1-t,3),tick=time=>{const p=Math.min(1,(time-started)/duration);counter.textContent=format(Math.round(start+(target-start)*ease(p)));if(p<1)requestAnimationFrame(tick)};requestAnimationFrame(tick)}let displayed=target;const pulse=el=>{el.classList.remove('enquiry-flash');void el.offsetWidth;el.classList.add('enquiry-flash');setTimeout(()=>el.classList.remove('enquiry-flash'),950)};const addEnquiry=()=>{displayed++;counter.textContent=format(displayed);stat.classList.remove('counter-hit');void stat.offsetWidth;stat.classList.add('counter-hit');flash.classList.remove('show');void flash.offsetWidth;flash.classList.add('show');setTimeout(()=>flash.classList.remove('show'),1500);pulse(stat);const [type,service,status]=events[Math.floor(Math.random()*events.length)],row=document.createElement('div');row.className='feed-row fresh-enquiry';row.innerHTML=`<div class="feed-copy"><b>${type}</b><span>${service}</span></div><em>${status}</em>`;const header=feed.querySelector('.feed-head');header?header.insertAdjacentElement('afterend',row):feed.prepend(row);pulse(row);[...feed.querySelectorAll('.feed-row')].slice(3).forEach(r=>r.remove())};const scheduleNext=()=>setTimeout(()=>{addEnquiry();scheduleNext()},3500+Math.floor(Math.random()*4500));setTimeout(addEnquiry,1800);scheduleNext()})();

(()=>{const section=document.querySelector('.services');if(!section)return;const isRu=document.documentElement.lang==='ru';const head=section.querySelector('.section-head');const headLabel=head?.querySelector('.eyebrow');const headTitle=head?.querySelector('h2');if(headLabel)headLabel.textContent='RM PRODUCTS';if(headTitle)headTitle.innerHTML=isRu?'Три продукта.<br>Одна система.':'Three products.<br>One system.';const configs=isRu?[{code:'PRODUCT / 01',role:'ПРИВЛЕЧЕНИЕ',name:'PERFORMANCE',micro:'META → ОБРАЩЕНИЕ → +1'},{code:'PRODUCT / 02',role:'ГОТОВЫЙ СПРОС',name:'SEARCH',micro:'ПОИСК → КЛИНИКА → ЗАЯВКА'},{code:'PRODUCT / 03',role:'КОНВЕРСИЯ',name:'SITES',micro:'BRIEF → BUILD → LIVE ●'}]:[{code:'PRODUCT / 01',role:'ACQUISITION',name:'PERFORMANCE',micro:'META → ENQUIRY → +1'},{code:'PRODUCT / 02',role:'DEMAND CAPTURE',name:'SEARCH',micro:'SEARCH → CLINIC → LEAD'},{code:'PRODUCT / 03',role:'CONVERSION',name:'SITES',micro:'BRIEF → BUILD → LIVE ●'}];section.querySelectorAll('.service-card').forEach((card,i)=>{const c=configs[i];if(!c)return;card.classList.add('rm-product');const first=card.querySelector(':scope > .eyebrow');if(first)first.textContent=c.code;const nameBox=card.children[1];if(nameBox){const oldName=nameBox.querySelector('h3');if(oldName){oldName.innerHTML=`<span class="rm-mark">RM / 0${i+1}</span><span class="product-name">${c.name}</span>`}const meta=nameBox.querySelector('.eyebrow');if(meta)meta.textContent=c.role}const micro=document.createElement('div');micro.className='product-micro eyebrow';micro.innerHTML=`<span>${c.micro}</span><i></i>`;card.appendChild(micro)});})();
</script></body></html>
<style is:global>
:root{--bg:#f2f1ec;--ink:#101010;--muted:#73736e;--line:#cfcec7;--accent:#c8ff1a;--dark:#0c0c0c;--white:#f8f8f4;font-family:Inter,"Segoe UI",Roboto,Helvetica,Arial,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink)}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}::selection{background:var(--accent);color:#000}.shell{width:min(100% - 40px,1480px);margin:0 auto}.eyebrow{font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.muted{color:var(--muted)}
.live-counter-stat{position:relative;overflow:hidden}.live-counter-stat strong{font-variant-numeric:tabular-nums;transition:transform .2s ease}.counter-note{font-size:8px;letter-spacing:.08em}.counter-flash{position:absolute;right:16px;bottom:22px;padding:6px 8px;background:var(--accent);color:#000;font-size:8px;opacity:0;transform:translateY(8px);pointer-events:none}.counter-flash.show{animation:counterFlash 1.5s ease both}.counter-hit strong{animation:counterHit .42s ease}.system-panel .feed-row{min-height:58px;padding:10px 16px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center}.system-panel .feed-row:last-child{border-bottom:0}.system-panel .feed-row .feed-copy,.system-panel .feed-row>div{min-width:0;display:flex;flex-direction:column;gap:3px}.system-panel .feed-row b{display:block;font-size:11px;line-height:1.2;letter-spacing:.08em}.system-panel .feed-row span{display:block;font-size:10px;line-height:1.25;color:var(--muted);letter-spacing:.05em;overflow-wrap:anywhere}.system-panel .feed-row em{align-self:center;justify-self:end;white-space:nowrap;font-style:normal;font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:9px;line-height:1;border:1px solid var(--line);padding:6px 8px}.system-panel .panel-stat,.system-panel .feed-row{transition:background-color .3s ease,color .3s ease}.system-panel .enquiry-flash{animation:enquiryPulse .95s ease}.system-panel .fresh-enquiry{animation:enquirySlide .42s ease both}
.rm-product{position:relative;overflow:hidden}.rm-product .service-name h3,.rm-product>div:nth-child(2) h3{margin-top:14px!important;display:flex;flex-direction:column;gap:4px}.rm-mark{font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;letter-spacing:.12em;font-weight:500;color:var(--muted)}.product-name{font-size:clamp(38px,4.2vw,68px);line-height:.9;letter-spacing:-.06em;font-weight:700}.product-micro{position:absolute;right:18px;bottom:18px;display:flex;align-items:center;gap:12px;padding:8px 10px;border:1px solid var(--line);background:var(--bg);font-size:8px;opacity:0;transform:translateY(8px);transition:.25s ease}.product-micro i{width:7px;height:7px;border-radius:50%;background:var(--accent)}.rm-product:hover .product-micro{opacity:1;transform:none}.rm-product:hover .product-name{letter-spacing:-.045em}.rm-product:hover .rm-mark{color:var(--ink)}
@keyframes counterFlash{0%{opacity:0;transform:translateY(8px)}18%,72%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-5px)}}@keyframes counterHit{0%{transform:translateY(0)}40%{transform:translateY(-3px)}100%{transform:translateY(0)}}@keyframes enquiryPulse{0%{background:var(--accent);color:#101010}45%{background:var(--accent);color:#101010}100%{background:transparent;color:inherit}}@keyframes enquirySlide{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.counter-flash,.live-counter-stat strong,.system-panel .enquiry-flash,.system-panel .fresh-enquiry{animation:none!important;transition:none!important}}@media(max-width:760px){.shell{width:min(100% - 28px,1480px)}.product-micro{position:static;margin-top:18px;opacity:1;transform:none;width:max-content}.product-name{font-size:38px}}
</style>