---
interface Props { hasRuAlternate?: boolean; }
const { hasRuAlternate = true } = Astro.props;
const path = Astro.url.pathname;
const isRu = path === '/ru' || path.startsWith('/ru/');
const enHref = isRu ? (path.replace(/^\/ru(?=\/|$)/, '') || '/') : path;
const ruHref = isRu ? path : hasRuAlternate ? (path === '/' ? '/ru/' : `/ru${path}`) : '/ru/';
---
<header class="site-header shell" data-site-header>
  <a class="site-brand" href={isRu ? '/ru/' : '/'} aria-label="RM CREATIVES home">RM CREATIVES</a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href={isRu ? '/ru/#services' : '/#services'}>{isRu ? 'Услуги' : 'Services'}</a>
    <div class="nav-group">
      <button type="button">{isRu ? 'Отрасли' : 'Industries'} <span>⌄</span></button>
      <div class="nav-menu">
        <a href={isRu ? '/ru/industries/dental-marketing/' : '/industries/dental-marketing/'}>{isRu ? 'Стоматология' : 'Dental'}</a>
        <a href={isRu ? '/ru/industries/medical-marketing/' : '/industries/medical-marketing/'}>{isRu ? 'Медицина' : 'Medical'}</a>
        <a href={isRu ? '/ru/industries/aesthetic-clinic-marketing/' : '/industries/aesthetic-clinic-marketing/'}>{isRu ? 'Эстетика' : 'Aesthetic'}</a>
      </div>
    </div>
    <a href={isRu ? '/ru/cases' : '/cases'}>{isRu ? 'Кейсы' : 'Cases'}</a>
    <a href={isRu ? '/insights/' : '/insights/'}>Clinic Growth Library</a>
    <a href={isRu ? '/ru/#about' : '/#about'}>{isRu ? 'О нас' : 'About'}</a>
  </nav>

  <div class="site-actions">
    <div class="lang-switch" aria-label="Language switcher">
      <a class:list={[!isRu && 'active']} href={enHref}>EN</a>
      <span>/</span>
      <a class:list={[isRu && 'active']} href={ruHref} title={!isRu && !hasRuAlternate ? 'Russian homepage' : undefined}>RU</a>
    </div>
    <a class="site-cta" href={isRu ? '/ru/contact' : '/contact'}>{isRu ? 'Обсудить проект' : 'Discuss a project'} ↗</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label={isRu ? 'Открыть меню' : 'Open menu'}>
      <span></span><span></span>
    </button>
  </div>

  <nav id="mobile-navigation" class="mobile-nav" aria-label={isRu ? 'Мобильная навигация' : 'Mobile navigation'} hidden>
    <a href={isRu ? '/ru/#services' : '/#services'}>{isRu ? 'Услуги' : 'Services'}</a>
    <div class="mobile-group">
      <span>{isRu ? 'Отрасли' : 'Industries'}</span>
      <a href={isRu ? '/ru/industries/dental-marketing/' : '/industries/dental-marketing/'}>{isRu ? 'Стоматология' : 'Dental'}</a>
      <a href={isRu ? '/ru/industries/medical-marketing/' : '/industries/medical-marketing/'}>{isRu ? 'Медицина' : 'Medical'}</a>
      <a href={isRu ? '/ru/industries/aesthetic-clinic-marketing/' : '/industries/aesthetic-clinic-marketing/'}>{isRu ? 'Эстетика' : 'Aesthetic'}</a>
    </div>
    <a href={isRu ? '/ru/cases' : '/cases'}>{isRu ? 'Кейсы' : 'Cases'}</a>
    <a href="/insights/">Clinic Growth Library</a>
    <a href={isRu ? '/ru/#about' : '/#about'}>{isRu ? 'О нас' : 'About'}</a>
    <a class="mobile-cta" href={isRu ? '/ru/contact' : '/contact'}>{isRu ? 'Обсудить проект' : 'Discuss a project'} ↗</a>
  </nav>
</header>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const target = document.documentElement.lang === 'ru' ? '/ru/contact' : '/contact';
    document.querySelectorAll('a[href^="mailto:hello@rmcreatives.com"]').forEach((link) => link.setAttribute('href', target));

    const header = document.querySelector('[data-site-header]');
    const toggle = header?.querySelector('.menu-toggle');
    const menu = header?.querySelector('.mobile-nav');
    if (!toggle || !menu) return;

    const closeMenu = (restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', document.documentElement.lang === 'ru' ? 'Открыть меню' : 'Open menu');
      menu.hidden = true;
      if (restoreFocus) toggle.focus();
    };
    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', document.documentElement.lang === 'ru' ? 'Закрыть меню' : 'Close menu');
      menu.hidden = false;
    };

    toggle.addEventListener('click', () => toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu());
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) closeMenu(true);
    });
    document.addEventListener('click', (event) => {
      if (!menu.hidden && !header.contains(event.target)) closeMenu();
    });
    window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  });
</script>
<style is:global>
  .shell { width: min(1180px, calc(100% - 48px)); margin-left: auto; margin-right: auto; }
  @media (max-width: 720px) { .shell { width: min(1180px, calc(100% - 28px)); } }
</style>
<style>
  .site-header { position: relative; height: 82px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); font-size: 13px; z-index: 50; }
  .site-brand { font-size: 18px; font-weight: 850; letter-spacing: -.045em; white-space: nowrap; }
  .site-nav { display: flex; gap: 30px; }
  .nav-group{position:relative}.nav-group>button{border:0;background:none;padding:0;color:inherit;font:inherit;cursor:pointer}.nav-group>button span{color:var(--muted)}.nav-menu{position:absolute;left:-18px;top:calc(100% + 10px);z-index:20;width:180px;padding:10px;background:var(--bg);border:1px solid var(--line);display:none;box-shadow:0 16px 35px rgba(0,0,0,.08)}.nav-menu::before{content:"";position:absolute;left:-1px;right:-1px;top:-12px;height:12px}.nav-menu a{display:block;padding:10px 8px}.nav-group:hover .nav-menu,.nav-group:focus-within .nav-menu{display:block}
  .site-actions { justify-self: end; display: flex; align-items: center; gap: 22px; }
  .site-cta { font-weight: 650; white-space: nowrap; }
  .site-nav a, .site-cta, .lang-switch a, .nav-group>button { transition: opacity .2s ease; }
  .site-nav a:hover, .site-cta:hover, .lang-switch a:hover { opacity: .55; }
  .lang-switch { display: flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: .08em; }
  .lang-switch a { color: var(--muted); }
  .lang-switch a.active { color: var(--ink); font-weight: 800; }
  .lang-switch span { color: var(--line); }
  .menu-toggle { display: none; width: 42px; height: 42px; padding: 0; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; align-items: center; justify-content: center; flex-direction: column; gap: 6px; }
  .menu-toggle span { display: block; width: 18px; height: 1px; background: currentColor; transition: transform .2s ease; }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .mobile-nav { position: absolute; top: 100%; left: 0; right: 0; display: flex; padding: 22px 0 26px; background: var(--bg); border-bottom: 1px solid var(--ink); box-shadow: 0 18px 35px rgba(0,0,0,.08); flex-direction: column; align-items: stretch; gap: 0; }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav > a { padding: 13px 4px; border-bottom: 1px solid var(--line); font-size: 16px; }
  .mobile-group { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; padding: 18px 4px; border-bottom: 1px solid var(--line); }
  .mobile-group > span { grid-column: 1 / -1; font-family: monospace; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .mobile-group a { font-size: 14px; }
  .mobile-nav .mobile-cta { margin-top: 18px; padding: 16px 18px; border: 0; background: var(--ink); color: var(--white); font-weight: 700; text-align: center; }

  @media (max-width: 980px) {
    .site-header { grid-template-columns: 1fr auto; }
    .site-nav { display: none; }
    .site-actions { gap: 14px; }
    .menu-toggle { display: flex; }
  }

  @media (max-width: 560px) {
    .site-header { height: 68px; }
    .site-brand { font-size: 16px; }
    .site-cta { display: none; }
    .lang-switch { font-size: 12px; }
    .mobile-nav { padding-top: 14px; }
    .mobile-group { grid-template-columns: 1fr; }
    .mobile-group > span { grid-column: auto; }
  }
</style>
