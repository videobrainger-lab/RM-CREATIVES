---
interface Props { hasRuAlternate?: boolean; }
const { hasRuAlternate = true } = Astro.props;
const path = Astro.url.pathname;
const isRu = path === '/ru' || path.startsWith('/ru/');
const enHref = isRu ? (path.replace(/^\/ru(?=\/|$)/, '') || '/') : path;
const ruHref = isRu ? path : hasRuAlternate ? (path === '/' ? '/ru/' : `/ru${path}`) : '/ru/';
---
<header class="site-header shell">
  <a class="site-brand" href={isRu ? '/ru/' : '/'} aria-label="RM CREATIVES home">RM CREATIVES</a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href={isRu ? '/ru/#services' : '/#services'}>{isRu ? 'Услуги' : 'Services'}</a>
    <div class="nav-group">
      <button type="button">{isRu ? 'Отрасли' : 'Industries'} <span>⌄</span></button>
      <div class="nav-menu">
        <a href={isRu ? '/ru/industries/dental-marketing/' : '/industries/dental-marketing/'}>{isRu ? 'Стоматология' : 'Dental'}</a>
        <a href={isRu ? '/ru/industries/medical-marketing/' : '/industries/medical-marketing/'}>{isRu ? 'Медицина' : 'Medical'}</a>
        <a href={isRu ? '/ru/industries/aesthetic-clinic-marketing/' : '/industries/aesthetic-clinic-marketing/'}>{isRu ? 'Эстетика' : 'Aesthetic'}</a>
      </div>
    </div>
    <a href={isRu ? '/ru/cases' : '/cases'}>{isRu ? 'Кейсы' : 'Cases'}</a>
    <a href={isRu ? '/ru/insights' : '/insights'}>{isRu ? 'Материалы' : 'Insights'}</a>
    <a href={isRu ? '/ru/#about' : '/#about'}>{isRu ? 'О нас' : 'About'}</a>
  </nav>

  <div class="site-actions">
    <div class="lang-switch" aria-label="Language switcher">
      <a class:list={[!isRu && 'active']} href={enHref}>EN</a>
      <span>/</span>
      <a class:list={[isRu && 'active']} href={ruHref} title={!isRu && !hasRuAlternate ? 'Russian homepage' : undefined}>RU</a>
    </div>
    <a class="site-cta" href={isRu ? '/ru/contact' : '/contact'}>{isRu ? 'Обсудить проект' : 'Discuss a project'} ↗</a>
  </div>
</header>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const target = document.documentElement.lang === 'ru' ? '/ru/contact' : '/contact';
    document.querySelectorAll('a[href^="mailto:hello@rmcreatives.com"]').forEach((link) => link.setAttribute('href', target));
  });
</script>
<style is:global>
  .shell { width: min(1180px, calc(100% - 48px)); margin-left: auto; margin-right: auto; }
  @media (max-width: 720px) { .shell { width: min(1180px, calc(100% - 28px)); } }
</style>
<style>
  .site-header { height: 82px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); font-size: 13px; }
  .site-brand { font-size: 18px; font-weight: 850; letter-spacing: -.045em; white-space: nowrap; }
  .site-nav { display: flex; gap: 30px; }
  .nav-group{position:relative}.nav-group>button{border:0;background:none;padding:0;color:inherit;font:inherit;cursor:pointer}.nav-group>button span{color:var(--muted)}.nav-menu{position:absolute;left:-18px;top:calc(100% + 10px);z-index:20;width:180px;padding:10px;background:var(--bg);border:1px solid var(--line);display:none;box-shadow:0 16px 35px rgba(0,0,0,.08)}.nav-menu::before{content:"";position:absolute;left:-1px;right:-1px;top:-12px;height:12px}.nav-menu a{display:block;padding:10px 8px}.nav-group:hover .nav-menu,.nav-group:focus-within .nav-menu{display:block}
  .site-actions { justify-self: end; display: flex; align-items: center; gap: 22px; }
  .site-cta { font-weight: 650; white-space: nowrap; }
  .site-nav a, .site-cta, .lang-switch a, .nav-group>button { transition: opacity .2s ease; }
  .site-nav a:hover, .site-cta:hover, .lang-switch a:hover { opacity: .55; }
  .lang-switch { display: flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: .08em; }
  .lang-switch a { color: var(--muted); }
  .lang-switch a.active { color: var(--ink); font-weight: 800; }
  .lang-switch span { color: var(--line); }

  @media (max-width: 980px) {
    .site-header { grid-template-columns: 1fr auto; }
    .site-nav { display: none; }
    .site-actions { gap: 14px; }
  }

  @media (max-width: 560px) {
    .site-header { height: 68px; }
    .site-brand { font-size: 16px; }
    .site-cta { display: none; }
    .lang-switch { font-size: 12px; }
  }
</style>
