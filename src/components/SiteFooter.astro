---
const isRu = Astro.url.pathname.startsWith('/ru');
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand-block">
      <a class="footer-brand" href={isRu ? '/ru/' : '/'}>RM CREATIVES</a>
      <p>{isRu ? 'Привлечение пациентов в клиники' : 'Patient acquisition for clinics'}</p>
    </div>

    <div class="footer-col">
      <span class="footer-label">{isRu ? 'Навигация' : 'Navigation'}</span>
      <a href={isRu ? '/ru/#services' : '/#services'}>{isRu ? 'Услуги' : 'Services'}</a>
      <a href={isRu ? '/ru/cases' : '/cases'}>{isRu ? 'Кейсы' : 'Cases'}</a>
      <a href={isRu ? '/ru/insights' : '/insights'}>{isRu ? 'Материалы' : 'Insights'}</a>
    </div>

    <div class="footer-col">
      <span class="footer-label">{isRu ? 'Документы' : 'Legal'}</span>
      <a href={isRu ? '/ru/privacy' : '/privacy'}>{isRu ? 'Политика конфиденциальности' : 'Privacy policy'}</a>
      <a href={isRu ? '/ru/cookies' : '/cookies'}>{isRu ? 'Политика cookie' : 'Cookie policy'}</a>
      <a href={isRu ? '/ru/terms' : '/terms'}>{isRu ? 'Условия использования' : 'Terms of use'}</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </div>

    <div class="footer-col">
      <span class="footer-label">{isRu ? 'Соцсети' : 'Social'}</span>
      <a href="https://www.instagram.com/rm_bureau/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      <a href="https://www.facebook.com/marketing.roast" target="_blank" rel="noopener noreferrer">Facebook ↗</a>
    </div>

    <div class="footer-company">
      <span class="footer-label">{isRu ? 'Компания' : 'Company'}</span>
      <strong>RM CREATIVES, SIA</strong>
      <address>Šarlotes iela 18A - 3<br/>Rīga, LV-1001</address>
      <a href="mailto:clientcare@rmcreatives.com">clientcare@rmcreatives.com</a>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© 2026 RM CREATIVES</span>
    <span>RIGA / EUROPE</span>
  </div>
</footer>

<script is:inline>
  const applySitePolish = () => {
    if (location.pathname === '/') {
      const heroLabel = document.querySelector('.hero-top span:first-child');
      const heroCopy = document.querySelector('.hero-bottom p');
      if (heroLabel) heroLabel.textContent = 'FOR MEDICAL & AESTHETIC CLINICS';
      if (heroCopy) heroCopy.textContent = 'Meta Ads, Google Ads and high-converting websites built exclusively for medical and aesthetic clinics.';
    }

    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim().toLowerCase();
    const probe = document.createElement('span');
    probe.style.color = accent;
    document.body.appendChild(probe);
    const accentRgb = getComputedStyle(probe).color;
    probe.remove();
    document.querySelectorAll('body *').forEach((el) => {
      if (getComputedStyle(el).backgroundColor === accentRgb) el.classList.add('rm-on-accent');
    });

    const panel = document.querySelector('.system-panel');
    const counter = panel?.querySelector('.panel-stat strong');
    const flash = panel?.querySelector('.counter-flash');
    const rows = panel ? Array.from(panel.querySelectorAll('.feed-row')) : [];
    if (counter) {
      const ru = document.documentElement.lang === 'ru';
      const format = (value) => new Intl.NumberFormat(ru ? 'ru-RU' : 'en-US').format(value);
      const BASE_COUNT = 10000;
      const BASE_TIME = new Date('2026-09-11T00:00:00+03:00').getTime();
      const AVG_PER_DAY = 39;
      const target = Math.max(BASE_COUNT, Math.floor(BASE_COUNT + Math.max(0, Date.now() - BASE_TIME) * (AVG_PER_DAY / 86400000)));
      let displayed = Math.max(BASE_COUNT, target - 9);
      counter.textContent = format(displayed);

      const feedData = ru ? [
        ['ЭСТЕТИКА','КОНСУЛЬТАЦИЯ КОСМЕТОЛОГА','НОВОЕ'],
        ['СТОМАТОЛОГИЯ','ИМПЛАНТАЦИЯ','ЦЕЛЕВОЕ'],
        ['МЕДИЦИНА','КОНСУЛЬТАЦИЯ ВРАЧА','НОВОЕ'],
        ['ЭСТЕТИКА','ЛАЗЕРНАЯ ПРОЦЕДУРА','ЦЕЛЕВОЕ'],
        ['СТОМАТОЛОГИЯ','КОНСУЛЬТАЦИЯ ПО ВИНИРАМ','НОВОЕ'],
        ['МЕДИЦИНА','ПРИЁМ СПЕЦИАЛИСТА','ЦЕЛЕВОЕ']
      ] : [
        ['AESTHETIC','AESTHETIC CONSULTATION','NEW'],
        ['DENTAL','IMPLANT CONSULTATION','QUALIFIED'],
        ['MEDICAL','SPECIALIST CONSULTATION','NEW'],
        ['AESTHETIC','LASER TREATMENT','QUALIFIED'],
        ['DENTAL','VENEERS CONSULTATION','NEW'],
        ['MEDICAL','DOCTOR APPOINTMENT','QUALIFIED']
      ];

      let feedIndex = 0;
      const animateFeed = () => {
        if (!rows.length) return;
        const row = rows[feedIndex % rows.length];
        const data = feedData[(feedIndex + 3) % feedData.length];
        const title = row.querySelector('b');
        const service = row.querySelector('span');
        const status = row.querySelector('em');
        row.classList.remove('feed-live-pulse');
        void row.offsetWidth;
        row.classList.add('feed-live-pulse');
        setTimeout(() => {
          if (title) title.textContent = data[0];
          if (service) service.textContent = data[1];
          if (status) status.textContent = data[2];
        }, 180);
        feedIndex += 1;
      };

      const popCounter = () => {
        displayed += 1;
        counter.textContent = format(displayed);
        counter.classList.remove('counter-pop');
        void counter.offsetWidth;
        counter.classList.add('counter-pop');
      };

      const animateToTarget = () => {
        if (displayed >= target) return;
        popCounter();
        setTimeout(animateToTarget, 90);
      };
      setTimeout(animateToTarget, 250);

      const enquiryEvent = () => {
        popCounter();
        if (flash) {
          flash.classList.remove('counter-flash-show');
          void flash.offsetWidth;
          flash.classList.add('counter-flash-show');
        }
        animateFeed();
        const next = 8000 + Math.random() * 9000;
        setTimeout(enquiryEvent, next);
      };

      setTimeout(enquiryEvent, 6500 + Math.random() * 4500);
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applySitePolish);
  else applySitePolish();
</script>

<style is:global>
  .rm-on-accent, .rm-on-accent * { color: #fff !important; }
  .system-panel .panel-stat strong.counter-pop { animation: rmCounterPop .35s ease; }
  .system-panel .counter-flash { opacity: 0; transform: translateY(4px); }
  .system-panel .counter-flash.counter-flash-show { animation: rmCounterFlash 1.5s ease; }
  .system-panel .feed-row { position: relative; overflow: hidden; }
  .system-panel .feed-row.feed-live-pulse { animation: rmFeedText .7s ease; }
  .system-panel .feed-row.feed-live-pulse::after { content:''; position:absolute; inset:0; background:var(--accent); opacity:0; pointer-events:none; animation:rmFeedBlue .75s ease; }
  @keyframes rmCounterPop { 0% { transform: translateY(0); } 45% { transform: translateY(-4px); } 100% { transform: translateY(0); } }
  @keyframes rmCounterFlash { 0% { opacity: 0; transform: translateY(4px); } 18% { opacity: 1; transform: translateY(0); } 72% { opacity: 1; } 100% { opacity: 0; transform: translateY(-3px); } }
  @keyframes rmFeedText { 0% { transform:translateY(0); } 35% { transform:translateY(2px); } 100% { transform:translateY(0); } }
  @keyframes rmFeedBlue { 0% { opacity:0; } 22% { opacity:.20; } 55% { opacity:.10; } 100% { opacity:0; } }
</style>

<style>
  .site-footer { background: var(--dark); color: var(--white); padding: 68px 0 26px; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr) 1.4fr; gap: 36px; padding-bottom: 70px; }
  .footer-brand { font-size: 21px; font-weight: 850; letter-spacing: -.045em; }
  .footer-brand-block p { margin: 14px 0 0; color: #8d8d88; font-size: 13px; max-width: 220px; line-height: 1.4; }
  .footer-col, .footer-company { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; font-size: 13px; }
  .footer-label { font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: #70706d; margin-bottom: 8px; }
  .footer-col a, .footer-company a { color: #d7d7d2; transition: opacity .2s ease; }
  .footer-col a:hover, .footer-company a:hover { opacity: .55; }
  .footer-company strong { font-size: 13px; }
  .footer-company address { font-style: normal; color: #9b9b96; line-height: 1.55; }
  .footer-bottom { border-top: 1px solid #292929; padding-top: 22px; display: flex; justify-content: space-between; color: #6f6f6b; font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace; font-size: 10px; letter-spacing: .1em; }

  @media (max-width: 1050px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .site-footer { padding-top: 48px; }
    .footer-grid { grid-template-columns: 1fr; gap: 34px; padding-bottom: 48px; }
    .footer-bottom { gap: 20px; }
  }
</style>